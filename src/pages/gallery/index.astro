---
import { getSiteSettings } from '../../lib/site-settings';
const settings = await getSiteSettings(Astro.request);
import PublicShell from '../../components/PublicShell.astro';
import Layout from '../../layouts/Layout.astro';
import { getPublicCategories, photoAlt, thumbnailUrl } from '../../lib/public-gallery';

const categories = await getPublicCategories();
---

<Layout
	title={`Galería | ${settings.site_name}`}
	description={settings.site_description || `Categorías de ${settings.site_name}.`}
>
	<PublicShell items={[{ href: '/', label: 'Inicio' }, { href: '/gallery', label: 'Galería', active: true }]}>
		<main class="gallery-page">
			<header class="page-heading">
				<p>Galería</p>
				<h1>Categorías</h1>
			</header>

			{categories.length > 0 ? (
				<section class="category-grid" aria-label="Categorías con fotografías publicadas">
					{categories.map((category) => (
						<a class="category-card" href={`/gallery/${category.slug}`}>
							{category.coverPhoto && (
								<img
									src={thumbnailUrl(category.coverPhoto.image)}
									alt={photoAlt(category.coverPhoto)}
									loading="lazy"
									width="720"
									height="540"
								/>
							)}
							<span class="category-body">
								<span class="category-title">{category.name}</span>
								{category.description && <span class="category-description">{category.description}</span>}
								<span class="category-count">
									{category.photoCount} {category.photoCount === 1 ? 'fotografía' : 'fotografías'}
								</span>
							</span>
						</a>
					))}
				</section>
			) : (
				<p class="empty-state">No hay categorías públicas con fotografías publicadas.</p>
			)}
		</main>
	</PublicShell>
</Layout>

<style>
	.gallery-page {
		padding: clamp(40px, 6vw, 72px) clamp(18px, 5vw, 72px) 80px;
	}

	.page-heading {
		margin-bottom: clamp(32px, 5vw, 56px);
	}

	.page-heading p {
		margin: 0 0 12px;
		color: var(--text-secondary);
		font-size: 0.78rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font-size: clamp(2.3rem, 5vw, 4.8rem);
		font-weight: 560;
		line-height: 1;
	}

	.category-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 28px;
	}

	.category-card {
		display: grid;
		gap: 14px;
		min-width: 0;
	}

	.category-card img {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		background: var(--surface);
	}

	.category-body {
		display: grid;
		gap: 7px;
	}

	.category-title {
		color: var(--text);
		font-size: 1.08rem;
		font-weight: 560;
		line-height: 1.3;
	}

	.category-description,
	.category-count,
	.empty-state {
		color: var(--text-secondary);
		font-size: 0.92rem;
		line-height: 1.55;
	}

	.category-count {
		font-size: 0.78rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
</style>
