---
import { getSiteSettings } from '../../lib/site-settings';
const settings = await getSiteSettings(Astro.request);
import PublicShell from '../../components/PublicShell.astro';
import Layout from '../../layouts/Layout.astro';
import { getPublicCategories, photoAlt, thumbnailUrl } from '../../lib/public-gallery';

const categories = await getPublicCategories();
---

<Layout
	title={`Galería | ${settings.site_name}`}
	description={settings.site_description || `Categorías de ${settings.site_name}.`}
>
	<PublicShell items={[{ href: '/', label: 'Inicio' }, { href: '/gallery', label: 'Galería', active: true }]}>
		<main class="gallery-page">
			<header class="page-heading">
				<div class="heading-meta">
					<span class="heading-stamp">ÍNDICE DE ROLLOS &amp; COLECCIONES</span>
					<p>Galería general</p>
				</div>
				<h1>Categorías</h1>
			</header>

			{categories.length > 0 ? (
				<section class="category-grid stagger-grid" aria-label="Categorías con fotografías publicadas">
					{categories.map((category, index) => (
						<a class="category-card" href={`/gallery/${category.slug}`}>
							<span class="roll-strip" aria-hidden="true">
								<span>▲ ROLLO {String(index + 1).padStart(2, '0')}</span>
								<span>{category.photoCount} {category.photoCount === 1 ? 'FOTO' : 'FOTOS'}</span>
							</span>

							<div class="category-media">
								{category.coverPhoto ? (
									<img
										src={thumbnailUrl(category.coverPhoto.image)}
										alt={photoAlt(category.coverPhoto)}
										loading="lazy"
										width="720"
										height="540"
									/>
								) : (
									<div class="category-placeholder">
										<span>Sin portada</span>
									</div>
								)}
								<span class="open-roll-badge" aria-hidden="true">Abrir hoja de contacto →</span>
							</div>

							<span class="category-body">
								<span class="category-title">{category.name}</span>
								{category.description && <span class="category-description">{category.description}</span>}
								<span class="category-count">
									{category.photoCount} {category.photoCount === 1 ? 'fotografía' : 'fotografías'} en archivo
								</span>
							</span>
						</a>
					))}
				</section>
			) : (
				<p class="empty-state">No hay categorías públicas con fotografías publicadas.</p>
			)}
		</main>
	</PublicShell>
</Layout>

<style>
	.gallery-page {
		padding: clamp(32px, 5vw, 60px) clamp(18px, 4vw, 48px) 80px;
		max-width: 1480px;
		margin: 0 auto;
		box-sizing: border-box;
	}

	.page-heading {
		margin-bottom: clamp(28px, 4vw, 48px);
		padding-bottom: 20px;
		border-bottom: 1px solid var(--border);
	}

	.heading-meta {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 10px;
		margin-bottom: 12px;
	}

	.heading-stamp {
		padding: 3px 8px;
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-xs);
		background: var(--accent-subtle);
		color: var(--accent);
		font-family: var(--font-mono);
		font-size: 0.66rem;
		font-weight: 600;
		letter-spacing: 0.14em;
	}

	.page-heading p {
		margin: 0;
		color: var(--text-secondary);
		font-family: var(--font-mono);
		font-size: 0.74rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font-size: clamp(2.4rem, 5vw, 4.4rem);
		font-family: var(--font-serif);
		font-weight: 500;
		line-height: 1.02;
		letter-spacing: -0.015em;
	}

	.category-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 28px;
	}

	.category-card {
		display: flex;
		flex-direction: column;
		min-width: 0;
		padding: 12px 12px 16px;
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		background: var(--surface-card);
		box-shadow: var(--shadow-sm);
		text-decoration: none;
		transition:
			border-color 220ms ease,
			background-color 220ms ease,
			box-shadow 220ms ease,
			transform 220ms cubic-bezier(0.16, 1, 0.3, 1);
	}

	.category-card:hover {
		border-color: var(--accent);
		background: var(--surface-hover);
		box-shadow: var(--shadow-lighttable);
	}

	@media (prefers-reduced-motion: no-preference) {
		.category-card:hover {
			transform: translateY(-3px);
		}
	}

	.roll-strip {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 8px;
		padding: 0 2px 8px;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.12em;
		color: var(--film-stamp);
	}

	.category-media {
		position: relative;
		overflow: hidden;
		aspect-ratio: 4 / 3;
		background: #080706;
		border: 1px solid var(--border-subtle);
		border-radius: var(--radius-xs);
	}

	.category-media img {
		width: 100%;
		height: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		display: block;
		transition: transform 380ms cubic-bezier(0.16, 1, 0.3, 1);
	}

	@media (prefers-reduced-motion: no-preference) {
		.category-card:hover .category-media img {
			transform: scale(1.03);
		}
	}

	.open-roll-badge {
		position: absolute;
		right: 10px;
		bottom: 10px;
		padding: 5px 10px;
		border: 1px solid rgba(223, 169, 96, 0.45);
		border-radius: var(--radius-xs);
		background: rgba(13, 12, 10, 0.88);
		color: #f3ede2;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		opacity: 0;
		transform: translateY(4px);
		transition: opacity 180ms ease, transform 180ms ease;
	}

	.category-card:hover .open-roll-badge,
	.category-card:focus-visible .open-roll-badge {
		opacity: 1;
		transform: translateY(0);
	}

	.category-placeholder {
		display: grid;
		place-items: center;
		width: 100%;
		height: 100%;
		background: var(--surface);
		color: var(--text-secondary);
		font-family: var(--font-mono);
		font-size: 0.76rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.category-body {
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: 14px 4px 0;
		flex: 1 1 auto;
	}

	.category-title {
		color: var(--text);
		font-family: var(--font-serif);
		font-size: 1.38rem;
		font-weight: 500;
		line-height: 1.2;
	}

	.category-description {
		color: var(--text-secondary);
		font-size: 0.88rem;
		line-height: 1.55;
	}

	.category-count {
		margin-top: auto;
		padding-top: 6px;
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.empty-state {
		padding: 48px 24px;
		border: 1px dashed var(--border);
		border-radius: var(--radius-md);
		background: var(--surface-card);
		text-align: center;
		color: var(--text-secondary);
		font-size: 0.95rem;
	}
</style>
