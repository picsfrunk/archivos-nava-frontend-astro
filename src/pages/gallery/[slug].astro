---
import { getSiteSettings } from '../../lib/site-settings';
const settings = await getSiteSettings(Astro.request);
import PhotoCard from '../../components/PhotoCard.astro';
import PublicShell from '../../components/PublicShell.astro';
import Layout from '../../layouts/Layout.astro';
import {
	displayYear,
	getPublicCategoryBySlug,
	getPublicPhotosByCategory,
	type PhotoRecord,
} from '../../lib/public-gallery';

export const prerender = false;

const category = await getPublicCategoryBySlug(Astro.params.slug || '');

if (!category) {
	return new Response('Not found', { status: 404 });
}

const firstPage = await getPublicPhotosByCategory(category.id, 1, 24);
const photos = firstPage.items;
const hasMore = firstPage.page < firstPage.totalPages;
---

<Layout
	title={`${category.name} | ${settings.site_name}`}
	description={category.description || `Fotografías publicadas de ${category.name} en ${settings.site_name}.`}
>
	<PublicShell items={[{ href: '/', label: 'Inicio' }, { href: '/gallery', label: 'Galería', active: true }]}>
		<main class="category-page" data-category-id={category.id}>
			<header class="page-heading">
				<a href="/gallery">Galería</a>
				<h1>{category.name}</h1>
				{category.description && <p>{category.description}</p>}
			</header>

			{photos.length > 0 ? (
				<>
					<section id="photo-grid" class="photo-grid" aria-label={`Fotografías de ${category.name}`}>
						{photos.map((photo: PhotoRecord) => <PhotoCard photo={photo} />)}
					</section>

					{hasMore && (
						<div class="load-more">
							<button id="load-more-button" type="button" data-next-page="2">Cargar más</button>
							<p id="load-more-status" role="status" aria-live="polite"></p>
						</div>
					)}
				</>
			) : (
				<p class="empty-state">No hay fotografías publicadas en esta categoría.</p>
			)}
		</main>
	</PublicShell>
</Layout>

<script>
	import { pb } from '../../lib/pocketbase';
	import { thumbnailUrl, displayYear } from '../../lib/public-gallery';

	const page = document.querySelector('.category-page');
	const grid = document.querySelector('#photo-grid');
	const button = document.querySelector('#load-more-button');
	const status = document.querySelector('#load-more-status');
	const categoryId = page instanceof HTMLElement ? page.dataset.categoryId || '' : '';
	const perPage = 24;

	function isPublicCategory(category) {
		return Boolean(category?.active && category.slug && category.slug !== 'sin-categoria');
	}

	function isPublicPhoto(photo) {
		return Boolean(photo?.status === 'published' && isPublicCategory(photo.expand?.category));
	}

	function text(value) {
		return String(value || '').trim();
	}

	function photoLabel(photo) {
		return text(photo.title) || text(photo.caption) || 'Fotografía de archivo';
	}

	function photoAlt(photo) {
		return text(photo.title) || text(photo.caption) || 'Fotografía de archivo';
	}

	function renderPhoto(photo) {
		const link = document.createElement('a');
		link.className = 'photo-card';
		link.href = `/photo/${encodeURIComponent(photo.id)}`;
		link.setAttribute('aria-label', photoLabel(photo));

		const media = document.createElement('div');
		media.className = 'photo-card-media';

		const image = document.createElement('img');
		image.src = thumbnailUrl(photo.image);
		image.alt = photoAlt(photo);
		image.loading = 'lazy';
		image.width = 720;
		image.height = 540;
		media.append(image);

		const body = document.createElement('span');
		body.className = 'photo-card-body';

		const title = document.createElement('span');
		title.className = 'photo-title';
		title.textContent = photoLabel(photo);
		body.append(title);

		const year = displayYear(photo.year);
		if (year) {
			const meta = document.createElement('span');
			meta.className = 'photo-meta';
			meta.textContent = year;
			body.append(meta);
		}

		link.append(media, body);
		return link;
	}

	async function loadMore() {
		if (!(button instanceof HTMLButtonElement) || !(grid instanceof HTMLElement) || !categoryId) return;

		const nextPage = Number(button.dataset.nextPage || '2') || 2;
		button.disabled = true;
		if (status instanceof HTMLElement) status.textContent = 'Cargando...';

		try {
			const result = await pb.collection('photos').getList(nextPage, perPage, {
				filter: pb.filter('status = "published" && category = {:category}', { category: categoryId }),
				sort: 'sort_order,created,id',
				expand: 'category',
			});
			const items = result.items.filter(isPublicPhoto);
			for (const photo of items) grid.append(renderPhoto(photo));

			if (nextPage >= result.totalPages) {
				button.remove();
				if (status instanceof HTMLElement) status.textContent = '';
			} else {
				button.dataset.nextPage = String(nextPage + 1);
				button.disabled = false;
				if (status instanceof HTMLElement) status.textContent = '';
			}
		} catch {
			button.disabled = false;
			if (status instanceof HTMLElement) status.textContent = 'No se pudieron cargar más fotografías.';
		}
	}

	button?.addEventListener('click', loadMore);
</script>

<style>
	.category-page {
		padding: clamp(34px, 6vw, 68px) clamp(18px, 5vw, 72px) 80px;
		max-width: 1440px;
		margin: 0 auto;
		box-sizing: border-box;
	}

	.page-heading {
		max-width: 760px;
		margin-bottom: clamp(30px, 5vw, 50px);
	}

	.page-heading a {
		display: inline-flex;
		margin-bottom: 14px;
		color: var(--text-secondary);
		font-family: var(--font-sans);
		font-size: 0.78rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		text-decoration: none;
		transition: color 0.15s ease;
	}

	.page-heading a:hover {
		color: var(--text);
	}

	h1 {
		margin: 0;
		font-size: clamp(2.3rem, 5vw, 4.8rem);
		font-family: var(--font-serif);
		font-weight: 560;
		line-height: 1.05;
		letter-spacing: -0.01em;
	}

	.page-heading p {
		margin: 18px 0 0;
		color: var(--text-secondary);
		font-size: 1.02rem;
		line-height: 1.65;
	}

	.photo-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: 28px;
	}

	.load-more {
		display: grid;
		justify-items: center;
		gap: 12px;
		margin-top: 48px;
	}

	button {
		border: 1px solid var(--border);
		padding: 12px 24px;
		color: var(--text);
		background: var(--surface);
		font-family: var(--font-sans);
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		cursor: pointer;
		transition: border-color 0.15s ease, background 0.15s ease;
	}

	button:hover:not(:disabled) {
		border-color: var(--text);
		background: var(--surface-hover);
	}

	button:disabled {
		cursor: default;
		opacity: 0.55;
	}

	#load-more-status {
		color: var(--text-secondary);
		font-size: 0.84rem;
	}

	.empty-state {
		padding: 48px 24px;
		border: 1px dashed var(--border);
		background: var(--surface);
		text-align: center;
		color: var(--text-secondary);
		font-size: 0.95rem;
	}

	:global(.photo-card) {
		display: flex;
		flex-direction: column;
		min-width: 0;
		padding: 10px;
		border: 1px solid var(--border-subtle);
		background: var(--surface-card);
		text-decoration: none;
		transition:
			border-color 200ms ease,
			box-shadow 200ms ease,
			transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
	}

	:global(.photo-card:hover) {
		border-color: var(--accent);
		transform: translateY(-2px);
		box-shadow: 0 10px 24px rgba(0, 0, 0, 0.16);
	}

	:global(.photo-card-media) {
		position: relative;
		overflow: hidden;
		background: var(--surface);
		aspect-ratio: 4 / 3;
	}

	:global(.photo-card-media img) {
		width: 100%;
		height: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		display: block;
		transition: transform 300ms ease;
	}

	:global(.photo-card:hover .photo-card-media img) {
		transform: scale(1.02);
	}

	:global(.photo-card-body) {
		display: flex;
		flex-direction: column;
		gap: 6px;
		padding-top: 10px;
	}

	:global(.photo-title) {
		color: var(--text);
		font-family: var(--font-serif);
		font-size: 1.05rem;
		font-weight: 560;
		line-height: 1.25;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	:global(.photo-meta) {
		color: var(--text-secondary);
		font-family: var(--font-sans);
		font-size: 0.74rem;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
</style>
