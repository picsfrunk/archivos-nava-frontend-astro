---
import { getSiteSettings } from '../../lib/site-settings';
const settings = await getSiteSettings(Astro.request);
import PhotoCard from '../../components/PhotoCard.astro';
import PublicShell from '../../components/PublicShell.astro';
import Layout from '../../layouts/Layout.astro';
import {
	getPublicCategories,
	getPublicCategoryBySlug,
	getPublicPhotosByCategory,
	type PhotoRecord,
	type PublicCategory,
} from '../../lib/public-gallery';

export const prerender = false;

const category = await getPublicCategoryBySlug(Astro.params.slug || '');

if (!category) {
	return new Response('Not found', { status: 404 });
}

let allCategories: PublicCategory[] = [];
try {
	allCategories = await getPublicCategories();
} catch {
	allCategories = [];
}

const firstPage = await getPublicPhotosByCategory(category.id, 1, 24);
const photos = firstPage.items;
const hasMore = firstPage.page < firstPage.totalPages;
---

<Layout
	title={`${category.name} | ${settings.site_name}`}
	description={category.description || `Fotografías publicadas de ${category.name} en ${settings.site_name}.`}
>
	<PublicShell
		items={[{ href: '/', label: 'Inicio' }, { href: '/gallery', label: 'Galería', active: true }]}
		activeCategorySlug={category.slug}
	>
		<main class="category-page" data-category-id={category.id}>
			<header class="page-heading">
				<div class="heading-top">
					<a class="back-gallery-link" href="/gallery">← Todas las categorías</a>

					{allCategories.length > 1 && (
						<div class="roll-pills" role="navigation" aria-label="Cambiar rápidamente de categoría">
							{allCategories.map((cat) => (
								<a
									href={`/gallery/${cat.slug}`}
									class:list={['roll-pill', { 'is-active': cat.slug === category.slug }]}
									aria-current={cat.slug === category.slug ? 'page' : undefined}
								>
									<span>{cat.name}</span>
									<small>{cat.photoCount}</small>
								</a>
							))}
						</div>
					)}
				</div>

				<div class="heading-main">
					<div>
						<span class="sheet-stamp">HOJA DE CONTACTO // {firstPage.totalItems} {firstPage.totalItems === 1 ? 'FOTOGRAMA' : 'FOTOGRAMAS'}</span>
						<h1>{category.name}</h1>
						{category.description && <p>{category.description}</p>}
					</div>
				</div>
			</header>

			{photos.length > 0 ? (
				<>
					<section id="photo-grid" class="photo-grid stagger-grid" aria-label={`Fotografías de ${category.name}`}>
						{photos.map((photo: PhotoRecord, index: number) => (
							<PhotoCard photo={photo} frameIndex={index + 1} />
						))}
					</section>

					{hasMore && (
						<div class="load-more">
							<button id="load-more-button" type="button" data-next-page="2">Cargar más fotogramas</button>
							<p id="load-more-status" role="status" aria-live="polite"></p>
						</div>
					)}
				</>
			) : (
				<p class="empty-state">No hay fotografías publicadas en esta categoría.</p>
			)}
		</main>
	</PublicShell>
</Layout>

<script>
	import { pb } from '../../lib/pocketbase';
	import { thumbnailUrl, displayYear } from '../../lib/public-gallery';

	const page = document.querySelector('.category-page');
	const grid = document.querySelector('#photo-grid');
	const button = document.querySelector('#load-more-button');
	const status = document.querySelector('#load-more-status');
	const categoryId = page instanceof HTMLElement ? page.dataset.categoryId || '' : '';
	const perPage = 24;

	function isPublicCategory(category) {
		return Boolean(category?.active && category.slug && category.slug !== 'sin-categoria');
	}

	function isPublicPhoto(photo) {
		return Boolean(photo?.status === 'published' && isPublicCategory(photo.expand?.category));
	}

	function text(value) {
		return String(value || '').trim();
	}

	function photoLabel(photo) {
		return text(photo.title) || text(photo.caption) || 'Fotografía de archivo';
	}

	function photoAlt(photo) {
		return text(photo.title) || text(photo.caption) || 'Fotografía de archivo';
	}

	function renderPhoto(photo, frameNum) {
		const link = document.createElement('a');
		link.className = 'photo-card';
		link.href = `/photo/${encodeURIComponent(photo.id)}`;
		link.setAttribute('aria-label', photoLabel(photo));

		const year = displayYear(photo.year);
		const strip = document.createElement('span');
		strip.className = 'contact-strip';
		strip.setAttribute('aria-hidden', 'true');

		const codeSpan = document.createElement('span');
		codeSpan.className = 'frame-code';
		codeSpan.textContent = `▲ FRM ${String(frameNum).padStart(2, '0')}A`;

		const yearSpan = document.createElement('span');
		yearSpan.className = 'frame-year';
		yearSpan.textContent = year || 'ARCHIVO';
		strip.append(codeSpan, yearSpan);

		const media = document.createElement('div');
		media.className = 'photo-card-media';

		const image = document.createElement('img');
		image.src = thumbnailUrl(photo.image);
		image.alt = photoAlt(photo);
		image.loading = 'lazy';
		image.width = 720;
		image.height = 540;
		image.style.setProperty('view-transition-name', `photo-${photo.id}`);

		const inspect = document.createElement('span');
		inspect.className = 'inspect-pill';
		inspect.setAttribute('aria-hidden', 'true');
		inspect.textContent = 'Ver ficha ↗';

		media.append(image, inspect);

		const body = document.createElement('span');
		body.className = 'photo-card-body';

		const title = document.createElement('span');
		title.className = 'photo-title';
		title.textContent = photoLabel(photo);
		body.append(title);

		if (photo.caption && photo.title) {
			const cap = document.createElement('span');
			cap.className = 'photo-caption-preview';
			cap.textContent = String(photo.caption);
			body.append(cap);
		}

		if (year) {
			const meta = document.createElement('span');
			meta.className = 'photo-meta';
			meta.textContent = year;
			body.append(meta);
		}

		link.append(strip, media, body);
		return link;
	}

	async function loadMore() {
		if (!(button instanceof HTMLButtonElement) || !(grid instanceof HTMLElement) || !categoryId) return;

		const nextPage = Number(button.dataset.nextPage || '2') || 2;
		button.disabled = true;
		if (status instanceof HTMLElement) status.textContent = 'Revelando más fotogramas...';

		try {
			const result = await pb.collection('photos').getList(nextPage, perPage, {
				filter: pb.filter('status = "published" && category = {:category}', { category: categoryId }),
				sort: 'sort_order,created,id',
				expand: 'category',
			});
			const items = result.items.filter(isPublicPhoto);
			const baseCount = grid.children.length;
			items.forEach((photo, idx) => {
				grid.append(renderPhoto(photo, baseCount + idx + 1));
			});

			if (nextPage >= result.totalPages) {
				button.remove();
				if (status instanceof HTMLElement) status.textContent = '';
			} else {
				button.dataset.nextPage = String(nextPage + 1);
				button.disabled = false;
				if (status instanceof HTMLElement) status.textContent = '';
			}
		} catch {
			button.disabled = false;
			if (status instanceof HTMLElement) status.textContent = 'No se pudieron cargar más fotografías.';
		}
	}

	button?.addEventListener('click', loadMore);
</script>

<style>
	.category-page {
		padding: clamp(28px, 4.5vw, 56px) clamp(18px, 4vw, 48px) 80px;
		max-width: 1480px;
		margin: 0 auto;
		box-sizing: border-box;
	}

	.page-heading {
		margin-bottom: clamp(28px, 4vw, 44px);
		padding-bottom: 22px;
		border-bottom: 1px solid var(--border);
	}

	.heading-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 14px;
		margin-bottom: 22px;
	}

	.back-gallery-link {
		display: inline-flex;
		align-items: center;
		color: var(--text-secondary);
		font-family: var(--font-mono);
		font-size: 0.74rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		text-decoration: none;
		transition: color 0.15s ease;
	}

	.back-gallery-link:hover {
		color: var(--accent);
	}

	.roll-pills {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}

	.roll-pill {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 5px 10px;
		border: 1px solid var(--border);
		border-radius: var(--radius-xs);
		background: var(--surface-card);
		color: var(--text-secondary);
		font-size: 0.78rem;
		transition: border-color 150ms ease, color 150ms ease, background-color 150ms ease;
	}

	.roll-pill:hover {
		border-color: var(--accent);
		color: var(--text);
	}

	.roll-pill.is-active {
		border-color: var(--accent);
		background: var(--accent-subtle);
		color: var(--text);
		font-weight: 600;
	}

	.roll-pill small {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		color: var(--film-stamp);
	}

	.sheet-stamp {
		display: inline-block;
		margin-bottom: 10px;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.14em;
		color: var(--film-stamp);
	}

	h1 {
		margin: 0;
		font-size: clamp(2.3rem, 5vw, 4.4rem);
		font-family: var(--font-serif);
		font-weight: 500;
		line-height: 1.04;
		letter-spacing: -0.015em;
	}

	.page-heading p {
		max-width: 720px;
		margin: 14px 0 0;
		color: var(--text-secondary);
		font-size: 1.02rem;
		line-height: 1.65;
	}

	.photo-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(260px, 100%), 1fr));
		gap: 24px;
	}

	.load-more {
		display: grid;
		justify-items: center;
		gap: 12px;
		margin-top: 48px;
	}

	button {
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-sm);
		padding: 12px 24px;
		color: var(--text);
		background: var(--surface-card);
		font-family: var(--font-mono);
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		cursor: pointer;
		transition: border-color 0.15s ease, background-color 0.15s ease;
	}

	button:hover:not(:disabled) {
		border-color: var(--accent);
		background: var(--surface-hover);
	}

	button:disabled {
		cursor: default;
		opacity: 0.55;
	}

	#load-more-status {
		color: var(--text-secondary);
		font-family: var(--font-mono);
		font-size: 0.8rem;
	}

	.empty-state {
		padding: 48px 24px;
		border: 1px dashed var(--border);
		border-radius: var(--radius-md);
		background: var(--surface-card);
		text-align: center;
		color: var(--text-secondary);
		font-size: 0.95rem;
	}
</style>
