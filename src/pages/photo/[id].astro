---
import PublicShell from '../../components/PublicShell.astro';
import Layout from '../../layouts/Layout.astro';
import {
	displayYear,
	downloadUrl,
	getPublicPhotoNavigation,
	getPublicPhotoById,
	lightboxUrl,
	photoAlt,
	photoLabel,
	previewUrl,
} from '../../lib/public-gallery';

export const prerender = false;

const photo = await getPublicPhotoById(Astro.params.id || '');

if (!photo) {
	return new Response('Not found', { status: 404 });
}

const category = photo.expand?.category;
const meta = [displayYear(photo.year), category?.name || ''].filter(Boolean);
const title = photoLabel(photo);
const navigation = await getPublicPhotoNavigation(photo);
const previousLabel = navigation.previous ? photoLabel(navigation.previous) : '';
const nextLabel = navigation.next ? photoLabel(navigation.next) : '';
---

<Layout
	title={`${title} | ARCHIVOS NAVA`}
	description={photo.caption || photo.description || `Fotografía publicada en ARCHIVOS NAVA.`}
>
	<PublicShell items={[{ href: '/', label: 'Inicio' }, { href: '/gallery', label: 'Galería' }]}>
		<main
			class="photo-page"
			data-previous-url={navigation.previous ? `/photo/${navigation.previous.id}` : undefined}
			data-next-url={navigation.next ? `/photo/${navigation.next.id}` : undefined}
		>
			<nav class="breadcrumbs" aria-label="Navegación secundaria">
				<a href="/gallery">Galería</a>
				{category && <a href={`/gallery/${category.slug}`}>{category.name}</a>}
			</nav>

			<article class="photo-detail">
				<figure>
					<button class="image-button" type="button" data-open-lightbox aria-label="Ver fotografía grande">
						<img src={previewUrl(photo.image)} alt={photoAlt(photo)} />
					</button>
				</figure>

				<section class="photo-info" aria-labelledby="photo-title">
					<h1 id="photo-title">{title}</h1>
					{meta.length > 0 && <p class="meta">{meta.join(' / ')}</p>}
					{photo.caption && <p class="caption">{photo.caption}</p>}
					{photo.description && <p class="description">{photo.description}</p>}

					<div class="actions">
						{category && <a href={`/gallery/${category.slug}`}>Volver a {category.name}</a>}
						<button type="button" data-open-lightbox>Ver grande</button>
						<a href={downloadUrl(photo.image)} download>Descargar</a>
					</div>

					{(navigation.previous || navigation.next) && (
						<nav class="photo-navigation" aria-label="Fotografías de la misma categoría">
							{navigation.previous && (
								<a class="previous" href={`/photo/${navigation.previous.id}`} aria-label={`Anterior: ${previousLabel}`}>
									<span>Anterior</span>
									<strong>{previousLabel}</strong>
								</a>
							)}
							{navigation.next && (
								<a class="next" href={`/photo/${navigation.next.id}`} aria-label={`Siguiente: ${nextLabel}`}>
									<span>Siguiente</span>
									<strong>{nextLabel}</strong>
								</a>
							)}
						</nav>
					)}
				</section>
			</article>

			<dialog class="lightbox" aria-label={`Vista ampliada de ${title}`} aria-modal="true">
				<button class="lightbox-close" type="button" data-close-lightbox aria-label="Cerrar vista ampliada">
					Cerrar
				</button>
				<img data-src={lightboxUrl(photo.image)} alt={photoAlt(photo)} />
			</dialog>
		</main>
	</PublicShell>
</Layout>

<script>
	const page = document.querySelector('.photo-page');
	const lightbox = document.querySelector('.lightbox');
	const openButtons = document.querySelectorAll('[data-open-lightbox]');
	const closeButton = document.querySelector('[data-close-lightbox]');

	function openLightbox() {
		if (!(lightbox instanceof HTMLDialogElement)) return;
		const image = lightbox.querySelector('img[data-src]');

		if (image instanceof HTMLImageElement && !image.dataset.loaded && image.dataset.src) {
			image.src = image.dataset.src;
			image.dataset.loaded = 'true';
		}

		if (!lightbox.open) lightbox.showModal();
	}

	function closeLightbox() {
		if (!(lightbox instanceof HTMLDialogElement) || !lightbox.open) return;
		lightbox.close();
	}

	openButtons.forEach((button) => button.addEventListener('click', openLightbox));
	closeButton?.addEventListener('click', closeLightbox);

	lightbox?.addEventListener('click', (event) => {
		if (event.target === lightbox) closeLightbox();
	});

	document.addEventListener('keydown', (event) => {
		if (event.defaultPrevented) return;
		if (lightbox instanceof HTMLDialogElement && lightbox.open) return;

		if (!(page instanceof HTMLElement)) return;
		const previousUrl = page.dataset.previousUrl;
		const nextUrl = page.dataset.nextUrl;

		if (event.key === 'ArrowLeft' && previousUrl) {
			window.location.href = previousUrl;
		}

		if (event.key === 'ArrowRight' && nextUrl) {
			window.location.href = nextUrl;
		}
	});
</script>

<style>
	.photo-page {
		padding: clamp(24px, 4vw, 52px) clamp(18px, 5vw, 72px) 72px;
	}

	.breadcrumbs {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
		margin-bottom: 28px;
		color: rgba(245, 245, 245, 0.58);
		font-size: 0.86rem;
	}

	.breadcrumbs a + a::before {
		content: '/';
		margin-right: 16px;
		color: rgba(245, 245, 245, 0.32);
	}

	.photo-detail {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(280px, 360px);
		align-items: start;
		gap: clamp(28px, 5vw, 64px);
	}

	figure {
		display: grid;
		place-items: center;
		min-height: 320px;
		margin: 0;
		background: #141414;
	}

	.image-button {
		display: grid;
		width: 100%;
		padding: 0;
		color: inherit;
		background: transparent;
		cursor: zoom-in;
	}

	.image-button:focus-visible,
	.actions a:focus-visible,
	.actions button:focus-visible,
	.photo-navigation a:focus-visible,
	.lightbox-close:focus-visible {
		outline: 2px solid #f5f5f5;
		outline-offset: 4px;
	}

	figure img {
		width: 100%;
		max-height: calc(100vh - 180px);
		object-fit: contain;
	}

	.photo-info {
		display: grid;
		gap: 16px;
		padding-top: 4px;
	}

	h1 {
		margin: 0;
		font-size: clamp(1.8rem, 3vw, 3rem);
		font-weight: 560;
		line-height: 1.08;
	}

	.meta,
	.caption,
	.description {
		margin: 0;
		color: rgba(245, 245, 245, 0.68);
		line-height: 1.65;
	}

	.meta {
		color: rgba(245, 245, 245, 0.52);
		font-size: 0.78rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.caption {
		font-size: 1.02rem;
	}

	.description {
		white-space: pre-line;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		margin-top: 10px;
	}

	.actions a,
	.actions button {
		border-bottom: 1px solid rgba(245, 245, 245, 0.55);
		padding-bottom: 5px;
		color: #f5f5f5;
		background: transparent;
		font-size: 0.86rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		cursor: pointer;
	}

	.photo-navigation {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 12px;
		margin-top: 20px;
	}

	.photo-navigation a {
		display: grid;
		gap: 5px;
		min-height: 82px;
		border: 1px solid rgba(245, 245, 245, 0.18);
		padding: 14px;
		align-content: center;
		background: rgba(245, 245, 245, 0.035);
	}

	.photo-navigation .next {
		grid-column: 2;
		text-align: right;
	}

	.photo-navigation span {
		color: rgba(245, 245, 245, 0.54);
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.photo-navigation strong {
		overflow: hidden;
		color: #f5f5f5;
		font-size: 0.92rem;
		font-weight: 520;
		line-height: 1.35;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.lightbox {
		width: min(96vw, 1800px);
		max-width: none;
		max-height: 96vh;
		border: 0;
		padding: 46px 18px 18px;
		background: #050505;
		color: #f5f5f5;
	}

	.lightbox::backdrop {
		background: rgba(0, 0, 0, 0.84);
	}

	.lightbox img {
		width: 100%;
		max-height: calc(96vh - 64px);
		object-fit: contain;
	}

	.lightbox-close {
		position: absolute;
		top: 12px;
		right: 14px;
		border: 1px solid rgba(245, 245, 245, 0.32);
		padding: 8px 12px;
		color: #f5f5f5;
		background: rgba(5, 5, 5, 0.8);
		cursor: pointer;
	}

	@media (max-width: 900px) {
		.photo-detail {
			grid-template-columns: 1fr;
		}

		figure img {
			max-height: 68vh;
		}

		.photo-navigation {
			grid-template-columns: 1fr;
		}

		.photo-navigation .next {
			grid-column: auto;
			text-align: left;
		}
	}
</style>
