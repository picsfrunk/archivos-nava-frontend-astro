---
import { getSiteSettings } from '../../lib/site-settings';
const settings = await getSiteSettings(Astro.request);
import PublicShell from '../../components/PublicShell.astro';
import Layout from '../../layouts/Layout.astro';
import {
	displayYear,
	getPublicCategories,
	getPublicPhotoNavigation,
	getPublicPhotoById,
	lightboxUrl,
	photoAlt,
	photoLabel,
	previewUrl,
	thumbnailUrl,
	type PublicCategory,
} from '../../lib/public-gallery';

export const prerender = false;

const photo = await getPublicPhotoById(Astro.params.id || '');

if (!photo) {
	return new Response('Not found', { status: 404 });
}

let allCategories: PublicCategory[] = [];
try {
	allCategories = await getPublicCategories();
} catch {
	allCategories = [];
}

const category = photo.expand?.category;
const yearText = displayYear(photo.year);
const meta = [yearText, category?.name || ''].filter(Boolean);
const title = photoLabel(photo);
const navigation = await getPublicPhotoNavigation(photo);
const previousLabel = navigation.previous ? photoLabel(navigation.previous) : '';
const nextLabel = navigation.next ? photoLabel(navigation.next) : '';
const framePosition = navigation.position > 0
	? `${String(navigation.position).padStart(2, '0')} / ${String(navigation.total).padStart(2, '0')}`
	: '01 / 01';
---

<Layout
	title={`${title} | ${settings.site_name}`}
	description={photo.caption || photo.description || `Fotografía publicada en ${settings.site_name}.`}
>
	<PublicShell
		items={[{ href: '/', label: 'Inicio' }, { href: '/gallery', label: 'Galería' }]}
		activeCategorySlug={category?.slug}
		photoViewMode={true}
	>
		<main
			class="photo-page"
			data-previous-url={navigation.previous ? `/photo/${navigation.previous.id}` : undefined}
			data-next-url={navigation.next ? `/photo/${navigation.next.id}` : undefined}
		>
			<div class="viewer-topbar">
				<nav class="breadcrumbs" aria-label="Navegación secundaria">
					<a href="/gallery" class="crumb-link">Galería</a>

					{category && (
						<div class="crumb-switcher-wrap">
							<details class="category-dropdown breadcrumb-switcher">
								<summary class="switcher-trigger" aria-label={`Categoría actual: ${category.name}. Cambiar de categoría`}>
									<span class="switcher-kicker">ROLLO:</span>
									<strong class="switcher-current">{category.name}</strong>
									<svg class="switcher-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
										<path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
									</svg>
								</summary>

								<div class="switcher-menu" role="region" aria-label="Cambiar de categoría sin salir del visor">
									<div class="switcher-menu-head">
										<span>Saltar a otra categoría</span>
										<small>1.ª foto o grilla</small>
									</div>
									<ul class="switcher-list">
										{allCategories.map((cat, idx) => {
											const isCurrent = cat.id === category.id || cat.slug === category.slug;
											const jumpPhotoHref = cat.firstPhotoId ? `/photo/${cat.firstPhotoId}` : `/gallery/${cat.slug}`;
											return (
												<li class:list={['switcher-item', { 'is-active': isCurrent }]}>
													<a href={jumpPhotoHref} class="switcher-photo-jump">
														<span class="switcher-num">{String(idx + 1).padStart(2, '0')}A</span>
														<span class="switcher-text">
															<span class="switcher-name">{cat.name}</span>
															<span class="switcher-sub">
																{isCurrent ? 'Rollo en pantalla' : '▶ Abrir 1.ª fotografía'}
															</span>
														</span>
													</a>
													<a
														href={`/gallery/${cat.slug}`}
														class="switcher-grid-link"
														title={`Ver las ${cat.photoCount} fotos de ${cat.name}`}
													>
														Grilla ({cat.photoCount})
													</a>
												</li>
											);
										})}
									</ul>
								</div>
							</details>
						</div>
					)}
				</nav>

				{category && (
					<a class="back-strip-link" href={`/gallery/${category.slug}`}>
						<span>← Ver hoja de contacto de {category.name}</span>
					</a>
				)}
			</div>

			<article class="photo-detail">
				<figure class="photo-mount">
					<div class="mount-film-header" aria-hidden="true">
						<span>▲ ARCHIVO NAVA // {category?.slug?.toUpperCase() || 'COLECCIÓN'}</span>
						<span>FRM {framePosition}</span>
					</div>

					<button class="image-button" type="button" data-open-lightbox aria-label="Ver fotografía grande en mesa de luz">
						<img
							src={previewUrl(photo.image)}
							alt={photoAlt(photo)}
							fetchpriority="high"
							style={`view-transition-name: photo-${photo.id};`}
						/>
						<span class="zoom-badge" aria-hidden="true">⤢ Ampliar en mesa de luz</span>
					</button>

					<figcaption class="mount-film-footer">
						<span>{title}</span>
						<span>{yearText ? `AÑO ${yearText}` : 'S/F'} · #{photo.id.slice(0, 7).toUpperCase()}</span>
					</figcaption>
				</figure>

				<section class="photo-info" aria-labelledby="photo-title">
					<div class="index-card">
						<div class="card-stamp-row">
							<span class="info-eyebrow">FICHA DE CATALOGACIÓN</span>
							<span class="stamp-badge">ORIGINAL PRESERVADO</span>
						</div>

						<div class="info-header">
							<h1 id="photo-title">{title}</h1>
							{meta.length > 0 && <p class="meta">{meta.join(' / ')}</p>}
						</div>

						<dl class="catalog-metadata">
							{photo.year && (
								<div class="metadata-row">
									<dt>Año de toma</dt>
									<dd class="year-val">{yearText}</dd>
								</div>
							)}
							{category && (
								<div class="metadata-row">
									<dt>Colección / Rollo</dt>
									<dd><a class="category-link" href={`/gallery/${category.slug}`}>{category.name}</a></dd>
								</div>
							)}
							{navigation.total > 0 && (
								<div class="metadata-row">
									<dt>Fotograma</dt>
									<dd class="mono-val">{framePosition}</dd>
								</div>
							)}
							<div class="metadata-row">
								<dt>Referencia</dt>
								<dd class="ref-id">#{photo.id}</dd>
							</div>
						</dl>

						{photo.caption && <p class="caption">“{photo.caption}”</p>}
						{photo.description && <p class="description">{photo.description}</p>}

						<div class="actions">
							<button class="action-btn view-btn" type="button" data-open-lightbox>
								⤢ Ver grande
							</button>
							{category && (
								<a class="action-btn back-btn" href={`/gallery/${category.slug}`}>
									Volver a {category.name}
								</a>
							)}
						</div>
					</div>

					{(navigation.previous || navigation.next) && (
						<nav class="photo-navigation" aria-label="Fotografías de la misma categoría">
							{navigation.previous ? (
								<a class="nav-card previous" href={`/photo/${navigation.previous.id}`} aria-label={`Anterior: ${previousLabel}`}>
									<img
										class="nav-thumb"
										src={thumbnailUrl(navigation.previous.image)}
										alt=""
										width="120"
										height="90"
										loading="lazy"
									/>
									<span class="nav-card-text">
										<span class="nav-dir"><kbd>←</kbd> Anterior</span>
										<strong>{previousLabel}</strong>
									</span>
								</a>
							) : (
								<div class="nav-card-placeholder" aria-hidden="true">
									<span>Inicio del rollo</span>
								</div>
							)}

							{navigation.next ? (
								<a class="nav-card next" href={`/photo/${navigation.next.id}`} aria-label={`Siguiente: ${nextLabel}`}>
									<span class="nav-card-text">
										<span class="nav-dir">Siguiente <kbd>→</kbd></span>
										<strong>{nextLabel}</strong>
									</span>
									<img
										class="nav-thumb"
										src={thumbnailUrl(navigation.next.image)}
										alt=""
										width="120"
										height="90"
										loading="lazy"
									/>
								</a>
							) : (
								<div class="nav-card-placeholder is-end" aria-hidden="true">
									<span>Fin del rollo</span>
								</div>
							)}
						</nav>
					)}
				</section>
			</article>

			<dialog class="lightbox" closedby="any" aria-labelledby="lightbox-title">
				<div class="lightbox-toolbar">
					<div class="lightbox-meta">
						<span class="lightbox-stamp">MESA DE LUZ // {framePosition}</span>
						<strong id="lightbox-title">{title}</strong>
					</div>
					<div class="lightbox-actions">
						<button class="lightbox-close" type="button" data-close-lightbox aria-label="Cerrar vista ampliada">
							✕ Cerrar
						</button>
					</div>
				</div>
				<div class="lightbox-stage">
					<img data-src={lightboxUrl(photo.image)} alt={photoAlt(photo)} />
				</div>
			</dialog>
		</main>
	</PublicShell>
</Layout>

<script>
	const page = document.querySelector('.photo-page');
	const lightbox = document.querySelector('.lightbox');
	const openButtons = document.querySelectorAll('[data-open-lightbox]');
	const closeButton = document.querySelector('[data-close-lightbox]');

	let supportsDisplayTransition: boolean | undefined;
	function canTransitionDisplay() {
		if (supportsDisplayTransition !== undefined) return supportsDisplayTransition;
		if (!window.CSS?.supports?.('transition-behavior', 'allow-discrete') || !document.body) {
			return false;
		}
		const probe = document.createElement('div');
		probe.style.cssText = 'transition: display 1s allow-discrete !important; display: block;';
		document.body.appendChild(probe);
		getComputedStyle(probe).display;
		probe.style.display = 'none';
		supportsDisplayTransition = getComputedStyle(probe).display === 'block';
		probe.remove();
		return supportsDisplayTransition;
	}

	function supportsTopLayerExit() {
		return Boolean(window.CSS?.supports?.('overlay', 'auto') && canTransitionDisplay());
	}

	async function closeDialogSmoothly(dialog: HTMLDialogElement) {
		if (!dialog.open) return;
		if (!supportsTopLayerExit()) {
			dialog.setAttribute('data-closing', '');
			const animations = dialog.getAnimations({ subtree: true });
			if (animations.length > 0) {
				await Promise.race([
					Promise.allSettled(animations.map((a) => a.finished)),
					new Promise((r) => setTimeout(r, 400)),
				]);
			}
			if (!dialog.hasAttribute('data-closing')) return;
			dialog.removeAttribute('data-closing');
		}
		dialog.close();
	}

	function openLightbox() {
		if (!(lightbox instanceof HTMLDialogElement)) return;
		const image = lightbox.querySelector('img[data-src]');

		if (image instanceof HTMLImageElement && !image.dataset.loaded && image.dataset.src) {
			image.src = image.dataset.src;
			image.dataset.loaded = 'true';
		}

		if (!lightbox.open) lightbox.showModal();
	}

	function closeLightbox() {
		if (!(lightbox instanceof HTMLDialogElement) || !lightbox.open) return;
		void closeDialogSmoothly(lightbox);
	}

	openButtons.forEach((button) => button.addEventListener('click', openLightbox));
	closeButton?.addEventListener('click', closeLightbox);

	if (lightbox instanceof HTMLDialogElement) {
		lightbox.addEventListener('cancel', (event) => {
			event.preventDefault();
			void closeDialogSmoothly(lightbox);
		});

		// Fallback for browsers without native dialog closedby="any" support
		if (!('closedBy' in HTMLDialogElement.prototype)) {
			lightbox.addEventListener('click', (event) => {
				if (event.target !== lightbox) return;
				const rect = lightbox.getBoundingClientRect();
				const isDialogContent =
					rect.top <= event.clientY &&
					event.clientY <= rect.top + rect.height &&
					rect.left <= event.clientX &&
					event.clientX <= rect.left + rect.width;
				if (!isDialogContent) closeLightbox();
			});
		}

		// Also allow clicking the empty stage area around the high-res image to dismiss
		const stage = lightbox.querySelector('.lightbox-stage');
		stage?.addEventListener('click', (event) => {
			if (event.target === stage) closeLightbox();
		});
	}

	document.addEventListener('keydown', (event) => {
		if (event.defaultPrevented) return;
		if (event.target instanceof HTMLElement && event.target.closest('input, select, textarea, details[open], [contenteditable]')) return;
		if (lightbox instanceof HTMLDialogElement && lightbox.open) return;

		if (!(page instanceof HTMLElement)) return;
		const previousUrl = page.dataset.previousUrl;
		const nextUrl = page.dataset.nextUrl;

		if (event.key === 'ArrowLeft' && previousUrl) {
			window.location.href = previousUrl;
		}

		if (event.key === 'ArrowRight' && nextUrl) {
			window.location.href = nextUrl;
		}
	});
</script>

<style>
	.photo-page {
		max-width: 1480px;
		margin: 0 auto;
		padding: clamp(20px, 3.5vw, 44px) clamp(18px, 4vw, 48px) 72px;
	}

	.viewer-topbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 14px;
		margin-bottom: 24px;
		padding-bottom: 14px;
		border-bottom: 1px solid var(--border-subtle);
	}

	.breadcrumbs {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 12px;
		color: var(--text-secondary);
		font-size: 0.86rem;
	}

	.crumb-link {
		font-family: var(--font-mono);
		font-size: 0.76rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--text-secondary);
		transition: color 150ms ease;
	}

	.crumb-link:hover {
		color: var(--text);
	}

	.crumb-switcher-wrap {
		display: inline-flex;
		align-items: center;
		gap: 12px;
	}

	.crumb-switcher-wrap::before {
		content: '/';
		color: var(--border);
		font-family: var(--font-mono);
	}

	/* Breadcrumb Category Switcher */
	.breadcrumb-switcher {
		position: relative;
	}

	.switcher-trigger {
		list-style: none;
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 6px 12px;
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-sm);
		background: var(--surface-card);
		color: var(--text);
		font-size: 0.84rem;
		cursor: pointer;
		user-select: none;
		transition: border-color 150ms ease, background-color 150ms ease, box-shadow 150ms ease;
	}

	.switcher-trigger::-webkit-details-marker {
		display: none;
	}

	.switcher-trigger:hover,
	.breadcrumb-switcher[open] .switcher-trigger {
		border-color: var(--accent);
		background: var(--surface-hover);
		box-shadow: 0 0 0 2px var(--accent-subtle);
	}

	.switcher-kicker {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.08em;
		color: var(--film-stamp);
	}

	.switcher-current {
		font-weight: 600;
	}

	.switcher-chevron {
		color: var(--accent);
		transition: transform 180ms ease;
	}

	.breadcrumb-switcher[open] .switcher-chevron {
		transform: rotate(180deg);
	}

	.switcher-menu {
		position: absolute;
		top: calc(100% + 8px);
		left: 0;
		width: min(360px, calc(100vw - 36px));
		max-height: 380px;
		overflow-y: auto;
		padding: 12px;
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-md);
		background: var(--surface-card);
		box-shadow: var(--shadow-md);
		z-index: 50;
	}

	.switcher-menu-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 2px 6px 8px;
		margin-bottom: 6px;
		border-bottom: 1px dashed var(--border);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--text-muted);
	}

	.switcher-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 4px;
	}

	.switcher-item {
		display: flex;
		align-items: center;
		gap: 6px;
		border-radius: var(--radius-sm);
		transition: background-color 140ms ease;
	}

	.switcher-item:hover {
		background: var(--surface-hover);
	}

	.switcher-item.is-active {
		background: var(--accent-subtle);
		outline: 1px solid var(--border-strong);
	}

	.switcher-photo-jump {
		flex: 1 1 auto;
		min-width: 0;
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 8px 10px;
	}

	.switcher-num {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: var(--film-stamp);
	}

	.switcher-text {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}

	.switcher-name {
		font-weight: 500;
		color: var(--text);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.switcher-sub {
		font-size: 0.7rem;
		color: var(--accent);
	}

	.switcher-grid-link {
		flex-shrink: 0;
		margin-right: 8px;
		padding: 4px 8px;
		border: 1px solid var(--border);
		border-radius: var(--radius-xs);
		background: var(--surface);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		color: var(--text-secondary);
		transition: border-color 140ms ease, color 140ms ease;
	}

	.switcher-grid-link:hover {
		border-color: var(--accent);
		color: var(--text);
	}

	.back-strip-link {
		font-family: var(--font-mono);
		font-size: 0.74rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--text-secondary);
		padding: 6px 10px;
		border: 1px solid var(--border-subtle);
		border-radius: var(--radius-xs);
		background: var(--surface);
		transition: border-color 150ms ease, color 150ms ease;
	}

	.back-strip-link:hover {
		border-color: var(--accent);
		color: var(--text);
	}

	/* Main Photo + Index Card Layout */
	.photo-detail {
		display: grid;
		grid-template-columns: minmax(0, 1.4fr) minmax(320px, 0.95fr);
		align-items: start;
		gap: clamp(28px, 4vw, 52px);
	}

	.photo-mount {
		position: relative;
		display: flex;
		flex-direction: column;
		margin: 0;
		padding: clamp(12px, 2vw, 20px);
		background: var(--surface-card);
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		box-shadow: var(--shadow-md);
	}

	.mount-film-header,
	.mount-film-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--film-stamp);
	}

	.mount-film-header {
		padding: 0 4px 10px;
	}

	.mount-film-footer {
		padding: 10px 4px 0;
		color: var(--text-muted);
	}

	.mount-film-footer span:first-child {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.image-button {
		position: relative;
		display: grid;
		place-items: center;
		width: 100%;
		min-height: 360px;
		padding: clamp(8px, 1.5vw, 18px);
		border: 1px solid var(--border-subtle);
		border-radius: var(--radius-xs);
		color: inherit;
		background: #070605;
		cursor: zoom-in;
		overflow: hidden;
	}

	.photo-mount img {
		width: 100%;
		max-height: calc(100vh - 230px);
		object-fit: contain;
		display: block;
		transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
	}

	@media (prefers-reduced-motion: no-preference) {
		.image-button:hover img {
			transform: scale(1.01);
		}
	}

	.zoom-badge {
		position: absolute;
		right: 14px;
		bottom: 14px;
		padding: 6px 12px;
		background: rgba(13, 12, 10, 0.88);
		color: #f3ede2;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-xs);
		opacity: 0.88;
		transition: opacity 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
		pointer-events: none;
	}

	.image-button:hover .zoom-badge,
	.image-button:focus-visible .zoom-badge {
		opacity: 1;
		border-color: var(--accent);
		transform: translateY(-2px);
	}

	/* Archival Index Card */
	.photo-info {
		display: grid;
		gap: 20px;
	}

	.index-card {
		display: grid;
		gap: 18px;
		padding: clamp(20px, 3vw, 28px);
		background: var(--surface-card);
		border: 1px solid var(--border);
		border-top: 3px solid var(--accent);
		border-radius: var(--radius-md);
		box-shadow: var(--shadow-sm);
	}

	.card-stamp-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 10px;
		flex-wrap: wrap;
	}

	.info-eyebrow {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: var(--text-muted);
	}

	.stamp-badge {
		padding: 2px 8px;
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-xs);
