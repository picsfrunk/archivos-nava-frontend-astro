---
import { getSiteSettings } from '../../lib/site-settings';
const settings = await getSiteSettings(Astro.request);
import PublicShell from '../../components/PublicShell.astro';
import Layout from '../../layouts/Layout.astro';
import {
	displayYear,
	downloadUrl,
	getPublicPhotoNavigation,
	getPublicPhotoById,
	lightboxUrl,
	photoAlt,
	photoLabel,
	previewUrl,
} from '../../lib/public-gallery';

export const prerender = false;

const photo = await getPublicPhotoById(Astro.params.id || '');

if (!photo) {
	return new Response('Not found', { status: 404 });
}

const category = photo.expand?.category;
const meta = [displayYear(photo.year), category?.name || ''].filter(Boolean);
const title = photoLabel(photo);
const navigation = await getPublicPhotoNavigation(photo);
const previousLabel = navigation.previous ? photoLabel(navigation.previous) : '';
const nextLabel = navigation.next ? photoLabel(navigation.next) : '';
---

<Layout
	title={`${title} | ${settings.site_name}`}
	description={photo.caption || photo.description || `Fotografía publicada en ${settings.site_name}.`}
>
	<PublicShell items={[{ href: '/', label: 'Inicio' }, { href: '/gallery', label: 'Galería' }]}>
		<main
			class="photo-page"
			data-previous-url={navigation.previous ? `/photo/${navigation.previous.id}` : undefined}
			data-next-url={navigation.next ? `/photo/${navigation.next.id}` : undefined}
		>
			<nav class="breadcrumbs" aria-label="Navegación secundaria">
				<a href="/gallery">Galería</a>
				{category && <a href={`/gallery/${category.slug}`}>{category.name}</a>}
			</nav>

			<article class="photo-detail">
				<figure class="photo-mount">
					<button class="image-button" type="button" data-open-lightbox aria-label="Ver fotografía grande">
						<img src={previewUrl(photo.image)} alt={photoAlt(photo)} />
						<span class="zoom-badge" aria-hidden="true">🔍 Ampliar</span>
					</button>
				</figure>

				<section class="photo-info" aria-labelledby="photo-title">
					<div class="info-header">
						<span class="info-eyebrow">Ficha de catalogación</span>
						<h1 id="photo-title">{title}</h1>
					</div>

					<dl class="catalog-metadata">
						{photo.year && (
							<div class="metadata-row">
								<dt>Año</dt>
								<dd class="year-val">{displayYear(photo.year)}</dd>
							</div>
						)}
						{category && (
							<div class="metadata-row">
								<dt>Categoría</dt>
								<dd><a class="category-link" href={`/gallery/${category.slug}`}>{category.name}</a></dd>
							</div>
						)}
						<div class="metadata-row">
							<dt>Referencia</dt>
							<dd class="ref-id">#{photo.id}</dd>
						</div>
					</dl>

					{meta.length > 0 && <p class="meta">{meta.join(' / ')}</p>}
					{photo.caption && <p class="caption">{photo.caption}</p>}
					{photo.description && <p class="description">{photo.description}</p>}

					<div class="actions">
						{category && <a class="action-btn back-btn" href={`/gallery/${category.slug}`}>Volver a {category.name}</a>}
						<button class="action-btn view-btn" type="button" data-open-lightbox>Ver grande</button>
						<a class="action-btn download-btn" href={downloadUrl(photo.image)} download>Descargar</a>
					</div>

					{(navigation.previous || navigation.next) && (
						<nav class="photo-navigation" aria-label="Fotografías de la misma categoría">
							{navigation.previous && (
								<a class="previous" href={`/photo/${navigation.previous.id}`} aria-label={`Anterior: ${previousLabel}`}>
									<span>← Anterior</span>
									<strong>{previousLabel}</strong>
								</a>
							)}
							{navigation.next && (
								<a class="next" href={`/photo/${navigation.next.id}`} aria-label={`Siguiente: ${nextLabel}`}>
									<span>Siguiente →</span>
									<strong>{nextLabel}</strong>
								</a>
							)}
						</nav>
					)}
				</section>
			</article>

			<dialog class="lightbox" aria-label={`Vista ampliada de ${title}`} aria-modal="true">
				<button class="lightbox-close" type="button" data-close-lightbox aria-label="Cerrar vista ampliada">
					Cerrar
				</button>
				<img data-src={lightboxUrl(photo.image)} alt={photoAlt(photo)} />
			</dialog>
		</main>
	</PublicShell>
</Layout>

<script>
	const page = document.querySelector('.photo-page');
	const lightbox = document.querySelector('.lightbox');
	const openButtons = document.querySelectorAll('[data-open-lightbox]');
	const closeButton = document.querySelector('[data-close-lightbox]');

	function openLightbox() {
		if (!(lightbox instanceof HTMLDialogElement)) return;
		const image = lightbox.querySelector('img[data-src]');

		if (image instanceof HTMLImageElement && !image.dataset.loaded && image.dataset.src) {
			image.src = image.dataset.src;
			image.dataset.loaded = 'true';
		}

		if (!lightbox.open) lightbox.showModal();
	}

	function closeLightbox() {
		if (!(lightbox instanceof HTMLDialogElement) || !lightbox.open) return;
		lightbox.close();
	}

	openButtons.forEach((button) => button.addEventListener('click', openLightbox));
	closeButton?.addEventListener('click', closeLightbox);

	lightbox?.addEventListener('click', (event) => {
		if (event.target === lightbox) closeLightbox();
	});

	document.addEventListener('keydown', (event) => {
		if (event.defaultPrevented) return;
        if (event.target instanceof HTMLElement && event.target.closest('input, select, textarea, [contenteditable]')) return;
		if (lightbox instanceof HTMLDialogElement && lightbox.open) return;

		if (!(page instanceof HTMLElement)) return;
		const previousUrl = page.dataset.previousUrl;
		const nextUrl = page.dataset.nextUrl;

		if (event.key === 'ArrowLeft' && previousUrl) {
			window.location.href = previousUrl;
		}

		if (event.key === 'ArrowRight' && nextUrl) {
			window.location.href = nextUrl;
		}
	});
</script>

<style>
	.photo-page {
		padding: clamp(24px, 4vw, 52px) clamp(18px, 5vw, 72px) 72px;
	}

	.breadcrumbs {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
		margin-bottom: 28px;
		color: var(--text-secondary);
		font-size: 0.86rem;
	}

	.breadcrumbs a + a::before {
		content: '/';
		margin-right: 16px;
		color: var(--border);
	}

	.photo-detail {
		display: grid;
		grid-template-columns: minmax(0, 1.35fr) minmax(290px, 1fr);
		align-items: start;
		gap: clamp(28px, 5vw, 64px);
	}

	.photo-mount {
		position: relative;
		display: grid;
		place-items: center;
		min-height: 340px;
		margin: 0;
		padding: clamp(12px, 2.5vw, 24px);
		background: var(--surface);
		border: 1px solid var(--border);
		box-shadow: var(--shadow-sm);
	}

	.image-button {
		position: relative;
		display: grid;
		place-items: center;
		width: 100%;
		padding: 0;
		border: 0;
		color: inherit;
		background: transparent;
		cursor: zoom-in;
	}

	.image-button:focus-visible,
	.actions a:focus-visible,
	.actions button:focus-visible,
	.photo-navigation a:focus-visible,
	.lightbox-close:focus-visible {
		outline: 2px solid var(--text);
		outline-offset: 4px;
	}

	.photo-mount img {
		width: 100%;
		max-height: calc(100vh - 180px);
		object-fit: contain;
		display: block;
	}

	.zoom-badge {
		position: absolute;
		right: 10px;
		bottom: 10px;
		padding: 5px 10px;
		background: rgba(18, 16, 14, 0.82);
		color: #f7f6f2;
		font-family: var(--font-sans);
		font-size: 0.72rem;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		border: 1px solid rgba(255, 255, 255, 0.2);
		opacity: 0.85;
		transition: opacity 0.2s ease, transform 0.2s ease;
		pointer-events: none;
	}

	.image-button:hover .zoom-badge,
	.image-button:focus-visible .zoom-badge {
		opacity: 1;
		transform: translateY(-2px);
	}

	.photo-info {
		display: grid;
		gap: 20px;
		padding-top: 4px;
	}

	.info-header {
		display: grid;
		gap: 6px;
		border-bottom: 1px solid var(--border);
		padding-bottom: 14px;
	}

	.info-eyebrow {
		font-family: var(--font-sans);
		font-size: 0.72rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--text-secondary);
	}

	h1 {
		margin: 0;
		font-size: clamp(1.8rem, 3vw, 2.75rem);
		font-weight: 560;
		line-height: 1.1;
		letter-spacing: -0.01em;
	}

	.catalog-metadata {
		display: grid;
		gap: 10px;
		margin: 0;
		padding: 12px 14px;
		background: var(--surface);
		border: 1px solid var(--border);
		font-family: var(--font-sans);
		font-size: 0.82rem;
	}

	.metadata-row {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 16px;
	}

	.metadata-row dt {
		color: var(--text-secondary);
		font-size: 0.74rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	.metadata-row dd {
		margin: 0;
		font-weight: 500;
		color: var(--text);
		text-align: right;
	}

	.category-link {
		color: var(--text);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.ref-id {
		font-family: var(--font-mono);
		font-size: 0.76rem;
		color: var(--text-secondary);
	}

	.meta,
	.caption,
	.description {
		margin: 0;
		color: var(--text-secondary);
		line-height: 1.65;
	}

	.meta {
		color: var(--text-secondary);
		font-size: 0.78rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.caption {
		font-size: 1.05rem;
		color: var(--text);
		line-height: 1.5;
	}

	.description {
		white-space: pre-line;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-top: 10px;
	}

	.action-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 8px 16px;
		border: 1px solid var(--border);
		background: var(--surface);
		color: var(--text);
		font-family: var(--font-sans);
		font-size: 0.76rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		text-decoration: none;
		cursor: pointer;
		transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
	}

	.action-btn:hover {
		border-color: var(--text);
		background: var(--surface-hover);
	}

	.action-btn.view-btn {
		background: var(--text);
		color: var(--bg);
		border-color: var(--text);
	}

	.action-btn.view-btn:hover {
		opacity: 0.9;
	}

	.photo-navigation {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 12px;
		margin-top: 16px;
		border-top: 1px solid var(--border);
		padding-top: 20px;
	}

	.photo-navigation a {
		display: grid;
		gap: 5px;
		min-height: 82px;
		border: 1px solid var(--border);
		padding: 14px 16px;
		align-content: center;
		background: var(--surface);
		text-decoration: none;
		transition: border-color 0.15s ease, background 0.15s ease, transform 0.15s ease;
	}

	.photo-navigation a:hover {
		border-color: var(--text-secondary);
		background: var(--surface-hover);
		transform: translateY(-1px);
	}

	.photo-navigation .next {
		grid-column: 2;
		text-align: right;
	}

	.photo-navigation span {
		color: var(--text-secondary);
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.photo-navigation strong {
		overflow: hidden;
		color: var(--text);
		font-size: 0.92rem;
		font-weight: 520;
		line-height: 1.35;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.lightbox {
		--text: #f5f5f5;
		--border: #777;
		width: min(96vw, 1800px);
		max-width: none;
		max-height: 96vh;
		border: 0;
		padding: 46px 18px 18px;
		background: #050505;
		color: var(--text);
	}

	.lightbox::backdrop {
		background: rgba(0, 0, 0, 0.88);
	}

	.lightbox img {
		width: 100%;
		max-height: calc(96vh - 64px);
		object-fit: contain;
	}

	.lightbox-close {
		position: absolute;
		top: 12px;
		right: 14px;
		border: 1px solid var(--border);
		padding: 8px 12px;
		color: var(--text);
		background: rgba(5, 5, 5, 0.8);
		cursor: pointer;
	}

	@media (max-width: 900px) {
		.photo-detail {
			grid-template-columns: 1fr;
		}

		.photo-mount img {
			max-height: 68vh;
		}

		.photo-navigation {
			grid-template-columns: 1fr;
		}

		.photo-navigation .next {
			grid-column: auto;
			text-align: left;
		}
	}
</style>
