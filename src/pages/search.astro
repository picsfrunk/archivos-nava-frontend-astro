---
import Layout from '../layouts/Layout.astro';
import PublicShell from '../components/PublicShell.astro';
import PhotoCard from '../components/PhotoCard.astro';
import { getSiteSettings } from '../lib/site-settings';
import { searchPublicPhotos, getSearchCategories } from '../lib/public-gallery';
export const prerender = false;
const settings = await getSiteSettings(Astro.request);
const params = Astro.url.searchParams;
const search = (params.get('search') || '').trim();
const category = (params.get('category') || '').trim();
const year = (params.get('year') || '').trim();
const pageValue = params.get('page') || '1';
const page = Number(pageValue);
let error = '';
if (year && (!/^\d{1,4}$/.test(year) || Number(year) < 1800 || Number(year) > 2100)) error = 'Ingresá un año entero entre 1800 y 2100.';
else if (search.length > 200) error = 'La búsqueda admite hasta 200 caracteres.';
else if (category && !/^[a-z0-9]{15}$/.test(category)) error = 'Elegí una categoría válida.';
else if (!/^\d+$/.test(pageValue) || page < 1 || page > 1000000) error = 'La página indicada no es válida.';
let categories = [];
let result = { items: [], totalPages: 0, totalItems: 0 };
if (error) Astro.response.status = 400;
try {
    categories = await getSearchCategories();
    if (!error) result = await searchPublicPhotos(search, category, year, page);
} catch {
    error = 'No pudimos cargar las fotografías. Volvé a intentarlo en unos momentos.';
    Astro.response.status = 503;
}
function pageUrl(next: number) {
    const query = new URLSearchParams();
    if (search) query.set('search', search);
    if (category) query.set('category', category);
    if (year) query.set('year', year);
    query.set('page', String(next));
    return `/search?${query}`;
}
---
<Layout title={`Buscar | ${settings.site_name}`} description="Buscá fotografías por título, descripción, categoría o año.">
    <PublicShell items={[{ href: '/', label: 'Inicio' }, { href: '/gallery', label: 'Galería' }]}>
        <main>
            <div class="page-header">
                <p class="page-eyebrow">FICHERO GENERAL // CONSULTA DOCUMENTAL</p>
                <h1>Buscar fotografías</h1>
            </div>

            <search>
                <form action="/search" method="get">
                    <label class="search-text">
                        <span>Texto o referencia</span>
                        <input type="search" name="search" value={search} maxlength="200" placeholder="Título, descripción, lugar o personas…" />
                    </label>
                    <label>
                        <span>Categoría / Rollo</span>
                        <select name="category">
                            <option value="">Todas</option>
                            {categories.map(item => <option value={item.id} selected={item.id === category}>{item.name}</option>)}
                        </select>
                    </label>
                    <label>
                        <span>Año</span>
                        <input name="year" inputmode="numeric" maxlength="4" value={year} placeholder="Ej. 1985" />
                    </label>
                    <button type="submit">Buscar</button>
                    <a href="/search" class="clear-link">Limpiar filtros</a>
                </form>
            </search>

            {error ? <p role="alert">{error}</p> : <>
                <p role="status">{result.totalItems} {result.totalItems === 1 ? 'fotografía encontrada' : 'fotografías encontradas'}</p>
                {result.items.length ? (
                    <section class="photo-grid stagger-grid" aria-label="Resultados de búsqueda">
                        {result.items.map((photo, idx) => <PhotoCard photo={photo} showCategory frameIndex={(page - 1) * 24 + idx + 1} />)}
                    </section>
                ) : (
                    <p class="empty-notice">{search || category || year ? 'Ninguna fotografía coincide con los filtros.' : 'Todavía no hay fotografías publicadas.'}</p>
                )}
                <nav class="pager" aria-label="Páginas de resultados">
                    {page > 1 && <a href={pageUrl(page - 1)}>← Anterior</a>}
                    <span>Página {page}{result.totalPages > 0 ? ` de ${result.totalPages}` : ''}</span>
                    {page < result.totalPages && <a href={pageUrl(page + 1)}>Siguiente →</a>}
                </nav>
            </>}
        </main>
    </PublicShell>
</Layout>
<style>
	main {
		padding: clamp(32px, 5vw, 60px) clamp(18px, 4vw, 48px) 80px;
		max-width: 1480px;
		margin: 0 auto;
		box-sizing: border-box;
	}

	.page-header {
		margin-bottom: clamp(20px, 3vw, 32px);
	}

	.page-eyebrow {
		margin: 0 0 10px;
		color: var(--film-stamp);
		font-size: 0.72rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		font-family: var(--font-mono);
	}

	h1 {
		margin: 0;
		font-size: clamp(2.2rem, 4.5vw, 3.8rem);
		font-family: var(--font-serif);
		font-weight: 500;
		line-height: 1.05;
		letter-spacing: -0.015em;
	}

	form {
		display: grid;
		grid-template-columns: minmax(220px, 1fr) minmax(180px, 230px) 120px auto auto;
		gap: 16px;
		align-items: end;
		margin: 28px 0;
		padding: 20px 24px;
		background: var(--surface-card);
		border: 1px solid var(--border);
		border-top: 2px solid var(--accent);
		border-radius: var(--radius-md);
		box-shadow: var(--shadow-sm);
		box-sizing: border-box;
	}

	label {
		display: grid;
		gap: 8px;
		min-width: 0;
		max-width: 100%;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-secondary);
	}

	.search-text {
		min-width: 0;
		width: 100%;
	}

	input, select, button {
		width: 100%;
		min-height: 44px;
		min-width: 0;
		max-width: 100%;
		padding: 10px 14px;
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		background: var(--surface);
		color: var(--text);
		font-family: var(--font-sans);
		font-size: 0.9rem;
		box-sizing: border-box;
		transition: border-color 0.15s ease;
	}

	input:focus, select:focus {
		border-color: var(--accent);
		outline: 1px solid var(--accent);
	}

	input[name="year"] {
		width: 100%;
	}

	button {
		padding: 10px 22px;
		background: var(--accent);
		color: #14110d;
		border: 1px solid var(--accent);
		font-family: var(--font-mono);
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		font-size: 0.78rem;
		cursor: pointer;
		transition: background-color 0.15s ease, border-color 0.15s ease;
	}

	button:hover {
		background: var(--accent-strong);
		border-color: var(--accent-strong);
	}

	.clear-link {
		padding-block: 12px;
		color: var(--text-secondary);
		font-family: var(--font-mono);
		font-size: 0.76rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		text-decoration: underline;
		text-underline-offset: 4px;
		transition: color 0.15s ease;
	}

	.clear-link:hover {
		color: var(--text);
	}

	[role="status"] {
		margin: 0 0 22px;
		color: var(--text-secondary);
		font-family: var(--font-mono);
		font-size: 0.76rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	[role="alert"] {
		padding: 16px 20px;
		background: var(--danger-bg);
		border: 1px solid var(--danger-border);
		border-left: 3px solid var(--danger);
		border-radius: var(--radius-sm);
		color: var(--text);
		font-size: 0.92rem;
		margin: 24px 0;
	}

	.empty-notice {
		padding: 48px 24px;
		border: 1px dashed var(--border);
		border-radius: var(--radius-md);
		background: var(--surface-card);
		text-align: center;
		color: var(--text-secondary);
		font-size: 0.95rem;
		margin: 24px 0;
	}

	.photo-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(260px, 100%), 1fr));
		gap: 24px;
	}

	.pager {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
		align-items: center;
		justify-content: center;
		margin-top: 48px;
		font-family: var(--font-mono);
		font-size: 0.8rem;
	}

	.pager a {
		padding: 10px 18px;
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		background: var(--surface-card);
		color: var(--text);
		text-decoration: none;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		transition: border-color 0.15s ease, background-color 0.15s ease;
	}

	.pager a:hover {
		border-color: var(--accent);
		background: var(--surface-hover);
	}

	.pager span {
		color: var(--text-secondary);
		font-size: 0.8rem;
	}

	@media (max-width: 860px) {
		form {
			grid-template-columns: minmax(0, 1fr) 120px;
			padding: 16px;
			gap: 12px;
		}

		.search-text {
			grid-column: 1 / -1;
		}

		button {
			grid-column: 1 / -1;
			width: 100%;
		}

		.clear-link {
			grid-column: 1 / -1;
			text-align: center;
			padding-block: 4px;
		}
	}
</style>
