---
import Layout from '../../layouts/Layout.astro';

const pocketbaseUrl = import.meta.env.PUBLIC_POCKETBASE_URL ?? 'http://127.0.0.1:8090';
---

<Layout
	title="Admin | ARCHIVOS NAVA"
	description="Panel administrativo de ARCHIVOS NAVA."
>
	<main class="admin-shell">
		<header class="admin-header">
			<div>
				<a href="/" class="brand">ARCHIVOS NAVA</a>
				<p>Panel administrativo</p>
			</div>

			<button id="logout-button" type="button">Salir</button>
		</header>

		<section class="workspace" aria-labelledby="create-photo-title">
			<div class="section-heading">
				<p class="eyebrow">Fotografías</p>
				<h1 id="create-photo-title">Crear fotografía</h1>
			</div>

			<form id="photo-form" novalidate>
				<div class="form-grid">
					<section class="dropzone" id="dropzone">
						<input id="file" name="file" type="file" accept="image/*" required />
						<div id="preview" class="preview" aria-live="polite">
							<span>Arrastrá una imagen o seleccioná un archivo</span>
						</div>
						<button class="secondary-button" type="button" id="file-button">
							Seleccionar imagen
						</button>
					</section>

					<section class="fields">
						<label>
							<span>Categoría</span>
							<select id="category" name="category" required>
								<option value="">Cargando categorías...</option>
							</select>
						</label>

						<label>
							<span>Título</span>
							<input id="title" name="title" type="text" autocomplete="off" />
						</label>

						<label>
							<span>Año</span>
							<input id="year" name="year" type="number" inputmode="numeric" />
						</label>

						<label>
							<span>Epígrafe</span>
							<input id="caption" name="caption" type="text" autocomplete="off" />
						</label>

						<label>
							<span>Descripción</span>
							<textarea id="description" name="description" rows="5"></textarea>
						</label>
					</section>
				</div>

				<div class="actions">
					<button type="submit" name="status" value="draft">Guardar borrador</button>
					<button type="submit" name="status" value="published">Publicar</button>
				</div>
			</form>

			<p id="admin-message" class="message" role="status" aria-live="polite"></p>
		</section>
	</main>
</Layout>

<script define:vars={{ pocketbaseUrl }}>
	import PocketBase from 'pocketbase';

	const pb = new PocketBase(pocketbaseUrl);
	const form = document.querySelector('#photo-form');
	const fileInput = document.querySelector('#file');
	const fileButton = document.querySelector('#file-button');
	const dropzone = document.querySelector('#dropzone');
	const preview = document.querySelector('#preview');
	const categorySelect = document.querySelector('#category');
	const logoutButton = document.querySelector('#logout-button');
	const message = document.querySelector('#admin-message');
	const maxImageBytes = 10 * 1024 * 1024;

	let selectedFile = null;

	function setMessage(text, type = 'neutral') {
		if (!(message instanceof HTMLElement)) return;

		message.textContent = text;
		message.dataset.type = type;
	}

	function redirectToLogin() {
		pb.authStore.clear();
		window.location.href = '/admin/login';
	}

	function isAdminSession() {
		return pb.authStore.model?.collectionName === 'admins';
	}

	async function requireAdminSession() {
		if (!pb.authStore.isValid || !isAdminSession()) {
			redirectToLogin();
			return false;
		}

		try {
			await pb.collection('admins').authRefresh();
			return true;
		} catch {
			redirectToLogin();
			return false;
		}
	}

	function setPreview(file) {
		selectedFile = file;

		if (!(preview instanceof HTMLElement)) return;

		if (!file) {
			preview.innerHTML = '<span>Arrastrá una imagen o seleccioná un archivo</span>';
			return;
		}

		const url = URL.createObjectURL(file);
		preview.innerHTML = '';

		const image = document.createElement('img');
		image.src = url;
		image.alt = file.name;
		image.onload = () => URL.revokeObjectURL(url);

		const meta = document.createElement('span');
		meta.textContent = `${file.name} (${Math.round(file.size / 1024)} KB)`;

		preview.append(image, meta);
	}

	function resolveError(error) {
		if (error?.data?.error) return error.data.error;
		if (error?.data?.message) return error.data.message;
		if (error?.message) return error.message;

		return 'No se pudo completar la operación.';
	}

	async function loadCategories() {
		if (!(categorySelect instanceof HTMLSelectElement)) return;

		try {
			const categories = await pb.collection('categories').getFullList({
				filter: 'active = true',
				sort: 'sort_order,name',
			});

			categorySelect.innerHTML = '';

			const placeholder = document.createElement('option');
			placeholder.value = '';
			placeholder.textContent = categories.length
				? 'Seleccioná una categoría'
				: 'No hay categorías activas';
			categorySelect.append(placeholder);

			for (const category of categories) {
				const option = document.createElement('option');
				option.value = category.id;
				option.textContent = category.name || category.slug || category.id;
				categorySelect.append(option);
			}

			categorySelect.disabled = categories.length === 0;
		} catch {
			categorySelect.innerHTML = '<option value="">No se pudieron cargar categorías</option>';
			categorySelect.disabled = true;
			setMessage('No se pudieron cargar las categorías activas.', 'error');
		}
	}

	function validateSelectedImage(file) {
		if (!file.type.startsWith('image/')) {
			setMessage('El archivo seleccionado no parece ser una imagen.', 'error');
			return false;
		}

		if (file.size > maxImageBytes) {
			setMessage('La imagen no puede superar los 10 MB.', 'error');
			return false;
		}

		return true;
	}

	async function createPhoto(status, submitButton) {
		if (!(form instanceof HTMLFormElement)) return;

		const data = new FormData(form);
		const category = String(data.get('category') || '').trim();

		if (!selectedFile) {
			setMessage('Seleccioná una imagen antes de guardar.', 'error');
			return;
		}

		if (!validateSelectedImage(selectedFile)) {
			return;
		}

		if (!category) {
			setMessage('Seleccioná una categoría.', 'error');
			return;
		}

		const payload = new FormData();
		payload.append('file', selectedFile);
		payload.append('category', category);
		payload.append('status', status);

		for (const field of ['title', 'year', 'caption', 'description']) {
			const value = String(data.get(field) || '').trim();
			if (value) {
				payload.append(field, value);
			}
		}

		if (submitButton instanceof HTMLButtonElement) {
			submitButton.disabled = true;
			submitButton.textContent = status === 'published' ? 'Publicando...' : 'Guardando...';
		}

		setMessage('');

		try {
			const response = await fetch(`${pocketbaseUrl}/api/archivos-nava/photos`, {
				method: 'POST',
				headers: {
					Authorization: `Bearer ${pb.authStore.token}`,
				},
				body: payload,
			});

			const result = await response.json().catch(() => ({}));

			if (response.status === 401 || response.status === 403) {
				redirectToLogin();
				return;
			}

			if (!response.ok || result.success === false) {
				throw result;
			}

			form.reset();
			setPreview(null);
			await loadCategories();
			setMessage(
				status === 'published'
					? 'Fotografía publicada correctamente.'
					: 'Borrador guardado correctamente.',
				'success',
			);
		} catch (error) {
			setMessage(resolveError(error), 'error');
		} finally {
			if (submitButton instanceof HTMLButtonElement) {
				submitButton.disabled = false;
				submitButton.textContent =
					status === 'published' ? 'Publicar' : 'Guardar borrador';
			}
		}
	}

	requireAdminSession().then((isValid) => {
		if (isValid) {
			loadCategories();
		}
	});

	logoutButton?.addEventListener('click', () => {
		pb.authStore.clear();
		window.location.href = '/admin/login';
	});

	fileButton?.addEventListener('click', () => {
		if (fileInput instanceof HTMLInputElement) {
			fileInput.click();
		}
	});

	fileInput?.addEventListener('change', () => {
		if (!(fileInput instanceof HTMLInputElement)) return;

		const file = fileInput.files?.[0] || null;
		if (file && !validateSelectedImage(file)) {
			fileInput.value = '';
			setPreview(null);
			return;
		}

		setPreview(file);
	});

	dropzone?.addEventListener('dragover', (event) => {
		event.preventDefault();
		dropzone.classList.add('is-dragging');
	});

	dropzone?.addEventListener('dragleave', () => {
		dropzone.classList.remove('is-dragging');
	});

	dropzone?.addEventListener('drop', (event) => {
		event.preventDefault();
		dropzone.classList.remove('is-dragging');

		const file = event.dataTransfer?.files?.[0];
		if (!file) return;

		if (!validateSelectedImage(file)) {
			return;
		}

		if (fileInput instanceof HTMLInputElement) {
			const transfer = new DataTransfer();
			transfer.items.add(file);
			fileInput.files = transfer.files;
		}

		setPreview(file);
	});

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();

		const submitter = event.submitter;
		const status =
			submitter instanceof HTMLButtonElement && submitter.value === 'published'
				? 'published'
				: 'draft';

		await createPhoto(status, submitter);
	});
</script>

<style>
	.admin-shell {
		min-height: 100vh;
		padding: 28px;
		background: #10100f;
		color: #f5f5f5;
	}

	.admin-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
		max-width: 1180px;
		margin: 0 auto 48px;
	}

	.brand {
		display: inline-block;
		margin-bottom: 8px;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.18em;
	}

	.admin-header p,
	.eyebrow {
		margin: 0;
		color: rgba(245, 245, 245, 0.58);
		font-size: 0.78rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.workspace {
		max-width: 1180px;
		margin: 0 auto;
	}

	.section-heading {
		margin-bottom: 28px;
	}

	h1 {
		margin: 8px 0 0;
		font-size: clamp(2rem, 4vw, 4.2rem);
		font-weight: 500;
		line-height: 1;
	}

	form {
		display: grid;
		gap: 24px;
	}

	.form-grid {
		display: grid;
		grid-template-columns: minmax(280px, 0.85fr) minmax(320px, 1fr);
		gap: 24px;
	}

	.dropzone,
	.fields {
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 8px;
		background: #171716;
	}

	.dropzone {
		display: flex;
		flex-direction: column;
		gap: 18px;
		padding: 18px;
	}

	.dropzone.is-dragging {
		border-color: rgba(255, 255, 255, 0.56);
		background: #20201f;
	}

	.dropzone input {
		position: absolute;
		width: 1px;
		height: 1px;
		opacity: 0;
		pointer-events: none;
	}

	.preview {
		display: grid;
		place-items: center;
		min-height: 420px;
		border: 1px dashed rgba(255, 255, 255, 0.22);
		border-radius: 6px;
		padding: 18px;
		color: rgba(245, 245, 245, 0.58);
		text-align: center;
	}

	.preview img {
		width: 100%;
		max-height: 390px;
		object-fit: contain;
	}

	.preview span {
		margin-top: 12px;
		font-size: 0.88rem;
		line-height: 1.45;
	}

	.fields {
		display: grid;
		gap: 18px;
		padding: 24px;
	}

	label {
		display: grid;
		gap: 8px;
		color: rgba(245, 245, 245, 0.72);
		font-size: 0.9rem;
	}

	input,
	textarea,
	select {
		width: 100%;
		border: 1px solid rgba(255, 255, 255, 0.14);
		border-radius: 6px;
		padding: 12px 14px;
		color: #f5f5f5;
		background: rgba(255, 255, 255, 0.06);
		outline: none;
	}

	textarea {
		resize: vertical;
	}

	input:focus,
	textarea:focus,
	select:focus {
		border-color: rgba(255, 255, 255, 0.52);
	}

	button {
		border-radius: 6px;
		padding: 12px 16px;
		color: #101010;
		background: #f5f5f5;
		cursor: pointer;
	}

	button:disabled {
		cursor: wait;
		opacity: 0.68;
	}

	.secondary-button,
	#logout-button {
		border: 1px solid rgba(255, 255, 255, 0.18);
		color: #f5f5f5;
		background: transparent;
	}

	.actions {
		display: flex;
		justify-content: flex-end;
		gap: 12px;
	}

	.message {
		min-height: 1.5em;
		margin: 18px 0 0;
		color: rgba(245, 245, 245, 0.72);
		font-size: 0.95rem;
		line-height: 1.5;
	}

	.message[data-type="error"] {
		color: #ffb4a9;
	}

	.message[data-type="success"] {
		color: #b8e7c9;
	}

	@media (max-width: 820px) {
		.admin-shell {
			padding: 20px;
		}

		.admin-header {
			margin-bottom: 36px;
		}

		.form-grid {
			grid-template-columns: 1fr;
		}

		.preview {
			min-height: 280px;
		}
	}

	@media (max-width: 540px) {
		.admin-header,
		.actions {
			align-items: stretch;
			flex-direction: column;
		}

		.actions button,
		#logout-button {
			width: 100%;
		}
	}
</style>
