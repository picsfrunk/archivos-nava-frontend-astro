---
import Layout from '../../layouts/Layout.astro';
---

<Layout
	title="Admin | ARCHIVOS NAVA"
	description="Panel administrativo de ARCHIVOS NAVA."
>
	<main class="admin-shell">
		<header class="admin-header">
			<div>
				<a href="/" class="brand">ARCHIVOS NAVA</a>
				<p>Panel administrativo</p>
			</div>

			<button id="logout-button" type="button">Salir</button>
		</header>

		<section class="workspace" aria-labelledby="create-photo-title">
			<div class="section-heading">
				<p class="eyebrow">Fotografías</p>
				<h1 id="create-photo-title">Crear fotografías</h1>
			</div>

			<form id="photo-form" novalidate>
				<div class="form-grid">
					<section class="dropzone" id="dropzone">
						<input id="file" name="file" type="file" accept="image/*" multiple required />
						<div id="preview" class="preview" aria-live="polite">
							<span>Arrastrá imágenes o seleccioná archivos</span>
						</div>
						<button class="secondary-button" type="button" id="file-button">
							Seleccionar imágenes
						</button>
						<ul id="selected-list" class="selected-list" aria-live="polite"></ul>
					</section>

					<section class="fields">
						<label>
							<span>Categoría</span>
							<select id="category" name="category" required>
								<option value="">Cargando categorías...</option>
							</select>
						</label>

						<label>
							<span>Título individual</span>
							<input id="title" name="title" type="text" autocomplete="off" />
						</label>

						<label>
							<span>Año</span>
							<input id="year" name="year" type="number" inputmode="numeric" />
						</label>

						<label>
							<span>Epígrafe</span>
							<input id="caption" name="caption" type="text" autocomplete="off" />
						</label>

						<label>
							<span>Descripción</span>
							<textarea id="description" name="description" rows="5"></textarea>
						</label>
					</section>
				</div>

				<div class="actions">
					<button type="submit" name="status" value="draft">Guardar borrador</button>
					<button type="submit" name="status" value="published">Publicar</button>
				</div>
			</form>

			<p id="admin-message" class="message" role="status" aria-live="polite"></p>
		</section>
	</main>
</Layout>

<script>
	import { pb, pocketbaseUrl } from '../../lib/pocketbase';

	const form = document.querySelector('#photo-form');
	const fileInput = document.querySelector('#file');
	const fileButton = document.querySelector('#file-button');
	const dropzone = document.querySelector('#dropzone');
	const preview = document.querySelector('#preview');
	const selectedList = document.querySelector('#selected-list');
	const categorySelect = document.querySelector('#category');
	const titleInput = document.querySelector('#title');
	const logoutButton = document.querySelector('#logout-button');
	const message = document.querySelector('#admin-message');
	const maxImageBytes = 10 * 1024 * 1024;
	const uploadConcurrency = 3;

	let selectedItems = [];
	let nextItemId = 1;
	let isUploading = false;

	function setMessage(text, type = 'neutral') {
		if (!(message instanceof HTMLElement)) return;

		message.textContent = text;
		message.dataset.type = type;
	}

	function redirectToLogin() {
		pb.authStore.clear();
		window.location.href = '/admin/login';
	}

	function isAdminSession() {
		return pb.authStore.model?.collectionName === 'admins';
	}

	async function requireAdminSession() {
		if (!pb.authStore.isValid || !isAdminSession()) {
			redirectToLogin();
			return false;
		}

		try {
			await pb.collection('admins').authRefresh();
			return true;
		} catch {
			redirectToLogin();
			return false;
		}
	}

	function formatFileSize(bytes) {
		if (bytes >= 1024 * 1024) {
			return `${(bytes / 1024 / 1024).toFixed(1)} MB`;
		}

		return `${Math.max(1, Math.round(bytes / 1024))} KB`;
	}

	function getStatusLabel(status) {
		const labels = {
			pending: 'Pendiente',
			uploading: 'Subiendo',
			success: 'OK',
			error: 'Error',
		};

		return labels[status] || status;
	}

	function refreshPreview() {
		if (!(preview instanceof HTMLElement)) return;

		if (selectedItems.length === 0) {
			preview.innerHTML = '<span>Arrastrá imágenes o seleccioná archivos</span>';
			return;
		}

		preview.innerHTML = '';

		const grid = document.createElement('div');
		grid.className = 'preview-grid';

		for (const item of selectedItems.slice(0, 6)) {
			const image = document.createElement('img');
			image.src = item.previewUrl;
			image.alt = item.file.name;
			grid.append(image);
		}

		const meta = document.createElement('span');
		const extraCount = selectedItems.length > 6 ? `, ${selectedItems.length - 6} más` : '';
		meta.textContent = `${selectedItems.length} foto${selectedItems.length === 1 ? '' : 's'} seleccionada${selectedItems.length === 1 ? '' : 's'}${extraCount}`;

		preview.append(grid, meta);
	}

	function renderSelectedList() {
		if (!(selectedList instanceof HTMLElement)) return;

		selectedList.innerHTML = '';

		for (const item of selectedItems) {
			const row = document.createElement('li');
			row.className = 'selected-item';
			row.dataset.status = item.status;

			const image = document.createElement('img');
			image.src = item.previewUrl;
			image.alt = item.file.name;

			const details = document.createElement('div');
			details.className = 'selected-details';

			const name = document.createElement('strong');
			name.textContent = item.file.name;

			const meta = document.createElement('span');
			meta.textContent = `${formatFileSize(item.file.size)} - ${getStatusLabel(item.status)}`;

			const progress = document.createElement('progress');
			progress.max = 100;
			if (item.status === 'uploading') {
				progress.value = item.progress;
			} else if (item.status === 'success') {
				progress.value = 100;
			} else {
				progress.value = 0;
			}

			details.append(name, meta, progress);

			if (item.error) {
				const error = document.createElement('span');
				error.className = 'item-error';
				error.textContent = item.error;
				details.append(error);
			}

			const removeButton = document.createElement('button');
			removeButton.type = 'button';
			removeButton.className = 'remove-button';
			removeButton.textContent = 'Quitar';
			removeButton.disabled = isUploading || item.status === 'uploading';
			removeButton.addEventListener('click', () => removeSelectedItem(item.id));

			row.append(image, details, removeButton);
			selectedList.append(row);
		}
	}

	function renderSelection() {
		refreshPreview();
		renderSelectedList();

		if (titleInput instanceof HTMLInputElement) {
			titleInput.disabled = selectedItems.length > 1;
		}
	}

	function clearSelectedItems() {
		for (const item of selectedItems) {
			URL.revokeObjectURL(item.previewUrl);
		}

		selectedItems = [];
		renderSelection();
	}

	function removeSelectedItem(id) {
		const item = selectedItems.find((selectedItem) => selectedItem.id === id);
		if (item) {
			URL.revokeObjectURL(item.previewUrl);
		}

		selectedItems = selectedItems.filter((selectedItem) => selectedItem.id !== id);
		renderSelection();
	}

	function updateSelectedItem(id, updates) {
		selectedItems = selectedItems.map((item) =>
			item.id === id ? { ...item, ...updates } : item,
		);
		renderSelectedList();
	}

	function resolveError(error) {
		if (error?.data?.error) return error.data.error;
		if (error?.data?.message) return error.data.message;
		if (error?.error) return error.error;
		if (error?.message) return error.message;

		return 'No se pudo completar la operación.';
	}

	async function loadCategories() {
		if (!(categorySelect instanceof HTMLSelectElement)) return;

		try {
			const categories = await pb.collection('categories').getFullList({
				filter: 'active = true',
				sort: 'sort_order,name',
			});

			categorySelect.innerHTML = '';

			const placeholder = document.createElement('option');
			placeholder.value = '';
			placeholder.textContent = categories.length
				? 'Seleccioná una categoría'
				: 'No hay categorías activas';
			categorySelect.append(placeholder);

			for (const category of categories) {
				const option = document.createElement('option');
				option.value = category.id;
				option.textContent = category.name || category.slug || category.id;
				categorySelect.append(option);
			}

			categorySelect.disabled = categories.length === 0;
		} catch {
			categorySelect.innerHTML = '<option value="">No se pudieron cargar categorías</option>';
			categorySelect.disabled = true;
			setMessage('No se pudieron cargar las categorías activas.', 'error');
		}
	}

	function validateImageFile(file) {
		if (!file.type.startsWith('image/')) {
			return 'no parece ser una imagen';
		}

		if (file.size > maxImageBytes) {
			return 'supera el límite de 10 MB';
		}

		return '';
	}

	function addFiles(files) {
		const accepted = [];
		const rejected = [];

		for (const file of files) {
			const validationError = validateImageFile(file);
			if (validationError) {
				rejected.push(`${file.name}: ${validationError}`);
				continue;
			}

			accepted.push({
				id: nextItemId++,
				file,
				previewUrl: URL.createObjectURL(file),
				status: 'pending',
				progress: 0,
				error: '',
			});
		}

		selectedItems = [...selectedItems, ...accepted];
		renderSelection();

		if (rejected.length && accepted.length) {
			setMessage(`Algunas fotos no se agregaron: ${rejected.join('; ')}.`, 'error');
		} else if (rejected.length) {
			setMessage(`No se agregaron fotos: ${rejected.join('; ')}.`, 'error');
		} else if (accepted.length) {
			setMessage('');
		}
	}

	function uploadPhoto(item, payloadBase) {
		return new Promise((resolve, reject) => {
			const payload = new FormData();
			payload.append('file', item.file);

			for (const [key, value] of payloadBase.entries()) {
				payload.append(key, value);
			}

			const request = new XMLHttpRequest();
			request.open('POST', `${pocketbaseUrl}/api/archivos-nava/photos`);
			request.setRequestHeader('Authorization', `Bearer ${pb.authStore.token}`);

			request.upload.addEventListener('progress', (event) => {
				if (!event.lengthComputable) return;

				updateSelectedItem(item.id, {
					progress: Math.round((event.loaded / event.total) * 100),
				});
			});

			request.addEventListener('load', () => {
				let result = {};
				try {
					result = JSON.parse(request.responseText || '{}');
				} catch {
					result = {};
				}

				if (request.status === 401 || request.status === 403) {
					reject({ authError: true });
					return;
				}

				if (request.status < 200 || request.status >= 300 || result.success === false) {
					reject(result);
					return;
				}

				resolve(result);
			});

			request.addEventListener('error', () => {
				reject(new Error('No se pudo conectar con el servidor.'));
			});

			request.send(payload);
		});
	}

	async function runLimitedUploads(items, payloadBase) {
		let cursor = 0;
		let authError = false;

		async function worker() {
			while (cursor < items.length && !authError) {
				const item = items[cursor++];
				updateSelectedItem(item.id, {
					status: 'uploading',
					progress: 0,
					error: '',
				});

				try {
					await uploadPhoto(item, payloadBase);
					updateSelectedItem(item.id, {
						status: 'success',
						progress: 100,
						error: '',
					});
				} catch (error) {
					if (error?.authError) {
						authError = true;
						redirectToLogin();
						return;
					}

					updateSelectedItem(item.id, {
						status: 'error',
						progress: 0,
						error: resolveError(error),
					});
				}
			}
		}

		await Promise.all(
			Array.from({ length: Math.min(uploadConcurrency, items.length) }, () => worker()),
		);
	}

	function summarizeUpload() {
		const successCount = selectedItems.filter((item) => item.status === 'success').length;
		const errorCount = selectedItems.filter((item) => item.status === 'error').length;
		const pendingCount = selectedItems.filter((item) => item.status === 'pending').length;

		const parts = [];
		if (successCount) {
			parts.push(`${successCount} subida${successCount === 1 ? '' : 's'} correctamente`);
		}
		if (errorCount) parts.push(`${errorCount} con error`);
		if (pendingCount) parts.push(`${pendingCount} pendiente${pendingCount === 1 ? '' : 's'}`);

		return parts.join('; ') || 'No hubo cambios.';
	}

	async function createPhotos(status, submitButton) {
		if (!(form instanceof HTMLFormElement)) return;

		const data = new FormData(form);
		const category = String(data.get('category') || '').trim();
		const uploadableItems = selectedItems.filter((item) =>
			item.status === 'pending' || item.status === 'error',
		);

		if (!selectedItems.length) {
			setMessage('Seleccioná una o más imágenes antes de guardar.', 'error');
			return;
		}

		if (!uploadableItems.length) {
			setMessage('No quedan fotos pendientes para subir.', 'success');
			return;
		}

		if (!category) {
			setMessage('Seleccioná una categoría.', 'error');
			return;
		}

		const payloadBase = new FormData();
		payloadBase.append('category', category);
		payloadBase.append('status', status);

		for (const field of ['year', 'caption', 'description']) {
			const value = String(data.get(field) || '').trim();
			if (value) {
				payloadBase.append(field, value);
			}
		}

		const title = String(data.get('title') || '').trim();
		if (selectedItems.length === 1 && title) {
			payloadBase.append('title', title);
		}

		isUploading = true;

		if (submitButton instanceof HTMLButtonElement) {
			submitButton.disabled = true;
			submitButton.textContent = status === 'published' ? 'Publicando...' : 'Guardando...';
		}

		for (const button of form.querySelectorAll('button[type="submit"]')) {
			if (button !== submitButton && button instanceof HTMLButtonElement) {
				button.disabled = true;
			}
		}

		renderSelectedList();
		setMessage(`Subiendo ${uploadableItems.length} foto${uploadableItems.length === 1 ? '' : 's'}...`);

		try {
			await runLimitedUploads(uploadableItems, payloadBase);
			const hasErrors = selectedItems.some((item) => item.status === 'error');
			setMessage(
				`${summarizeUpload()}${hasErrors ? '. Podés reintentar las fotos con error.' : '.'}`,
				hasErrors ? 'error' : 'success',
			);
		} finally {
			isUploading = false;
			renderSelectedList();

			for (const button of form.querySelectorAll('button[type="submit"]')) {
				if (button instanceof HTMLButtonElement) {
					button.disabled = false;
				}
			}

			if (submitButton instanceof HTMLButtonElement) {
				submitButton.textContent =
					status === 'published' ? 'Publicar' : 'Guardar borrador';
			}
		}
	}

	function handleFiles(files) {
		if (!files.length) return;

		addFiles(Array.from(files));

		if (fileInput instanceof HTMLInputElement) {
			fileInput.value = '';
		}
	}

	requireAdminSession().then((isValid) => {
		if (isValid) {
			loadCategories();
		}
	});

	logoutButton?.addEventListener('click', () => {
		pb.authStore.clear();
		window.location.href = '/admin/login';
	});

	fileButton?.addEventListener('click', () => {
		if (fileInput instanceof HTMLInputElement) {
			fileInput.click();
		}
	});

	fileInput?.addEventListener('change', () => {
		if (!(fileInput instanceof HTMLInputElement)) return;

		handleFiles(fileInput.files || []);
	});

	dropzone?.addEventListener('dragover', (event) => {
		event.preventDefault();
		dropzone.classList.add('is-dragging');
	});

	dropzone?.addEventListener('dragleave', () => {
		dropzone.classList.remove('is-dragging');
	});

	dropzone?.addEventListener('drop', (event) => {
		event.preventDefault();
		dropzone.classList.remove('is-dragging');

		handleFiles(event.dataTransfer?.files || []);
	});

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();

		const submitter = event.submitter;
		const status =
			submitter instanceof HTMLButtonElement && submitter.value === 'published'
				? 'published'
				: 'draft';

		await createPhotos(status, submitter);
	});

	window.addEventListener('beforeunload', clearSelectedItems);
</script>

<style>
	.admin-shell {
		min-height: 100vh;
		padding: 28px;
		background: #10100f;
		color: #f5f5f5;
	}

	.admin-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
		max-width: 1180px;
		margin: 0 auto 48px;
	}

	.brand {
		display: inline-block;
		margin-bottom: 8px;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.18em;
	}

	.admin-header p,
	.eyebrow {
		margin: 0;
		color: rgba(245, 245, 245, 0.58);
		font-size: 0.78rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.workspace {
		max-width: 1180px;
		margin: 0 auto;
	}

	.section-heading {
		margin-bottom: 28px;
	}

	h1 {
		margin: 8px 0 0;
		font-size: clamp(2rem, 4vw, 4.2rem);
		font-weight: 500;
		line-height: 1;
	}

	form {
		display: grid;
		gap: 24px;
	}

	.form-grid {
		display: grid;
		grid-template-columns: minmax(280px, 0.85fr) minmax(320px, 1fr);
		gap: 24px;
	}

	.dropzone,
	.fields {
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 8px;
		background: #171716;
	}

	.dropzone {
		display: flex;
		flex-direction: column;
		gap: 18px;
		padding: 18px;
	}

	.dropzone.is-dragging {
		border-color: rgba(255, 255, 255, 0.56);
		background: #20201f;
	}

	.dropzone input {
		position: absolute;
		width: 1px;
		height: 1px;
		opacity: 0;
		pointer-events: none;
	}

	.preview {
		display: grid;
		place-items: center;
		min-height: 420px;
		border: 1px dashed rgba(255, 255, 255, 0.22);
		border-radius: 6px;
		padding: 18px;
		color: rgba(245, 245, 245, 0.58);
		text-align: center;
	}

	.preview-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 8px;
		width: 100%;
	}

	.preview-grid img {
		width: 100%;
		aspect-ratio: 1;
		border-radius: 5px;
		object-fit: cover;
	}

	.preview span {
		margin-top: 12px;
		font-size: 0.88rem;
		line-height: 1.45;
	}

	.selected-list {
		display: grid;
		gap: 10px;
		max-height: 360px;
		margin: 0;
		padding: 0;
		overflow: auto;
		list-style: none;
	}

	.selected-item {
		display: grid;
		grid-template-columns: 58px minmax(0, 1fr) auto;
		align-items: center;
		gap: 12px;
		padding: 10px;
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 6px;
		background: rgba(255, 255, 255, 0.04);
	}

	.selected-item[data-status="success"] {
		border-color: rgba(184, 231, 201, 0.38);
	}

	.selected-item[data-status="error"] {
		border-color: rgba(255, 180, 169, 0.42);
	}

	.selected-item > img {
		width: 58px;
		aspect-ratio: 1;
		border-radius: 5px;
		object-fit: cover;
	}

	.selected-details {
		display: grid;
		min-width: 0;
		gap: 5px;
	}

	.selected-details strong,
	.selected-details span {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.selected-details strong {
		color: #f5f5f5;
		font-size: 0.9rem;
		font-weight: 600;
	}

	.selected-details span {
		color: rgba(245, 245, 245, 0.62);
		font-size: 0.78rem;
	}

	.selected-details .item-error {
		color: #ffb4a9;
		white-space: normal;
	}

	progress {
		width: 100%;
		height: 5px;
		accent-color: #f5f5f5;
	}

	.fields {
		display: grid;
		gap: 18px;
		padding: 24px;
	}

	label {
		display: grid;
		gap: 8px;
		color: rgba(245, 245, 245, 0.72);
		font-size: 0.9rem;
	}

	input,
	textarea,
	select {
		width: 100%;
		border: 1px solid rgba(255, 255, 255, 0.14);
		border-radius: 6px;
		padding: 12px 14px;
		color: #f5f5f5;
		background: rgba(255, 255, 255, 0.06);
		outline: none;
	}

	textarea {
		resize: vertical;
	}

	input:focus,
	textarea:focus,
	select:focus {
		border-color: rgba(255, 255, 255, 0.52);
	}

	button {
		border-radius: 6px;
		padding: 12px 16px;
		color: #101010;
		background: #f5f5f5;
		cursor: pointer;
	}

	button:disabled {
		cursor: wait;
		opacity: 0.68;
	}

	.secondary-button,
	#logout-button,
	.remove-button {
		border: 1px solid rgba(255, 255, 255, 0.18);
		color: #f5f5f5;
		background: transparent;
	}

	.remove-button {
		padding: 9px 10px;
		font-size: 0.78rem;
	}

	.actions {
		display: flex;
		justify-content: flex-end;
		gap: 12px;
	}

	.message {
		min-height: 1.5em;
		margin: 18px 0 0;
		color: rgba(245, 245, 245, 0.72);
		font-size: 0.95rem;
		line-height: 1.5;
	}

	.message[data-type="error"] {
		color: #ffb4a9;
	}

	.message[data-type="success"] {
		color: #b8e7c9;
	}

	@media (max-width: 820px) {
		.admin-shell {
			padding: 20px;
		}

		.admin-header {
			margin-bottom: 36px;
		}

		.form-grid {
			grid-template-columns: 1fr;
		}

		.preview {
			min-height: 280px;
		}
	}

	@media (max-width: 540px) {
		.admin-header,
		.actions {
			align-items: stretch;
			flex-direction: column;
		}

		.actions button,
		#logout-button {
			width: 100%;
		}

