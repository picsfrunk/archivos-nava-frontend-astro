---
import AdminShell from '../../../components/AdminShell.astro';
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Nueva carga | ARCHIVOS NAVA" description="Carga de fotografías.">
	<AdminShell title="Crear fotografías" active="new">
		<form id="photo-form" novalidate>
			<div class="form-grid">
				<section class="dropzone" id="dropzone">
					<input id="file" name="file" type="file" accept="image/*" multiple required />
					<div id="preview" class="preview" aria-live="polite">
						<span>Arrastrá imágenes o seleccioná archivos</span>
					</div>
					<button class="secondary-button" type="button" id="file-button">
						Seleccionar imágenes
					</button>
					<ul id="selected-list" class="selected-list" aria-live="polite"></ul>
				</section>

				<section class="fields">
					<label>
						<span>Categoría</span>
						<select id="category" name="category" required>
							<option value="">Cargando categorías...</option>
						</select>
					</label>
					<label>
						<span>Título individual</span>
						<input id="title" name="title" type="text" autocomplete="off" />
					</label>
					<label>
						<span>Año</span>
						<input id="year" name="year" type="number" inputmode="numeric" />
					</label>
					<label>
						<span>Epígrafe</span>
						<input id="caption" name="caption" type="text" autocomplete="off" />
					</label>
					<label>
						<span>Descripción</span>
						<textarea id="description" name="description" rows="5"></textarea>
					</label>
				</section>
			</div>

			<div class="actions">
				<button type="submit" name="status" value="draft">Guardar borrador</button>
				<button type="submit" name="status" value="published">Publicar</button>
			</div>
		</form>

		<p id="admin-message" class="message" role="status" aria-live="polite"></p>
	</AdminShell>
</Layout>

<script>
	import { loadActiveCategories, redirectToLogin, requireAdminSession, resolveError } from '../../../lib/admin';
	import { pb, pocketbaseUrl } from '../../../lib/pocketbase';

	const form = document.querySelector('#photo-form');
	const fileInput = document.querySelector('#file');
	const fileButton = document.querySelector('#file-button');
	const dropzone = document.querySelector('#dropzone');
	const preview = document.querySelector('#preview');
	const selectedList = document.querySelector('#selected-list');
	const categorySelect = document.querySelector('#category');
	const titleInput = document.querySelector('#title');
	const message = document.querySelector('#admin-message');
	const maxImageBytes = 10 * 1024 * 1024;
	const uploadConcurrency = 3;

	let selectedItems = [];
	let nextItemId = 1;
	let isUploading = false;

	function setMessage(text, type = 'neutral') {
		if (!(message instanceof HTMLElement)) return;
		message.textContent = text;
		message.dataset.type = type;
	}

	function formatFileSize(bytes) {
		return bytes >= 1024 * 1024
			? `${(bytes / 1024 / 1024).toFixed(1)} MB`
			: `${Math.max(1, Math.round(bytes / 1024))} KB`;
	}

	function getStatusLabel(status) {
		return {
			pending: 'Pendiente',
			uploading: 'Subiendo',
			success: 'OK',
			error: 'Error',
		}[status] || status;
	}

	function refreshPreview() {
		if (!(preview instanceof HTMLElement)) return;
		if (selectedItems.length === 0) {
			preview.innerHTML = '<span>Arrastrá imágenes o seleccioná archivos</span>';
			return;
		}

		preview.innerHTML = '';
		const grid = document.createElement('div');
		grid.className = 'preview-grid';

		for (const item of selectedItems.slice(0, 6)) {
			const image = document.createElement('img');
			image.src = item.previewUrl;
			image.alt = item.file.name;
			grid.append(image);
		}

		const meta = document.createElement('span');
		const extraCount = selectedItems.length > 6 ? `, ${selectedItems.length - 6} más` : '';
		meta.textContent = `${selectedItems.length} foto${selectedItems.length === 1 ? '' : 's'} seleccionada${selectedItems.length === 1 ? '' : 's'}${extraCount}`;
		preview.append(grid, meta);
	}

	function renderSelectedList() {
		if (!(selectedList instanceof HTMLElement)) return;
		selectedList.innerHTML = '';

		for (const item of selectedItems) {
			const row = document.createElement('li');
			row.className = 'selected-item';
			row.dataset.status = item.status;

			const image = document.createElement('img');
			image.src = item.previewUrl;
			image.alt = item.file.name;

			const details = document.createElement('div');
			details.className = 'selected-details';

			const name = document.createElement('strong');
			name.textContent = item.file.name;

			const meta = document.createElement('span');
			meta.textContent = `${formatFileSize(item.file.size)} - ${getStatusLabel(item.status)}`;

			const progress = document.createElement('progress');
			progress.max = 100;
			progress.value = item.status === 'success' ? 100 : item.status === 'uploading' ? item.progress : 0;

			details.append(name, meta, progress);

			if (item.error) {
				const error = document.createElement('span');
				error.className = 'item-error';
				error.textContent = item.error;
				details.append(error);
			}

			const actionGroup = document.createElement('div');
			actionGroup.className = 'item-actions';

			if (item.status === 'error') {
				const retryButton = document.createElement('button');
				retryButton.type = 'button';
				retryButton.className = 'retry-button';
				retryButton.textContent = 'Reintentar';
				retryButton.disabled = isUploading;
				retryButton.addEventListener('click', () => retryItem(item.id));
				actionGroup.append(retryButton);
			}

			const removeButton = document.createElement('button');
			removeButton.type = 'button';
			removeButton.className = 'remove-button';
			removeButton.textContent = 'Quitar';
			removeButton.disabled = isUploading || item.status === 'uploading';
			removeButton.addEventListener('click', () => removeSelectedItem(item.id));
			actionGroup.append(removeButton);

			row.append(image, details, actionGroup);
			selectedList.append(row);
		}
	}

	function renderSelection() {
		refreshPreview();
		renderSelectedList();
		if (titleInput instanceof HTMLInputElement) titleInput.disabled = selectedItems.length > 1;
	}

	function clearSelectedItems() {
		for (const item of selectedItems) URL.revokeObjectURL(item.previewUrl);
		selectedItems = [];
		renderSelection();
	}

	function removeSelectedItem(id) {
		const item = selectedItems.find((selectedItem) => selectedItem.id === id);
		if (item) URL.revokeObjectURL(item.previewUrl);
		selectedItems = selectedItems.filter((selectedItem) => selectedItem.id !== id);
		renderSelection();
	}

	function updateSelectedItem(id, updates) {
		selectedItems = selectedItems.map((item) => item.id === id ? { ...item, ...updates } : item);
		renderSelectedList();
	}

	async function loadCategories() {
		if (!(categorySelect instanceof HTMLSelectElement)) return;

		try {
			const categories = await loadActiveCategories();
			categorySelect.innerHTML = '';

			const placeholder = document.createElement('option');
			placeholder.value = '';
			placeholder.textContent = categories.length ? 'Seleccioná una categoría' : 'No hay categorías activas';
			categorySelect.append(placeholder);

			for (const category of categories) {
				const option = document.createElement('option');
				option.value = category.id;
				option.textContent = category.name || category.slug || category.id;
				categorySelect.append(option);
			}

			categorySelect.disabled = categories.length === 0;
		} catch {
			categorySelect.innerHTML = '<option value="">No se pudieron cargar categorías</option>';
			categorySelect.disabled = true;
			setMessage('No se pudieron cargar las categorías activas.', 'error');
		}
	}

	function validateImageFile(file) {
		if (!file.type.startsWith('image/')) return 'no parece ser una imagen';
		if (file.size > maxImageBytes) return 'supera el límite de 10 MB';
		return '';
	}

	function addFiles(files) {
		const accepted = [];
		const rejected = [];

		for (const file of files) {
			const validationError = validateImageFile(file);
			if (validationError) {
				rejected.push(`${file.name}: ${validationError}`);
				continue;
			}

			accepted.push({
				id: nextItemId++,
				file,
				previewUrl: URL.createObjectURL(file),
				status: 'pending',
				progress: 0,
				error: '',
			});
		}

		selectedItems = [...selectedItems, ...accepted];
		renderSelection();

		if (rejected.length && accepted.length) setMessage(`Algunas fotos no se agregaron: ${rejected.join('; ')}.`, 'error');
		else if (rejected.length) setMessage(`No se agregaron fotos: ${rejected.join('; ')}.`, 'error');
		else if (accepted.length) setMessage('');
	}

	function uploadPhoto(item, payloadBase) {
		return new Promise((resolve, reject) => {
			const payload = new FormData();
			payload.append('file', item.file);
			for (const [key, value] of payloadBase.entries()) payload.append(key, value);

			const request = new XMLHttpRequest();
			request.open('POST', `${pocketbaseUrl}/api/archivos-nava/photos`);
			request.setRequestHeader('Authorization', `Bearer ${pb.authStore.token}`);

			request.upload.addEventListener('progress', (event) => {
				if (!event.lengthComputable) return;
				updateSelectedItem(item.id, { progress: Math.round((event.loaded / event.total) * 100) });
			});

			request.addEventListener('load', () => {
				let result = {};
				try {
					result = JSON.parse(request.responseText || '{}');
				} catch {
					result = {};
				}

				if (request.status === 401 || request.status === 403) {
					reject({ authError: true });
					return;
				}

				if (request.status < 200 || request.status >= 300 || result.success === false) {
					reject(result);
					return;
				}

				resolve(result);
			});

			request.addEventListener('error', () => reject(new Error('No se pudo conectar con el servidor.')));
			request.send(payload);
		});
	}

	async function runLimitedUploads(items, payloadBase) {
		let cursor = 0;
		let authError = false;

		async function worker() {
			while (cursor < items.length && !authError) {
				const item = items[cursor++];
				updateSelectedItem(item.id, { status: 'uploading', progress: 0, error: '' });

				try {
					await uploadPhoto(item, payloadBase);
					updateSelectedItem(item.id, { status: 'success', progress: 100, error: '' });
				} catch (error) {
					if (error?.authError) {
						authError = true;
						redirectToLogin();
						return;
					}

					updateSelectedItem(item.id, { status: 'error', progress: 0, error: resolveError(error) });
				}
			}
		}

		await Promise.all(Array.from({ length: Math.min(uploadConcurrency, items.length) }, () => worker()));
	}

	function summarizeUpload() {
		const successCount = selectedItems.filter((item) => item.status === 'success').length;
		const errorCount = selectedItems.filter((item) => item.status === 'error').length;
		const pendingCount = selectedItems.filter((item) => item.status === 'pending').length;
		const parts = [];

		if (successCount) parts.push(`${successCount} subida${successCount === 1 ? '' : 's'} correctamente`);
		if (errorCount) parts.push(`${errorCount} con error`);
		if (pendingCount) parts.push(`${pendingCount} pendiente${pendingCount === 1 ? '' : 's'}`);
		return parts.join('; ') || 'No hubo cambios.';
	}

	function buildPayloadBase(status = 'draft') {
		if (!(form instanceof HTMLFormElement)) return null;

		const data = new FormData(form);
		const category = String(data.get('category') || '').trim();
		if (!category) return null;

		const payloadBase = new FormData();
		payloadBase.append('category', category);
		payloadBase.append('status', status);

		for (const field of ['year', 'caption', 'description']) {
			const value = String(data.get(field) || '').trim();
			if (value) payloadBase.append(field, value);
		}

		const title = String(data.get('title') || '').trim();
		if (selectedItems.length === 1 && title) payloadBase.append('title', title);

		return payloadBase;
	}

	async function retryItem(id) {
		if (isUploading) return;
		const item = selectedItems.find((selectedItem) => selectedItem.id === id);
		if (!item || item.status !== 'error') return;

		const payloadBase = buildPayloadBase('draft');
		if (!payloadBase) {
			setMessage('Seleccioná una categoría antes de reintentar la subida.', 'error');
			return;
		}

		isUploading = true;
		renderSelectedList();
		setMessage(`Reintentando subida de "${item.file.name}"...`);

		try {
			await runLimitedUploads([item], payloadBase);
			const hasErrors = selectedItems.some((it) => it.status === 'error');
			setMessage(`${summarizeUpload()}${hasErrors ? '. Podés reintentar las fotos con error.' : '.'}`, hasErrors ? 'error' : 'success');
		} finally {
			isUploading = false;
			renderSelectedList();
		}
	}

	async function createPhotos(status, submitButton) {
		if (!(form instanceof HTMLFormElement)) return;

		const data = new FormData(form);
		const category = String(data.get('category') || '').trim();
		const uploadableItems = selectedItems.filter((item) => item.status === 'pending' || item.status === 'error');

		if (!selectedItems.length) {
			setMessage('Seleccioná una o más imágenes antes de guardar.', 'error');
			return;
		}

		if (!uploadableItems.length) {
			setMessage('No quedan fotos pendientes para subir.', 'success');
			return;
		}

		const payloadBase = buildPayloadBase(status);
		if (!payloadBase) {
			setMessage('Seleccioná una categoría.', 'error');
			return;
		}

		isUploading = true;
		if (submitButton instanceof HTMLButtonElement) {
			submitButton.disabled = true;
			submitButton.textContent = status === 'published' ? 'Publicando...' : 'Guardando...';
		}

		for (const button of form.querySelectorAll('button[type="submit"]')) {
			if (button !== submitButton && button instanceof HTMLButtonElement) button.disabled = true;
		}

		renderSelectedList();
		setMessage(`Subiendo ${uploadableItems.length} foto${uploadableItems.length === 1 ? '' : 's'}...`);

		try {
			await runLimitedUploads(uploadableItems, payloadBase);
			const hasErrors = selectedItems.some((item) => item.status === 'error');
			setMessage(`${summarizeUpload()}${hasErrors ? '. Podés reintentar las fotos con error.' : '.'}`, hasErrors ? 'error' : 'success');
		} finally {
			isUploading = false;
			renderSelectedList();

			for (const button of form.querySelectorAll('button[type="submit"]')) {
				if (button instanceof HTMLButtonElement) button.disabled = false;
			}

			if (submitButton instanceof HTMLButtonElement) {
				submitButton.textContent = status === 'published' ? 'Publicar' : 'Guardar borrador';
			}
		}
	}

	function handleFiles(files) {
		if (!files.length) return;
		addFiles(Array.from(files));
		if (fileInput instanceof HTMLInputElement) fileInput.value = '';
	}

	requireAdminSession().then((isValid) => {
		if (isValid) loadCategories();
	});

	fileButton?.addEventListener('click', () => {
		if (fileInput instanceof HTMLInputElement) fileInput.click();
	});

	fileInput?.addEventListener('change', () => {
		if (fileInput instanceof HTMLInputElement) handleFiles(fileInput.files || []);
	});

	dropzone?.addEventListener('dragover', (event) => {
		event.preventDefault();
		dropzone.classList.add('is-dragging');
	});

	dropzone?.addEventListener('dragleave', () => dropzone.classList.remove('is-dragging'));

	dropzone?.addEventListener('drop', (event) => {
		event.preventDefault();
		dropzone.classList.remove('is-dragging');
		handleFiles(event.dataTransfer?.files || []);
	});

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		const submitter = event.submitter;
		const status = submitter instanceof HTMLButtonElement && submitter.value === 'published' ? 'published' : 'draft';
		await createPhotos(status, submitter);
	});

	window.addEventListener('beforeunload', clearSelectedItems);
</script>

<style>
	form {
		display: grid;
		gap: 24px;
	}

	.form-grid {
		display: grid;
		grid-template-columns: minmax(280px, 0.85fr) minmax(320px, 1fr);
		gap: 24px;
	}

	.dropzone,
	.fields {
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 8px;
		background: #171716;
	}

	.dropzone {
		display: flex;
		flex-direction: column;
		gap: 18px;
		padding: 18px;
	}

	.dropzone.is-dragging {
		border-color: rgba(255, 255, 255, 0.56);
		background: #20201f;
	}

	.dropzone input {
		position: absolute;
		width: 1px;
		height: 1px;
		opacity: 0;
		pointer-events: none;
	}

	.preview {
		display: grid;
		place-items: center;
		min-height: 420px;
		border: 1px dashed rgba(255, 255, 255, 0.22);
		border-radius: 6px;
		padding: 18px;
		color: rgba(245, 245, 245, 0.58);
		text-align: center;
	}

	:global(.preview-grid) {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(82px, 1fr));
		grid-auto-rows: 96px;
		gap: 8px;
		width: 100%;
	}

	:global(.preview-grid img) {
		width: 100%;
		height: 100%;
		border-radius: 5px;
		object-fit: cover;
	}

	:global(.preview span) {
		margin-top: 12px;
		font-size: 0.88rem;
		line-height: 1.45;
	}

	.selected-list {
		display: grid;
		gap: 10px;
		max-height: 360px;
		margin: 0;
		padding: 0;
		overflow: auto;
		list-style: none;
	}

	:global(.selected-item) {
		display: grid;
		grid-template-columns: 58px minmax(0, 1fr) auto;
		align-items: center;
		gap: 12px;
		padding: 10px;
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 6px;
		background: rgba(255, 255, 255, 0.04);
	}

	:global(.selected-item[data-status="success"]) {
		border-color: rgba(184, 231, 201, 0.38);
	}

	:global(.selected-item[data-status="error"]) {
		border-color: rgba(255, 180, 169, 0.42);
	}

	:global(.selected-item > img) {
		width: 58px;
		height: 58px;
		border-radius: 5px;
		object-fit: cover;
	}

	:global(.selected-details) {
		display: grid;
		min-width: 0;
		gap: 5px;
	}

	:global(.selected-details strong),
	:global(.selected-details span) {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	:global(.selected-details strong) {
		color: #f5f5f5;
		font-size: 0.9rem;
		font-weight: 600;
	}

	:global(.selected-details span) {
		color: rgba(245, 245, 245, 0.62);
		font-size: 0.78rem;
	}

	:global(.selected-details .item-error) {
		color: #ffb4a9;
		white-space: normal;
	}

	:global(progress) {
		width: 100%;
		height: 5px;
		accent-color: #f5f5f5;
	}

	.fields {
		display: grid;
		gap: 18px;
		padding: 24px;
	}

	.actions {
		display: flex;
		justify-content: flex-end;
		gap: 12px;
	}

	:global(.item-actions) {
		display: flex;
		align-items: center;
		gap: 6px;
	}

	:global(.retry-button) {
		border: 1px solid rgba(230, 213, 184, 0.4);
		padding: 9px 10px;
		color: #e6d5b8;
		background: rgba(230, 213, 184, 0.08);
		font-size: 0.78rem;
		border-radius: 4px;
		cursor: pointer;
	}

	:global(.retry-button:hover:not(:disabled)) {
		background: rgba(230, 213, 184, 0.16);
	}

	:global(.remove-button) {
		border: 1px solid rgba(255, 255, 255, 0.18);
		padding: 9px 10px;
		color: #f5f5f5;
		background: transparent;
		font-size: 0.78rem;
	}

	@media (max-width: 820px) {
		.form-grid {
			grid-template-columns: 1fr;
		}

		.preview {
			min-height: 280px;
		}
	}

	@media (max-width: 540px) {
		.actions {
			align-items: stretch;
			flex-direction: column;
		}

		.actions button {
			width: 100%;
		}

		:global(.selected-item) {
			grid-template-columns: 48px minmax(0, 1fr);
		}

		:global(.selected-item > img) {
			width: 48px;
			height: 48px;
		}

		:global(.item-actions) {
			grid-column: 1 / -1;
			justify-content: flex-end;
		}

		:global(.remove-button),
		:global(.retry-button) {
			width: auto;
		}
	}
</style>
