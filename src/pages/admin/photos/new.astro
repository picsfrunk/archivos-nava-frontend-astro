---
import AdminShell from '../../../components/AdminShell.astro';
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Nueva carga | ARCHIVOS NAVA" description="Carga de fotografías.">
	<AdminShell title="Crear fotografías" active="new">
		<form id="photo-form" novalidate>
			<div class="form-grid">
				<section class="dropzone-panel">
					<div class="panel-header">
						<h2>Fotografías a subir</h2>
						<p class="panel-subtitle">
							Cada fotografía tiene su propia vista previa amplia para identificarla y asignarle título fácilmente.
						</p>
					</div>

					<!-- Dropzone: spacious when empty, compact bar when photos are selected -->
					<div class="dropzone" id="dropzone" tabindex="0" role="region" aria-label="Zona para arrastrar fotos o hacer clic para seleccionarlas">
						<input id="file" name="file" type="file" accept="image/*" multiple required />
						<div id="preview" class="preview" aria-live="polite">
							<div class="preview-empty">
								<svg class="upload-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
									<polyline points="17 8 12 3 7 8" />
									<line x1="12" y1="3" x2="12" y2="15" />
								</svg>
								<strong class="dropzone-title">Arrastrá fotos acá o hacé clic para buscar</strong>
								<span class="dropzone-hint">Formatos: JPG, PNG, WebP o AVIF (hasta 10 MB por foto)</span>
							</div>
						</div>
						<button class="secondary-button" type="button" id="file-button">
							Seleccionar imágenes
						</button>
					</div>

					<div id="selection-toolbar" class="selection-toolbar" hidden>
						<span id="selection-summary" class="selection-summary" role="status"></span>
						<div class="toolbar-actions">
							<button type="button" class="text-button" id="add-more-button">
								+ Agregar más fotos
							</button>
							<button type="button" class="text-button danger-text" id="clear-all-button">
								Quitar todas
							</button>
						</div>
					</div>

					<!-- Visual Photo Cards Editor List -->
					<ul id="selected-list" class="selected-list" aria-live="polite"></ul>
				</section>

				<section class="fields-panel">
					<div class="panel-header">
						<h2 id="fields-heading">Información de las fotos</h2>
						<p id="fields-subtitle" class="panel-subtitle">
							Completá los datos comunes. Podés guardarlas como borrador para revisarlas luego.
						</p>
					</div>

					<div class="fields-content">
						<label class="form-field required-field">
							<span class="field-label">Categoría <span class="required-mark" aria-hidden="true">*</span></span>
							<select id="category" name="category" required>
								<option value="">Cargando categorías...</option>
							</select>
							<span class="field-help">Obligatoria. Determina la sección del archivo donde se ubicarán las fotos.</span>
						</label>

						<div class="title-field-group">
							<label class="form-field" for="title">
								<span id="title-label-text" class="field-label">Título individual</span>
								<input id="title" name="title" type="text" autocomplete="off" />
								<span id="title-help" class="field-help">Dejá en blanco si la foto no lleva título.</span>
							</label>
							<button type="button" id="apply-title-button" class="secondary-button apply-title-btn" hidden>
								Aplicar este título a todas las fotos seleccionadas
							</button>
						</div>

						<label class="form-field">
							<span class="field-label">Año</span>
							<input id="year" name="year" type="number" inputmode="numeric" placeholder="Ej: 1982" />
							<span class="field-help">Año aproximado o exacto. Dejá en blanco si no se conoce.</span>
						</label>

						<label class="form-field">
							<span class="field-label">Epígrafe o pie de foto</span>
							<input id="caption" name="caption" type="text" autocomplete="off" placeholder="Ej: Teatro San Martín, Buenos Aires" />
							<span class="field-help">Ubicación, evento o subtítulo breve (opcional).</span>
						</label>

						<label class="form-field">
							<span class="field-label">Descripción</span>
							<textarea id="description" name="description" rows="5" placeholder="Detalles, personas que aparecen, contexto histórico o anécdotas..."></textarea>
							<span class="field-help">Información histórica complementaria (opcional).</span>
						</label>
					</div>
				</section>
			</div>

			<div class="actions-card">
				<div class="actions-info">
					<span class="actions-hint" id="actions-hint">
						Elegí <strong>Publicar</strong> para que las fotos sean visibles inmediatamente en el archivo público, o <strong>Guardar borrador</strong> para revisarlas antes.
					</span>
				</div>
				<div class="actions">
					<button type="submit" name="status" value="draft" class="secondary-button action-draft-btn">
						Guardar borrador
					</button>
					<button type="submit" name="status" value="published" class="primary-button action-publish-btn">
						Publicar
					</button>
				</div>
			</div>
		</form>

		<div id="admin-message-banner" class="message-banner" hidden>
			<p id="admin-message" class="message" role="status" aria-live="polite"></p>
			<div id="message-actions" class="message-actions" hidden>
				<a href="/admin/photos" class="view-photos-link">Ver fotos en el archivo →</a>
				<button type="button" id="upload-more-button" class="upload-more-btn">Subir más fotos</button>
			</div>
		</div>

		<!-- Dialog for high-resolution visual inspection -->
		<dialog id="inspect-modal" class="inspect-dialog" aria-label="Vista ampliada de fotografía">
			<div class="inspect-dialog-content">
				<div class="inspect-header">
					<span id="inspect-title" class="inspect-title">Vista previa ampliada</span>
					<button type="button" id="close-inspect-button" class="close-inspect-btn" aria-label="Cerrar vista ampliada">✕ Cerrar</button>
				</div>
				<div class="inspect-image-wrap">
					<img id="inspect-image" src="" alt="Vista previa en alta resolución" />
				</div>
			</div>
		</dialog>
	</AdminShell>
</Layout>

<script>
	import { loadActiveCategories, redirectToLogin, requireAdminSession, resolveError } from '../../../lib/admin';
	import { pb, pocketbaseUrl } from '../../../lib/pocketbase';

	interface SelectedItem {
		id: number;
		file: File;
		previewUrl: string;
		title: string;
		status: 'pending' | 'uploading' | 'success' | 'error';
		progress: number;
		error: string;
	}

	const form = document.querySelector('#photo-form') as HTMLFormElement | null;
	const fileInput = document.querySelector('#file') as HTMLInputElement | null;
	const fileButton = document.querySelector('#file-button') as HTMLButtonElement | null;
	const addMoreButton = document.querySelector('#add-more-button') as HTMLButtonElement | null;
	const clearAllButton = document.querySelector('#clear-all-button') as HTMLButtonElement | null;
	const selectionToolbar = document.querySelector('#selection-toolbar') as HTMLElement | null;
	const selectionSummary = document.querySelector('#selection-summary') as HTMLElement | null;
	const dropzone = document.querySelector('#dropzone') as HTMLElement | null;
	const preview = document.querySelector('#preview') as HTMLElement | null;
	const selectedList = document.querySelector('#selected-list') as HTMLElement | null;
	const categorySelect = document.querySelector('#category') as HTMLSelectElement | null;
	const titleInput = document.querySelector('#title') as HTMLInputElement | null;
	const titleLabelText = document.querySelector('#title-label-text') as HTMLElement | null;
	const titleHelp = document.querySelector('#title-help') as HTMLElement | null;
	const applyTitleButton = document.querySelector('#apply-title-button') as HTMLButtonElement | null;
	const fieldsHeading = document.querySelector('#fields-heading') as HTMLElement | null;
	const fieldsSubtitle = document.querySelector('#fields-subtitle') as HTMLElement | null;
	const message = document.querySelector('#admin-message') as HTMLElement | null;
	const messageBanner = document.querySelector('#admin-message-banner') as HTMLElement | null;
	const messageActions = document.querySelector('#message-actions') as HTMLElement | null;
	const uploadMoreButton = document.querySelector('#upload-more-button') as HTMLButtonElement | null;

	// Inspection Dialog
	const inspectModal = document.querySelector('#inspect-modal') as HTMLDialogElement | null;
	const inspectImage = document.querySelector('#inspect-image') as HTMLImageElement | null;
	const inspectTitle = document.querySelector('#inspect-title') as HTMLElement | null;
	const closeInspectButton = document.querySelector('#close-inspect-button') as HTMLButtonElement | null;

	const maxImageBytes = 10 * 1024 * 1024;
	const uploadConcurrency = 3;

	let selectedItems: SelectedItem[] = [];
	let nextItemId = 1;
	let isUploading = false;

	function setMessage(text: string, type: 'neutral' | 'success' | 'error' = 'neutral') {
		if (!(message instanceof HTMLElement) || !(messageBanner instanceof HTMLElement)) return;
		message.textContent = text;
		message.dataset.type = type;
		messageBanner.hidden = !text;
		messageBanner.dataset.type = type;
	}

	function formatFileSize(bytes: number): string {
		return bytes >= 1024 * 1024
			? `${(bytes / 1024 / 1024).toFixed(1)} MB`
			: `${Math.max(1, Math.round(bytes / 1024))} KB`;
	}

	function cleanInitialTitle(fileName: string): string {
		if (!fileName) return '';
		const withoutExt = fileName.replace(/\.[^/.]+$/, '');
		const cleaned = withoutExt.replace(/[_-]+/g, ' ').replace(/\s+/g, ' ').trim();
		if (!cleaned) return '';
		return cleaned.charAt(0).toUpperCase() + cleaned.slice(1);
	}

	function getStatusLabel(status: SelectedItem['status']): string {
		const labels: Record<SelectedItem['status'], string> = {
			pending: 'Listo para subir',
			uploading: 'Subiendo…',
			success: 'Subida con éxito',
			error: 'Error',
		};
		return labels[status] || status;
	}

	function openInspectModal(item: SelectedItem) {
		if (!inspectModal || !inspectImage) return;
		inspectImage.src = item.previewUrl;
		if (inspectTitle) {
			inspectTitle.textContent = item.title || item.file.name;
		}
		if (typeof inspectModal.showModal === 'function') {
			inspectModal.showModal();
		}
	}

	closeInspectButton?.addEventListener('click', () => {
		inspectModal?.close();
	});

	inspectModal?.addEventListener('click', (event) => {
		if (event.target === inspectModal) {
			inspectModal.close();
		}
	});

	function refreshPreview() {
		if (!(preview instanceof HTMLElement) || !(dropzone instanceof HTMLElement)) return;

		// 1. When empty: Show welcoming full dropzone
		if (selectedItems.length === 0) {
			dropzone.classList.remove('is-compact');
			if (fileButton) fileButton.hidden = false;
			preview.innerHTML = `
				<div class="preview-empty">
					<svg class="upload-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
						<polyline points="17 8 12 3 7 8" />
						<line x1="12" y1="3" x2="12" y2="15" />
					</svg>
					<strong class="dropzone-title">Arrastrá fotos acá o hacé clic para buscar</strong>
					<span class="dropzone-hint">Formatos aceptados: JPG, PNG, WebP o AVIF (hasta 10 MB por foto)</span>
				</div>
			`;
			return;
		}

		// 2. When items are loaded: Convert dropzone into a sleek, compact drop bar
		// NO duplicated images here - the real images are prominently shown in selectedList!
		dropzone.classList.add('is-compact');
		if (fileButton) fileButton.hidden = true;
		preview.innerHTML = `
			<div class="preview-compact">
				<svg class="upload-icon-mini" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
					<polyline points="17 8 12 3 7 8" />
					<line x1="12" y1="3" x2="12" y2="15" />
				</svg>
				<div class="compact-text-wrap">
					<strong class="compact-title">+ Arrastrá más fotos acá o hacé clic para sumar</strong>
					<span class="compact-hint">Podés seguir agregando más imágenes a este lote</span>
				</div>
			</div>
		`;
	}

	function renderSelectedList() {
		if (!(selectedList instanceof HTMLElement)) return;
		selectedList.innerHTML = '';

		selectedItems.forEach((item, index) => {
			const card = document.createElement('li');
			card.className = 'selected-item';
			card.dataset.status = item.status;

			// Visual Media Container with large preview
			const mediaWrap = document.createElement('div');
			mediaWrap.className = 'item-media';

			const image = document.createElement('img');
			image.src = item.previewUrl;
			image.alt = item.title || item.file.name;
			image.className = 'item-image';

			const indexBadge = document.createElement('span');
			indexBadge.className = 'item-index-badge';
			indexBadge.textContent = `#${index + 1}`;

			const zoomHint = document.createElement('button');
			zoomHint.type = 'button';
			zoomHint.className = 'item-zoom-btn';
			zoomHint.title = 'Hacé clic para ver la foto en grande';
			zoomHint.innerHTML = `
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<circle cx="11" cy="11" r="8" />
					<line x1="21" y1="21" x2="16.65" y2="16.65" />
					<line x1="11" y1="8" x2="11" y2="14" />
					<line x1="8" y1="11" x2="14" y2="11" />
				</svg>
				<span>Ver grande</span>
			`;
			zoomHint.addEventListener('click', (e) => {
				e.stopPropagation();
				openInspectModal(item);
			});

			mediaWrap.append(image, indexBadge, zoomHint);
			mediaWrap.addEventListener('click', () => openInspectModal(item));

			// Right details container
			const details = document.createElement('div');
			details.className = 'selected-details';

			// Card top header with photo count and remove button
			const cardHeader = document.createElement('div');
			cardHeader.className = 'card-header-row';

			const cardMetaTag = document.createElement('span');
			cardMetaTag.className = 'card-meta-tag';
			cardMetaTag.textContent = `Foto ${index + 1} de ${selectedItems.length}`;

			const removeButton = document.createElement('button');
			removeButton.type = 'button';
			removeButton.className = 'remove-button';
			removeButton.innerHTML = '✕ Quitar';
			removeButton.title = `Quitar "${item.file.name}"`;
			removeButton.disabled = isUploading || item.status === 'uploading';
			removeButton.addEventListener('click', (e) => {
				e.stopPropagation();
				removeSelectedItem(item.id);
			});

			cardHeader.append(cardMetaTag, removeButton);

			// Individual title input section
			const titleContainer = document.createElement('div');
			titleContainer.className = 'item-title-field';

			const titleLabel = document.createElement('label');
			titleLabel.className = 'item-title-label';
			titleLabel.textContent = 'Título de esta foto:';

			const itemTitleInput = document.createElement('input');
			itemTitleInput.type = 'text';
			itemTitleInput.className = 'item-title-input';
			const placeholderSuggestion = cleanInitialTitle(item.file.name);
			itemTitleInput.placeholder = placeholderSuggestion ? `Ej: ${placeholderSuggestion} (opcional)` : 'Título opcional';
			itemTitleInput.value = item.title;
			itemTitleInput.disabled = isUploading;
			itemTitleInput.autocomplete = 'off';

			itemTitleInput.addEventListener('input', () => {
				item.title = itemTitleInput.value;
				if (selectedItems.length === 1 && titleInput instanceof HTMLInputElement) {
					titleInput.value = itemTitleInput.value;
				}
			});

			titleLabel.append(itemTitleInput);
			titleContainer.append(titleLabel);

			// Metadata and status row
			const metaRow = document.createElement('div');
			metaRow.className = 'item-meta-row';

			const filename = document.createElement('span');
			filename.className = 'item-filename';
			filename.textContent = item.file.name;
			filename.title = item.file.name;

			const size = document.createElement('span');
			size.className = 'item-filesize';
			size.textContent = formatFileSize(item.file.size);

			const statusPill = document.createElement('span');
			statusPill.className = 'item-status-pill';
			statusPill.dataset.status = item.status;
			statusPill.textContent = getStatusLabel(item.status);

			metaRow.append(filename, size, statusPill);

			// Progress bar
			const progress = document.createElement('progress');
			progress.max = 100;
			progress.value = item.status === 'success' ? 100 : item.status === 'uploading' ? item.progress : 0;
			if (item.status === 'pending') {
				progress.hidden = true;
			}

			details.append(cardHeader, titleContainer, metaRow, progress);

			// Error message and retry button if applicable
			if (item.error) {
				const errorWrap = document.createElement('div');
				errorWrap.className = 'item-error-row';

				const errorMsg = document.createElement('span');
				errorMsg.className = 'item-error';
				errorMsg.textContent = item.error;
				errorWrap.append(errorMsg);

				if (item.status === 'error') {
					const retryButton = document.createElement('button');
					retryButton.type = 'button';
					retryButton.className = 'retry-button';
					retryButton.textContent = 'Reintentar subida';
					retryButton.disabled = isUploading;
					retryButton.addEventListener('click', () => retryItem(item.id));
					errorWrap.append(retryButton);
				}

				details.append(errorWrap);
			}

			card.append(mediaWrap, details);
			selectedList.append(card);
		});
	}

	function renderSelection() {
		refreshPreview();
		renderSelectedList();

		const count = selectedItems.length;

		if (selectionToolbar instanceof HTMLElement && selectionSummary instanceof HTMLElement) {
			selectionToolbar.hidden = count === 0;
			if (count > 0) {
				selectionSummary.textContent = `${count} fotografía${count === 1 ? '' : 's'} lista${count === 1 ? '' : 's'} para subir`;
			}
		}

		// Update right panel labels dynamically and NEVER disable the title input!
		if (count === 0) {
			if (fieldsHeading) fieldsHeading.textContent = 'Información de las fotos';
			if (fieldsSubtitle) fieldsSubtitle.textContent = 'Completá los datos correspondientes. Podés guardarlas como borrador para revisarlas luego.';
			if (titleLabelText) titleLabelText.textContent = 'Título individual';
			if (titleHelp) titleHelp.textContent = 'Dejá en blanco si la foto no lleva título.';
			if (titleInput instanceof HTMLInputElement) {
				titleInput.disabled = false;
				titleInput.placeholder = '';
			}
			if (applyTitleButton instanceof HTMLElement) applyTitleButton.hidden = true;
		} else if (count === 1) {
			if (fieldsHeading) fieldsHeading.textContent = 'Información de la fotografía';
			if (fieldsSubtitle) fieldsSubtitle.textContent = 'Estos datos se guardarán junto con la foto seleccionada.';
			if (titleLabelText) titleLabelText.textContent = 'Título de la fotografía';
			if (titleHelp) titleHelp.textContent = 'También podés editarlo directamente en la tarjeta de la foto a la izquierda.';
			if (titleInput instanceof HTMLInputElement) {
				titleInput.disabled = false;
				titleInput.placeholder = cleanInitialTitle(selectedItems[0].file.name) || 'Título de la foto';
				titleInput.value = selectedItems[0].title;
			}
			if (applyTitleButton instanceof HTMLElement) applyTitleButton.hidden = true;
		} else {
			if (fieldsHeading) fieldsHeading.textContent = 'Información común para el lote';
			if (fieldsSubtitle) fieldsSubtitle.textContent = 'Estos datos (categoría, año y descripción) se guardarán en todas las fotos seleccionadas.';
			if (titleLabelText) titleLabelText.textContent = 'Título base para todas las fotos (opcional)';
			if (titleHelp) titleHelp.textContent = 'Podés escribir un título acá y hacer clic en "Aplicar", o personalizar el título de cada foto en su tarjeta.';
			if (titleInput instanceof HTMLInputElement) {
				titleInput.disabled = false;
				titleInput.placeholder = 'Ej: Concierto en Obras Sanitarias 1985';
			}
			if (applyTitleButton instanceof HTMLElement) applyTitleButton.hidden = false;
		}
	}

	function clearSelectedItems() {
		for (const item of selectedItems) URL.revokeObjectURL(item.previewUrl);
		selectedItems = [];
		if (fileInput instanceof HTMLInputElement) fileInput.value = '';
		if (messageActions instanceof HTMLElement) messageActions.hidden = true;
		renderSelection();
	}

	function removeSelectedItem(id: number) {
		const item = selectedItems.find((selectedItem) => selectedItem.id === id);
		if (item) URL.revokeObjectURL(item.previewUrl);
		selectedItems = selectedItems.filter((selectedItem) => selectedItem.id !== id);
		renderSelection();
	}

	function updateSelectedItem(id: number, updates: Partial<SelectedItem>) {
		selectedItems = selectedItems.map((item) => (item.id === id ? { ...item, ...updates } : item));
		renderSelectedList();
	}

	async function loadCategories() {
		if (!(categorySelect instanceof HTMLSelectElement)) return;

		try {
			const categories = await loadActiveCategories();
			categorySelect.innerHTML = '';

			const placeholder = document.createElement('option');
			placeholder.value = '';
			placeholder.textContent = categories.length ? 'Seleccioná una categoría' : 'No hay categorías activas';
			categorySelect.append(placeholder);

			for (const category of categories) {
				const option = document.createElement('option');
				option.value = category.id;
				option.textContent = category.name || category.slug || category.id;
				categorySelect.append(option);
			}

			categorySelect.disabled = categories.length === 0;
		} catch {
			categorySelect.innerHTML = '<option value="">No se pudieron cargar categorías</option>';
			categorySelect.disabled = true;
			setMessage('No se pudieron cargar las categorías activas.', 'error');
		}
	}

	function validateImageFile(file: File): string {
		if (!file.type.startsWith('image/')) return 'no es un formato de imagen compatible';
		if (file.size > maxImageBytes) return 'supera el límite de 10 MB';
		return '';
	}

	function addFiles(files: File[]) {
		const accepted: SelectedItem[] = [];
		const rejected: string[] = [];

		for (const file of files) {
			const validationError = validateImageFile(file);
			if (validationError) {
				rejected.push(`${file.name}: ${validationError}`);
				continue;
			}

			accepted.push({
				id: nextItemId++,
				file,
				previewUrl: URL.createObjectURL(file),
				title: '',
				status: 'pending',
				progress: 0,
				error: '',
			});
		}

		selectedItems = [...selectedItems, ...accepted];
		renderSelection();

		if (rejected.length && accepted.length) {
			setMessage(`Algunas fotos no se agregaron: ${rejected.join('; ')}.`, 'error');
		} else if (rejected.length) {
			setMessage(`No se agregaron fotos: ${rejected.join('; ')}.`, 'error');
		} else if (accepted.length) {
			setMessage('');
		}
	}

	function uploadPhoto(item: SelectedItem, payloadBase: FormData): Promise<unknown> {
		return new Promise((resolve, reject) => {
			const payload = new FormData();
			payload.append('file', item.file);

			for (const [key, value] of payloadBase.entries()) {
				if (key !== 'title') payload.append(key, value);
			}

			// Individual title wins, fallback to common payloadBase title if any
			const individualTitle = typeof item.title === 'string' ? item.title.trim() : '';
			const commonTitle = String(payloadBase.get('title') || '').trim();
			const effectiveTitle = individualTitle || commonTitle;

			if (effectiveTitle) {
				payload.append('title', effectiveTitle);
			}

			const request = new XMLHttpRequest();
			request.open('POST', `${pocketbaseUrl}/api/archivos-nava/photos`);
			request.setRequestHeader('Authorization', `Bearer ${pb.authStore.token}`);

			request.upload.addEventListener('progress', (event) => {
				if (!event.lengthComputable) return;
				updateSelectedItem(item.id, { progress: Math.round((event.loaded / event.total) * 100) });
			});

			request.addEventListener('load', () => {
				let result: { success?: boolean } = {};
				try {
					result = JSON.parse(request.responseText || '{}');
				} catch {
					result = {};
				}

				if (request.status === 401 || request.status === 403) {
					reject({ authError: true });
					return;
				}

				if (request.status < 200 || request.status >= 300 || result.success === false) {
					reject(result);
					return;
				}

				resolve(result);
			});

			request.addEventListener('error', () => reject(new Error('No se pudo conectar con el servidor.')));
			request.send(payload);
		});
	}

	async function runLimitedUploads(items: SelectedItem[], payloadBase: FormData) {
		let cursor = 0;
		let authError = false;

		async function worker() {
			while (cursor < items.length && !authError) {
				const item = items[cursor++];
				updateSelectedItem(item.id, { status: 'uploading', progress: 0, error: '' });

				try {
					await uploadPhoto(item, payloadBase);
					updateSelectedItem(item.id, { status: 'success', progress: 100, error: '' });
				} catch (error) {
					if (typeof error === 'object' && error !== null && 'authError' in error) {
						authError = true;
						redirectToLogin();
						return;
					}

					updateSelectedItem(item.id, { status: 'error', progress: 0, error: resolveError(error) });
				}
			}
		}

		await Promise.all(Array.from({ length: Math.min(uploadConcurrency, items.length) }, () => worker()));
	}

	function summarizeUpload(): string {
		const successCount = selectedItems.filter((item) => item.status === 'success').length;
		const errorCount = selectedItems.filter((item) => item.status === 'error').length;
		const pendingCount = selectedItems.filter((item) => item.status === 'pending').length;
		const parts: string[] = [];

		if (successCount) parts.push(`${successCount} subida${successCount === 1 ? '' : 's'} correctamente`);
		if (errorCount) parts.push(`${errorCount} con error`);
		if (pendingCount) parts.push(`${pendingCount} pendiente${pendingCount === 1 ? '' : 's'}`);
		return parts.join('; ') || 'No hubo cambios.';
	}

	function buildPayloadBase(status = 'draft'): FormData | null {
		if (!(form instanceof HTMLFormElement)) return null;

		const data = new FormData(form);
		const category = String(data.get('category') || '').trim();
		if (!category) return null;

		const payloadBase = new FormData();
		payloadBase.append('category', category);
		payloadBase.append('status', status);

		for (const field of ['year', 'caption', 'description']) {
			const value = String(data.get(field) || '').trim();
			if (value) payloadBase.append(field, value);
		}

		const title = String(data.get('title') || '').trim();
		if (title) payloadBase.append('title', title);

		return payloadBase;
	}

	async function retryItem(id: number) {
		if (isUploading) return;
		const item = selectedItems.find((selectedItem) => selectedItem.id === id);
		if (!item || item.status !== 'error') return;

		const payloadBase = buildPayloadBase('draft');
		if (!payloadBase) {
			setMessage('Seleccioná una categoría antes de reintentar la subida.', 'error');
			return;
		}

		isUploading = true;
		renderSelectedList();
		setMessage(`Reintentando subida de "${item.file.name}"...`);

		try {
			await runLimitedUploads([item], payloadBase);
			const hasErrors = selectedItems.some((it) => it.status === 'error');
			setMessage(`${summarizeUpload()}${hasErrors ? '. Podés reintentar las fotos con error.' : '.'}`, hasErrors ? 'error' : 'success');
		} finally {
			isUploading = false;
			renderSelectedList();
		}
	}

	async function createPhotos(status: 'draft' | 'published', submitButton: HTMLButtonElement | null) {
		if (!(form instanceof HTMLFormElement)) return;

		const uploadableItems = selectedItems.filter((item) => item.status === 'pending' || item.status === 'error');

		if (!selectedItems.length) {
			setMessage('Por favor seleccioná al menos una fotografía antes de guardar.', 'error');
			if (dropzone instanceof HTMLElement) {
				dropzone.classList.add('has-validation-error');
				dropzone.scrollIntoView({ behavior: 'smooth', block: 'center' });
			}
			return;
		}

		if (!uploadableItems.length) {
			setMessage('No quedan fotos pendientes para subir.', 'success');
			return;
		}

		const payloadBase = buildPayloadBase(status);
		if (!payloadBase) {
			setMessage('Por favor elegí una categoría para las fotos.', 'error');
			if (categorySelect instanceof HTMLSelectElement) {
				categorySelect.classList.add('has-validation-error');
				categorySelect.focus();
			}
			return;
		}

		if (categorySelect instanceof HTMLSelectElement) {
			categorySelect.classList.remove('has-validation-error');
		}
		if (dropzone instanceof HTMLElement) {
			dropzone.classList.remove('has-validation-error');
		}

		isUploading = true;
		if (submitButton instanceof HTMLButtonElement) {
			submitButton.disabled = true;
			submitButton.textContent = status === 'published' ? 'Publicando...' : 'Guardando...';
		}

		for (const button of form.querySelectorAll('button[type="submit"]')) {
			if (button !== submitButton && button instanceof HTMLButtonElement) button.disabled = true;
		}

		renderSelectedList();
		setMessage(`Subiendo ${uploadableItems.length} foto${uploadableItems.length === 1 ? '' : 's'}...`);

		try {
			await runLimitedUploads(uploadableItems, payloadBase);
			const hasErrors = selectedItems.some((item) => item.status === 'error');
			const allSucceeded = selectedItems.every((item) => item.status === 'success');

			if (allSucceeded) {
				setMessage(`✓ ${summarizeUpload()} como ${status === 'published' ? 'publicadas' : 'borrador'}.`, 'success');
				if (messageActions instanceof HTMLElement) messageActions.hidden = false;
			} else {
				setMessage(`${summarizeUpload()}${hasErrors ? '. Podés reintentar las fotos que tuvieron error.' : '.'}`, hasErrors ? 'error' : 'success');
			}
		} finally {
			isUploading = false;
			renderSelectedList();

			for (const button of form.querySelectorAll('button[type="submit"]')) {
				if (button instanceof HTMLButtonElement) button.disabled = false;
			}

			if (submitButton instanceof HTMLButtonElement) {
				submitButton.textContent = status === 'published' ? 'Publicar' : 'Guardar borrador';
			}
		}
	}

	function handleFiles(files: FileList | File[]) {
		if (!files || !files.length) return;
		addFiles(Array.from(files));
		if (fileInput instanceof HTMLInputElement) fileInput.value = '';
	}

	// Dynamic synchronization between right panel title and left item title when 1 item is selected
	titleInput?.addEventListener('input', () => {
		if (selectedItems.length === 1) {
			selectedItems[0].title = titleInput.value;
			const firstItemInput = selectedList?.querySelector('.item-title-input');
			if (firstItemInput instanceof HTMLInputElement) {
				firstItemInput.value = titleInput.value;
			}
		}
	});

	// Quick apply common title to all selected items
	applyTitleButton?.addEventListener('click', () => {
		if (!(titleInput instanceof HTMLInputElement)) return;
		const commonTitle = titleInput.value.trim();
		if (!commonTitle) {
			setMessage('Escribí un título en el campo de texto antes de aplicarlo a todas las fotos.', 'error');
			titleInput.focus();
			return;
		}
		for (const item of selectedItems) {
			item.title = commonTitle;
		}
		renderSelectedList();
		setMessage(`Se aplicó el título "${commonTitle}" a las ${selectedItems.length} fotos. Podés modificar cualquiera de ellas si querés.`, 'success');
	});

	categorySelect?.addEventListener('change', () => {
		if (categorySelect.value) {
			categorySelect.classList.remove('has-validation-error');
		}
	});

	// Clicking either dropzone or button triggers file selector
	fileButton?.addEventListener('click', () => {
		if (fileInput instanceof HTMLInputElement) fileInput.click();
	});

	dropzone?.addEventListener('click', (event) => {
		// Only trigger file dialog if the click was not directly on fileButton or inside file input
		if (event.target !== fileButton && event.target !== fileInput) {
			fileInput?.click();
		}
	});

	addMoreButton?.addEventListener('click', () => {
		if (fileInput instanceof HTMLInputElement) fileInput.click();
	});

	clearAllButton?.addEventListener('click', () => {
		if (confirm('¿Querés quitar todas las fotos seleccionadas?')) {
			clearSelectedItems();
		}
	});

	uploadMoreButton?.addEventListener('click', () => {
		clearSelectedItems();
		setMessage('');
		if (form instanceof HTMLFormElement) {
			const categoryVal = categorySelect?.value || '';
			form.reset();
			if (categorySelect && categoryVal) categorySelect.value = categoryVal;
		}
		renderSelection();
		dropzone?.scrollIntoView({ behavior: 'smooth', block: 'center' });
	});

	fileInput?.addEventListener('change', () => {
		if (fileInput instanceof HTMLInputElement) handleFiles(fileInput.files || []);
	});

	dropzone?.addEventListener('dragover', (event) => {
		event.preventDefault();
		dropzone.classList.add('is-dragging');
	});

	dropzone?.addEventListener('dragleave', () => dropzone.classList.remove('is-dragging'));

	dropzone?.addEventListener('drop', (event) => {
		event.preventDefault();
		dropzone.classList.remove('is-dragging');
		handleFiles(event.dataTransfer?.files || []);
	});

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		const submitter = (event as SubmitEvent).submitter as HTMLButtonElement | null;
		const status = submitter instanceof HTMLButtonElement && submitter.value === 'published' ? 'published' : 'draft';
		await createPhotos(status, submitter);
	});

	requireAdminSession().then((isValid) => {
		if (isValid) loadCategories();
	});

	window.addEventListener('beforeunload', clearSelectedItems);
</script>

