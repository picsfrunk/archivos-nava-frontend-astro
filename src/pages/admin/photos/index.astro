---
import AdminShell from '../../../components/AdminShell.astro';
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Fotografías | ARCHIVOS NAVA" description="Gestión de fotografías.">
	<AdminShell title="Fotografías" active="photos">
		<div class="toolbar" aria-label="Filtros">
            <label class="search-field">Buscar
                <input id="search-filter" type="search" maxlength="200" placeholder="Título, descripción o pie de foto…" />
            </label>
            <label>Año
                <input id="year-filter" type="text" inputmode="numeric" maxlength="4" placeholder="Ej. 1985" aria-describedby="year-error" />
            </label>
            <span id="year-error" role="alert"></span>
            <button id="clear-filters" class="secondary-button" type="button">Limpiar filtros</button>
			<button class="filter-button" type="button" data-filter="all" aria-pressed="true">
				Todas
			</button>
			<button class="filter-button" type="button" data-filter="published">
				Publicadas
			</button>
			<button class="filter-button" type="button" data-filter="draft">
				Borradores
			</button>
			<button class="filter-button" type="button" data-filter="trash">
				Papelera
			</button>
			<button id="empty-trash-button" class="danger-button" type="button" hidden>
				Vaciar papelera
			</button>
			<label class="category-filter">
				<span>Categoría</span>
				<select id="category-filter">
					<option value="">Todas</option>
				</select>
			</label>
		</div>

		<label class="select-page"><input id="select-page" type="checkbox" /> Seleccionar todas las visibles</label>
        <div class="action-area">
        <div id="bulk-bar" class="bulk-bar" hidden aria-label="Acciones sobre las fotografías seleccionadas">
            <strong id="selection-count" role="status"></strong>
            <button type="button" class="secondary-button" data-bulk="publish">Publicar</button>
            <button type="button" class="secondary-button" data-bulk="draft">Pasar a borrador</button>
            <button type="button" class="danger-button" data-bulk="trash">Mover a papelera</button>
            <button type="button" class="secondary-button" data-bulk="restore">Restaurar</button>
            <button id="choose-category" type="button" class="secondary-button">Cambiar categoría</button>
            <label id="bulk-category-label" hidden>Categoría de destino
                <select id="bulk-category"><option value="">Elegí una categoría</option></select>
                <button type="button" class="secondary-button" data-bulk="move_category">Aplicar categoría</button>
            </label>
        </div>
        <p id="admin-message" class="message" role="status" aria-live="polite"></p>
        </div>
        <div id="photo-grid" class="photo-grid" aria-live="polite"></div>

		<div class="pager">
			<button id="previous-page" class="secondary-button" type="button">Anterior</button>
			<span id="page-label">Página 1</span>
			<button id="next-page" class="secondary-button" type="button">Siguiente</button>
		</div>

	</AdminShell>
</Layout>

<script>
	import { adminFetch, loadAdminCategories, requireAdminSession, resolveError } from '../../../lib/admin';

	const searchInput = document.querySelector('#search-filter') as HTMLInputElement;
    const yearInput = document.querySelector('#year-filter') as HTMLInputElement;
    const yearError = document.querySelector('#year-error') as HTMLElement;
    const selectPage = document.querySelector('#select-page') as HTMLInputElement;
    const bulkBar = document.querySelector('#bulk-bar') as HTMLElement;
    const bulkCategory = document.querySelector('#bulk-category') as HTMLSelectElement;
    const categoryLabel = document.querySelector('#bulk-category-label') as HTMLElement;
    const selected = new Set<string>();
    let bulkBusy = false;
    let requestVersion = 0;
    let searchTimer: ReturnType<typeof setTimeout>;
    let activeSearch = new URLSearchParams(location.search).get('search') || '';
    let activeYear = new URLSearchParams(location.search).get('year') || '';
    searchInput.value = activeSearch;
    yearInput.value = activeYear;
    const grid = document.querySelector('#photo-grid');
	const message = document.querySelector('#admin-message');
	const filterButtons = Array.from(document.querySelectorAll('.filter-button'));
	const emptyTrashButton = document.querySelector('#empty-trash-button');
	const categoryFilter = document.querySelector('#category-filter');
	const previousButton = document.querySelector('#previous-page');
	const nextButton = document.querySelector('#next-page');
	const pageLabel = document.querySelector('#page-label');
	const statusLabels = {
		draft: 'Borrador',
		published: 'Publicada',
		trash: 'Papelera',
	};
	const emptyLabels = {
		all: 'No hay fotografías cargadas.',
		published: 'No hay fotografías publicadas.',
		draft: 'No hay borradores.',
		trash: 'La papelera está vacía.',
	};

	let activeFilter = new URLSearchParams(window.location.search).get('status') || 'all';
	let activeCategory = new URLSearchParams(window.location.search).get('category') || '';
	let currentPage = Number(new URLSearchParams(window.location.search).get('page') || '1') || 1;
	let hasMore = false;
	let isLoading = false;
	let currentPhotos = [];
	let categories = [];

	function setMessage(text, type = 'neutral') {
		if (!(message instanceof HTMLElement)) return;
		message.textContent = text;
		message.dataset.type = type;
	}

	function formatDate(value) {
		if (!value) return '';
		return new Intl.DateTimeFormat('es-AR', {
			day: '2-digit',
			month: 'short',
			year: 'numeric',
		}).format(new Date(value));
	}

	function setUrlState() {
		const params = new URLSearchParams();
		if (activeFilter !== 'all') params.set('status', activeFilter);
		if (activeCategory) params.set('category', activeCategory);
        if (activeSearch) params.set('search', activeSearch);
        if (activeYear) params.set('year', activeYear);
		if (currentPage > 1) params.set('page', String(currentPage));
		const query = params.toString();
		const url = query ? `/admin/photos?${query}` : '/admin/photos';
        if (location.pathname + location.search !== url) window.history.pushState(null, '', url);
	}

	function updateFilterButtons() {
		for (const button of filterButtons) {
			if (!(button instanceof HTMLButtonElement)) continue;
			button.setAttribute('aria-pressed', button.dataset.filter === activeFilter ? 'true' : 'false');
		}
	}

	function updatePager() {
		if (pageLabel instanceof HTMLElement) pageLabel.textContent = `Página ${currentPage}`;
		if (previousButton instanceof HTMLButtonElement) previousButton.disabled = isLoading || currentPage <= 1;
		if (nextButton instanceof HTMLButtonElement) nextButton.disabled = isLoading || !hasMore;
	}

	function updateTrashControls() {
		if (!(emptyTrashButton instanceof HTMLButtonElement)) return;
		emptyTrashButton.hidden = activeFilter !== 'trash' || currentPhotos.length === 0;
		emptyTrashButton.disabled = isLoading || currentPhotos.length === 0;
	}

	function updateCategoryFilter() {
		if (!(categoryFilter instanceof HTMLSelectElement)) return;

		categoryFilter.innerHTML = '';
		const allOption = document.createElement('option');
		allOption.value = '';
		allOption.textContent = 'Todas';
		categoryFilter.append(allOption);

		for (const category of categories.filter((item) => !item.isTechnical)) {
			const option = document.createElement('option');
			option.value = category.id;
			option.textContent = category.name || category.slug || category.id;
			categoryFilter.append(option);
		}

		categoryFilter.value = activeCategory;
	}

	function renderEmpty() {
		if (!(grid instanceof HTMLElement)) return;
		grid.innerHTML = '';
		currentPhotos = [];
		updateTrashControls();
		const empty = document.createElement('div');
		empty.className = 'empty-state';
		empty.textContent = activeSearch || activeYear || activeCategory ? 'Ninguna fotografía coincide con los filtros.' : emptyLabels[activeFilter] || emptyLabels.all;
		grid.append(empty);
	}

	function photoTitle(photo) {
		return photo.title || photo.caption || 'Sin título';
	}

	function renderPhotos(photos) {
		if (!(grid instanceof HTMLElement)) return;
		grid.innerHTML = '';
		currentPhotos = photos;
		updateTrashControls();

		if (!photos.length) {
			renderEmpty();
			return;
		}

		for (const photo of photos) {
			const article = document.createElement('article');
			article.className = 'photo-card';

			const image = document.createElement('img');
			image.src = photo.image;
			image.alt = photoTitle(photo);
			image.loading = 'lazy';

			const body = document.createElement('div');
			body.className = 'photo-card-body';

			const title = document.createElement('h2');
			title.textContent = photoTitle(photo);

			const meta = document.createElement('p');
			const category = photo.categoryRecord?.name || photo.categoryRecord?.slug || 'Sin categoría';
			const pieces = [category];
			if (photo.year) pieces.push(String(photo.year));
			const created = formatDate(photo.created);
			if (created) pieces.push(created);
			meta.textContent = pieces.join(' · ');

			const status = document.createElement('span');
			status.className = 'status-pill';
			status.dataset.status = photo.status;
			status.textContent = statusLabels[photo.status] || photo.status;

			const badges = document.createElement('div');
			badges.className = 'photo-badges';
			badges.append(status);

			if (photo.is_home_cover) {
				const cover = document.createElement('span');
				cover.className = 'status-pill cover-pill';
				cover.textContent = 'Portada';
				badges.append(cover);
			}

			const actions = document.createElement('div');
			actions.className = 'photo-actions';

			const editLink = document.createElement('a');
			editLink.className = 'secondary-button';
			editLink.href = `/admin/photos/edit?id=${encodeURIComponent(photo.id)}`;
			editLink.textContent = 'Editar';
			actions.append(editLink);

			if (photo.status === 'trash') {
				const restoreButton = document.createElement('button');
				restoreButton.type = 'button';
				restoreButton.className = 'secondary-button';
				restoreButton.textContent = 'Restaurar';
				restoreButton.addEventListener('click', () => restorePhoto(photo.id));
				actions.append(restoreButton);

				const permanentButton = document.createElement('button');
				permanentButton.type = 'button';
				permanentButton.className = 'danger-button';
				permanentButton.textContent = 'Eliminar definitivamente';
				permanentButton.addEventListener('click', () => deletePhotoPermanently(photo.id));
				actions.append(permanentButton);
			} else {
				if (photo.status === 'published') {
					const coverButton = document.createElement('button');
					coverButton.type = 'button';
					coverButton.className = 'secondary-button';
					coverButton.textContent = photo.is_home_cover ? 'Portada actual' : 'Usar como portada';
					coverButton.disabled = Boolean(photo.is_home_cover);
					coverButton.addEventListener('click', () => setHomeCover(photo.id));
					actions.append(coverButton);
				}

				if (activeCategory && !activeSearch && !activeYear) {
					const upButton = document.createElement('button');
					upButton.type = 'button';
					upButton.className = 'secondary-button';
					upButton.textContent = 'Subir';
					upButton.addEventListener('click', () => movePhoto(photo.id, 'up'));

					const downButton = document.createElement('button');
					downButton.type = 'button';
					downButton.className = 'secondary-button';
					downButton.textContent = 'Bajar';
					downButton.addEventListener('click', () => movePhoto(photo.id, 'down'));

					actions.append(upButton, downButton);
				}

				const trashButton = document.createElement('button');
				trashButton.type = 'button';
				trashButton.className = 'danger-button';
				trashButton.textContent = 'Eliminar';
				trashButton.addEventListener('click', () => trashPhoto(photo.id));
				actions.append(trashButton);
			}

			const selectionLabel = document.createElement('label');
            selectionLabel.className = 'photo-select';
            const checkbox = document.createElement('input');
            checkbox.type = 'checkbox';
            checkbox.dataset.photoId = photo.id;
            checkbox.disabled = isLoading || bulkBusy;
            checkbox.addEventListener('change', () => {
                if (checkbox.checked) selected.add(photo.id); else selected.delete(photo.id);
                updateSelection();
            });
            selectionLabel.append(checkbox, document.createTextNode(`Seleccionar ${photo.title || 'Fotografía'}`));
            body.append(selectionLabel, title, meta, badges, actions);
			article.append(image, body);
			grid.append(article);
		}
	}

	async function loadCategories() {
		try {
			categories = await loadAdminCategories();
			updateCategoryFilter();
            for (const category of categories.filter(item => item.active && !item.isTechnical)) {
                const option = document.createElement('option');
                option.value = category.id; option.textContent = category.name || 'Categoría';
                bulkCategory.append(option);
            }
        } catch (error) {
			if (error?.authError) return;
			categories = [];
			updateCategoryFilter();
			setMessage(resolveError(error), 'error');
		}
	}

	async function loadPhotos() {
        clearTimeout(searchTimer);
        const version = ++requestVersion;
        activeSearch = searchInput.value.trim();
        activeYear = yearInput.value.trim();
        setUrlState();
        clearSelection();
        if (activeYear && (!/^\d{1,4}$/.test(activeYear) || Number(activeYear) < 1800 || Number(activeYear) > 2100)) {
            yearError.textContent = 'Ingresá un año entero entre 1800 y 2100.';
            yearInput.setAttribute('aria-invalid', 'true');
            setMessage('Revisá el año para continuar.', 'error');
            isLoading = false;
            hasMore = false;
            renderPhotos([]);
            updatePager();
            updateSelection();
            return;
        }
        yearError.textContent = '';
        yearInput.removeAttribute('aria-invalid');
        isLoading = true;
        updateSelection();
		updateFilterButtons();
		updatePager();
		updateTrashControls();
		setUrlState();
		setMessage(activeSearch ? 'Buscando…' : 'Cargando fotografías…');

		try {
			const params = new URLSearchParams({
				status: activeFilter,
				page: String(currentPage),
				perPage: '24',
			});
			if (activeCategory) params.set('category', activeCategory);
        if (activeSearch) params.set('search', activeSearch);
        if (activeYear) params.set('year', activeYear);
			const result = await adminFetch(`/api/archivos-nava/admin/photos?${params.toString()}`);
			if (version !== requestVersion) return;
            hasMore = Boolean(result.hasMore);
			renderPhotos(result.items || []);
			setMessage('');
            return true;
		} catch (error) {
			if (error?.authError) return;
			if (version !== requestVersion) return;
            hasMore = false;
            renderPhotos([]);
			setMessage(resolveError(error), 'error');
            return false;
		} finally {
            if (version !== requestVersion) return;
			isLoading = false;
            updateSelection();
			updatePager();
			updateTrashControls();
		}
	}

	async function setHomeCover(id) {
		try {
			await adminFetch(`/api/archivos-nava/admin/photos/${encodeURIComponent(id)}/home-cover`, {
				method: 'PATCH',
			});
			await loadPhotos();
			setMessage('Portada de inicio actualizada.', 'success');
		} catch (error) {
			if (error?.authError) return;
			setMessage(resolveError(error), 'error');
		}
	}

	async function movePhoto(id, direction) {
		try {
			await adminFetch(`/api/archivos-nava/admin/photos/${encodeURIComponent(id)}/move`, {
				method: 'PATCH',
				body: JSON.stringify({
					direction,
					status: activeFilter,
				}),
			});
			await loadPhotos();
			setMessage('Orden público actualizado.', 'success');
		} catch (error) {
			if (error?.authError) return;
			setMessage(resolveError(error), 'error');
		}
	}

	async function trashPhoto(id) {
		const confirmed = window.confirm('¿Enviar esta fotografía a la papelera? Podrás restaurarla después.');
		if (!confirmed) return;

		try {
			await adminFetch(`/api/archivos-nava/admin/photos/${encodeURIComponent(id)}/trash`, {
				method: 'PATCH',
			});
			await loadPhotos();
			setMessage('Fotografía enviada a papelera.', 'success');
		} catch (error) {
			if (error?.authError) return;
			setMessage(resolveError(error), 'error');
		}
	}

	async function restorePhoto(id) {
		try {
			await adminFetch(`/api/archivos-nava/admin/photos/${encodeURIComponent(id)}/restore`, {
				method: 'PATCH',
			});
			await loadPhotos();
			setMessage('Fotografía restaurada como borrador.', 'success');
		} catch (error) {
			if (error?.authError) return;
			setMessage(resolveError(error), 'error');
		}
	}

	async function deletePhotoPermanently(id) {
		const confirmed = window.confirm(
			'¿Eliminar definitivamente esta fotografía? Se borrará el registro y el archivo en Cloudinary. Esta acción es irreversible.',
		);
		if (!confirmed) return;

		try {
			await adminFetch(`/api/archivos-nava/admin/photos/${encodeURIComponent(id)}/permanent`, {
				method: 'DELETE',
			});
			await loadPhotos();
			setMessage('Fotografía eliminada definitivamente.', 'success');
		} catch (error) {
			if (error?.authError) return;
			setMessage(resolveError(error), 'error');
		}
	}

	async function emptyTrash() {
		const confirmed = window.confirm(
			'¿Vaciar la papelera? Se borrarán definitivamente los registros y los archivos en Cloudinary. Esta acción es irreversible.',
		);
		if (!confirmed) return;

		try {
			const result = await adminFetch('/api/archivos-nava/admin/photos/trash', {
				method: 'DELETE',
			});
			await loadPhotos();

			if (result.failed > 0) {
				setMessage(`${result.deleted} eliminadas, ${result.failed} fallaron. Las fallidas permanecen en papelera.`, 'error');
			} else {
				setMessage(`${result.deleted} eliminadas definitivamente.`, 'success');
			}
		} catch (error) {
			if (error?.authError) return;
			setMessage(resolveError(error), 'error');
		}
	}

    function updateSelection() {
        bulkBar.hidden = selected.size === 0;
        document.querySelector('#selection-count').textContent = `${selected.size} seleccionadas`;
        selectPage.checked = currentPhotos.length > 0 && selected.size === currentPhotos.length;
        selectPage.indeterminate = selected.size > 0 && selected.size < currentPhotos.length;
        selectPage.disabled = isLoading || bulkBusy || currentPhotos.length === 0;
        for (const checkbox of grid.querySelectorAll<HTMLInputElement>('input[data-photo-id]')) {
            checkbox.checked = selected.has(checkbox.dataset.photoId);
            checkbox.disabled = isLoading || bulkBusy;
        }
        const chosen = currentPhotos.filter(photo => selected.has(photo.id));
        for (const button of bulkBar.querySelectorAll<HTMLButtonElement>('button')) {
            button.disabled = bulkBusy || isLoading;
            if (button.dataset.bulk === 'restore') button.hidden = !chosen.some(photo => photo.status === 'trash');
            if (['publish', 'draft', 'trash'].includes(button.dataset.bulk)) button.hidden = !chosen.some(photo => photo.status !== 'trash');
        }
    }

    function clearSelection() {
        selected.clear();
        categoryLabel.hidden = true;
        bulkCategory.value = '';
        updateSelection();
    }

    selectPage.addEventListener('change', () => {
        selected.clear();
        if (selectPage.checked) currentPhotos.forEach(photo => selected.add(photo.id));
        updateSelection();
    });
    document.querySelector('#choose-category').addEventListener('click', () => {
        categoryLabel.hidden = !categoryLabel.hidden;
        if (!categoryLabel.hidden) bulkCategory.focus();
    });
    for (const button of bulkBar.querySelectorAll<HTMLButtonElement>('[data-bulk]')) {
        button.addEventListener('click', () => runBulk(button.dataset.bulk));
    }
    async function runBulk(action: string) {
        if (bulkBusy || isLoading || !selected.size) return;
        if (action === 'move_category' && !bulkCategory.value) { setMessage('Elegí una categoría de destino.', 'error'); bulkCategory.focus(); return; }
        if (['trash', 'draft'].includes(action) && !window.confirm(action === 'trash'
            ? `¿Mover ${selected.size} fotografías a la papelera? Podrás restaurarlas después.`
            : `¿Pasar ${selected.size} fotografías a borrador? Dejarán de mostrarse al público.`)) return;
        bulkBusy = true;
        // Lock the list while saving so filters and individual actions cannot race the batch.
        document.querySelector('.toolbar').setAttribute('inert', '');
        grid.setAttribute('inert', '');
        document.querySelector('.pager').setAttribute('inert', '');
        updateSelection();
        setMessage('Guardando cambios…');
        try {
            const result = await adminFetch<{ updated: number; skipped: number; failed: number }>('/api/archivos-nava/admin/photos/bulk', {
                method: 'POST', body: JSON.stringify({ ids: [...selected], action, ...(action === 'move_category' ? { categoryId: bulkCategory.value } : {}) }),
            });
            const refreshed = await loadPhotos();
            const labels = { publish: 'publicadas', draft: 'pasadas a borrador', trash: 'movidas a papelera', restore: 'restauradas como borrador', move_category: 'cambiadas de categoría' };
            setMessage(`${result.updated} fotos ${labels[action]}.${result.skipped ? ` ${result.skipped} sin cambios: ya estaban así o necesitan restaurarse primero.` : ''}${result.failed ? ` ${result.failed} no pudieron actualizarse.` : ''}${refreshed ? '' : ' Los cambios se guardaron, pero no pudimos refrescar la lista. Volvé a cargarla.'}`, refreshed ? 'success' : 'error');
        } catch (error) {
            if (!error?.authError) setMessage(resolveError(error), 'error');
        } finally {
            bulkBusy = false;
            document.querySelector('.toolbar').removeAttribute('inert');
            grid.removeAttribute('inert');
            document.querySelector('.pager').removeAttribute('inert');
            updateSelection();
        }
    }
    function applyTextFilters() {
        activeSearch = searchInput.value.trim(); activeYear = yearInput.value.trim(); currentPage = 1;
        loadPhotos();
    }
    for (const input of [searchInput, yearInput]) input.addEventListener('input', () => {
        // Invalidate responses and selection immediately, including during the debounce window.
        requestVersion++; clearSelection(); isLoading = true; updateSelection(); updatePager();
        setMessage('Buscando…');
        clearTimeout(searchTimer); searchTimer = setTimeout(applyTextFilters, 350);
    });
    document.querySelector('#clear-filters').addEventListener('click', () => {
        searchInput.value = ''; yearInput.value = ''; activeSearch = ''; activeYear = '';
        activeCategory = ''; activeFilter = 'all'; currentPage = 1;
        categoryFilter.value = ''; loadPhotos();
    });
    window.addEventListener('popstate', () => {
        const params = new URLSearchParams(location.search);
        activeSearch = params.get('search') || ''; activeYear = params.get('year') || '';
        activeCategory = params.get('category') || ''; activeFilter = params.get('status') || 'all';
        currentPage = Math.max(1, Number(params.get('page')) || 1);
        searchInput.value = activeSearch; yearInput.value = activeYear; categoryFilter.value = activeCategory;
        loadPhotos();
    });

	for (const button of filterButtons) {
		button.addEventListener('click', () => {
			if (!(button instanceof HTMLButtonElement)) return;
			activeFilter = button.dataset.filter || 'all';
			currentPage = 1;
			loadPhotos();
		});
	}

	categoryFilter?.addEventListener('change', () => {
		if (!(categoryFilter instanceof HTMLSelectElement)) return;
		activeCategory = categoryFilter.value;
		currentPage = 1;
		loadPhotos();
	});

	previousButton?.addEventListener('click', () => {
		if (currentPage <= 1) return;
		currentPage -= 1;
		loadPhotos();
	});

	nextButton?.addEventListener('click', () => {
		if (!hasMore) return;
		currentPage += 1;
		loadPhotos();
	});

	emptyTrashButton?.addEventListener('click', () => {
		emptyTrash();
	});

	requireAdminSession().then((isValid) => {
		if (isValid) {
			loadCategories();
			loadPhotos();
		}
	});
</script>

<style>
    .toolbar label { display: grid; gap: 6px; max-width: 100%; }
    .search-field { flex: 1 1 280px; }
    .toolbar input { min-width: 0; width: 100%; }
    #year-filter { max-width: 120px; }
    #year-error { color: #ffb4ab; }
    .select-page { display: flex; align-items: center; gap: 10px; min-height: 44px; margin-bottom: 12px; }
    .action-area { position: sticky; top: 0; z-index: 10; background: #10100f; }
    .action-area .message { margin: 0; padding: 10px 0; }
    .action-area .message:empty { display: none; }
    .bulk-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; padding: 16px; margin-bottom: 18px; border: 1px solid #999; border-radius: 8px; background: #222; }
