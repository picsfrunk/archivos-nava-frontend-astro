---
import AdminShell from '../../../components/AdminShell.astro';
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Categorías | ARCHIVOS NAVA" description="Gestión de categorías.">
	<AdminShell title="Categorías" active="categories">
		<div class="category-layout">
			<section class="category-list" aria-labelledby="category-list-title">
				<div class="panel-heading">
					<h2 id="category-list-title">Listado</h2>
					<button id="new-category-button" type="button">Nueva categoría</button>
				</div>

				<div class="table-wrap">
					<table>
						<thead>
							<tr>
								<th>Nombre</th>
								<th>Slug</th>
								<th>Orden</th>
								<th>Portada</th>
								<th>Estado</th>
								<th>Acciones</th>
							</tr>
						</thead>
						<tbody id="category-table"></tbody>
					</table>
				</div>
			</section>

			<form id="category-form" class="category-form" novalidate>
				<h2 id="form-title">Nueva categoría</h2>
				<input id="category-id" name="id" type="hidden" />

				<label>
					<span>Nombre</span>
					<input id="name" name="name" type="text" autocomplete="off" required />
				</label>
				<label>
					<span>Slug</span>
					<input id="slug" name="slug" type="text" autocomplete="off" placeholder="se-completa-solo" />
				</label>
				<label>
					<span>Descripción</span>
					<textarea id="description" name="description" rows="4"></textarea>
				</label>
				<label>
					<span>Orden</span>
					<input id="sort_order" name="sort_order" type="number" inputmode="numeric" step="1" />
				</label>
				<label class="check-row">
					<input id="active" name="active" type="checkbox" checked />
					<span>Activa</span>
				</label>
				<div id="cover-photo-field" class="cover-photo-field" hidden>
					<span class="cover-field-title">Portada de categoría</span>
					<select id="cover_photo" name="cover_photo" class="visually-hidden">
						<option value="">Usar la primera foto automáticamente</option>
					</select>

					<div id="cover-preview-card" class="cover-preview-card">
						<div class="cover-card-media">
							<img id="cover-preview-img" src="" alt="Portada actual" hidden />
							<div id="cover-placeholder" class="cover-placeholder">
								<span class="cover-icon">🖼️</span>
							</div>
						</div>
						<div class="cover-card-content">
							<div class="cover-status-badge-wrap">
								<span id="cover-status-badge" class="cover-status-badge">Sin portada seleccionada</span>
							</div>
							<p id="cover-status-title" class="cover-status-title">Usar la primera foto automáticamente</p>
							<p id="cover-status-desc" class="cover-status-desc">
								La galería mostrará la primera foto pública según el orden editorial.
							</p>
							<div class="cover-card-actions">
								<button id="open-cover-picker-button" class="secondary-button" type="button" disabled>
									Elegir foto
								</button>
								<button id="clear-cover-button" class="secondary-button" type="button" hidden>
									Quitar portada
								</button>
							</div>
						</div>
					</div>

					<div id="cover-picker-panel" class="cover-picker-panel" hidden>
						<div class="cover-picker-header">
							<h3 class="cover-picker-title">Elegir fotografía para portada</h3>
							<button id="close-cover-picker-button" class="close-picker-button" type="button" aria-label="Cerrar selector">×</button>
						</div>
						<div class="cover-picker-options">
							<button id="picker-auto-button" class="picker-auto-button" type="button">
								<strong>Usar la primera foto automáticamente</strong>
								<span>No fijar ninguna portada; se tomará la primera foto pública por orden.</span>
							</button>
						</div>
						<div id="cover-picker-list" class="cover-picker-list" aria-label="Fotografías publicadas"></div>
					</div>

					<small id="cover-photo-help" class="cover-photo-help"></small>
				</div>

				<div class="form-actions">
					<button type="submit">Guardar</button>
					<button id="cancel-edit-button" class="secondary-button" type="button">Cancelar</button>
				</div>
			</form>
		</div>

		<p id="admin-message" class="message" role="status" aria-live="polite"></p>
	</AdminShell>
</Layout>

<script>
	import { adminFetch, loadAdminCategories, requireAdminSession, resolveError } from '../../../lib/admin';

	const table = document.querySelector('#category-table');
	const form = document.querySelector('#category-form');
	const formTitle = document.querySelector('#form-title');
	const idInput = document.querySelector('#category-id');
	const nameInput = document.querySelector('#name');
	const slugInput = document.querySelector('#slug');
	const descriptionInput = document.querySelector('#description');
	const sortOrderInput = document.querySelector('#sort_order');
	const activeInput = document.querySelector('#active');
	const coverPhotoField = document.querySelector('#cover-photo-field');
	const coverPhotoSelect = document.querySelector('#cover_photo');
	const coverPhotoHelp = document.querySelector('#cover-photo-help');
	const coverPreviewImg = document.querySelector('#cover-preview-img');
	const coverPlaceholder = document.querySelector('#cover-placeholder');
	const coverStatusBadge = document.querySelector('#cover-status-badge');
	const coverStatusTitle = document.querySelector('#cover-status-title');
	const coverStatusDesc = document.querySelector('#cover-status-desc');
	const openCoverPickerButton = document.querySelector('#open-cover-picker-button');
	const clearCoverButton = document.querySelector('#clear-cover-button');
	const coverPickerPanel = document.querySelector('#cover-picker-panel');
	const closeCoverPickerButton = document.querySelector('#close-cover-picker-button');
	const pickerAutoButton = document.querySelector('#picker-auto-button');
	const coverPickerList = document.querySelector('#cover-picker-list');
	const newButton = document.querySelector('#new-category-button');
	const cancelButton = document.querySelector('#cancel-edit-button');
	const message = document.querySelector('#admin-message');

	let categories = [];
	let isLoading = false;
	let selectedCategory = null;
	let coverRequestId = 0;
	let coverPhotoTitles = {};
	let originalCoverPhoto = '';
	let coverOptionsLoaded = false;
	let coverSelectionDirty = false;
	let availableCategoryPhotos = [];

	function setMessage(text, type = 'neutral') {
		if (!(message instanceof HTMLElement)) return;
		message.textContent = text;
		message.dataset.type = type;
	}

	function normalizeSlug(value) {
		return String(value || '')
			.trim()
			.toLowerCase()
			.replace(/[áàäâ]/g, 'a')
			.replace(/[éèëê]/g, 'e')
			.replace(/[íìïî]/g, 'i')
			.replace(/[óòöô]/g, 'o')
			.replace(/[úùüû]/g, 'u')
			.replace(/ñ/g, 'n')
			.replace(/[^a-z0-9]+/g, '-')
			.replace(/^-+|-+$/g, '');
	}

	function updateCoverUI() {
		const currentCoverId = coverPhotoSelect instanceof HTMLSelectElement ? coverPhotoSelect.value : '';
		const matchingPhoto = availableCategoryPhotos.find((p) => p.id === currentCoverId);

		if (currentCoverId && matchingPhoto) {
			if (coverStatusBadge instanceof HTMLElement) {
				coverStatusBadge.textContent = 'Portada seleccionada';
				coverStatusBadge.dataset.type = 'selected';
			}
			if (coverStatusTitle instanceof HTMLElement) coverStatusTitle.textContent = photoTitle(matchingPhoto);
			if (coverStatusDesc instanceof HTMLElement) {
				const yearPart = matchingPhoto.year ? ` · Año ${matchingPhoto.year}` : '';
				coverStatusDesc.textContent = `Esta foto será la imagen representativa de la categoría${yearPart}.`;
			}
			if (coverPreviewImg instanceof HTMLImageElement) {
				coverPreviewImg.src = matchingPhoto.image;
				coverPreviewImg.alt = photoTitle(matchingPhoto);
				coverPreviewImg.hidden = false;
			}
			if (coverPlaceholder instanceof HTMLElement) coverPlaceholder.hidden = true;
			if (openCoverPickerButton instanceof HTMLButtonElement) openCoverPickerButton.textContent = 'Cambiar foto';
			if (clearCoverButton instanceof HTMLButtonElement) clearCoverButton.hidden = false;
		} else if (currentCoverId && !matchingPhoto && originalCoverPhoto === currentCoverId) {
			const title = coverPhotoTitles[currentCoverId] || 'Portada asignada';
			if (coverStatusBadge instanceof HTMLElement) {
				coverStatusBadge.textContent = 'Portada seleccionada';
				coverStatusBadge.dataset.type = 'selected';
			}
			if (coverStatusTitle instanceof HTMLElement) coverStatusTitle.textContent = title;
			if (coverStatusDesc instanceof HTMLElement) coverStatusDesc.textContent = 'Esta foto será la imagen representativa de la categoría.';
			if (coverPreviewImg instanceof HTMLImageElement) coverPreviewImg.hidden = true;
			if (coverPlaceholder instanceof HTMLElement) coverPlaceholder.hidden = false;
			if (openCoverPickerButton instanceof HTMLButtonElement) openCoverPickerButton.textContent = 'Cambiar foto';
			if (clearCoverButton instanceof HTMLButtonElement) clearCoverButton.hidden = false;
		} else {
			if (coverStatusBadge instanceof HTMLElement) {
				coverStatusBadge.textContent = 'Sin portada seleccionada';
				coverStatusBadge.dataset.type = 'auto';
			}
			if (coverStatusTitle instanceof HTMLElement) coverStatusTitle.textContent = 'Usar la primera foto automáticamente';
			if (coverStatusDesc instanceof HTMLElement) {
				coverStatusDesc.textContent = 'La galería pública mostrará la primera foto según el orden editorial.';
			}
			if (coverPreviewImg instanceof HTMLImageElement) {
				coverPreviewImg.src = '';
				coverPreviewImg.hidden = true;
			}
			if (coverPlaceholder instanceof HTMLElement) coverPlaceholder.hidden = false;
			if (openCoverPickerButton instanceof HTMLButtonElement) openCoverPickerButton.textContent = 'Elegir foto';
			if (clearCoverButton instanceof HTMLButtonElement) clearCoverButton.hidden = true;
		}

		if (openCoverPickerButton instanceof HTMLButtonElement) {
			openCoverPickerButton.disabled = !coverOptionsLoaded;
		}
	}

	function renderCoverPickerList() {
		if (!(coverPickerList instanceof HTMLElement)) return;
		coverPickerList.innerHTML = '';

		if (!availableCategoryPhotos.length) {
			const emptyNotice = document.createElement('p');
			emptyNotice.className = 'picker-empty-notice';
			emptyNotice.textContent = 'No hay fotografías publicadas en esta categoría para elegir como portada.';
			coverPickerList.append(emptyNotice);
			return;
		}

		const currentCoverId = coverPhotoSelect instanceof HTMLSelectElement ? coverPhotoSelect.value : '';

		for (const photo of availableCategoryPhotos) {
			const btn = document.createElement('button');
			btn.type = 'button';
			btn.className = 'picker-photo-card';
			if (photo.id === currentCoverId) {
				btn.classList.add('is-selected');
				btn.setAttribute('aria-current', 'true');
			}

			const img = document.createElement('img');
			img.src = photo.image;
			img.alt = photoTitle(photo);
			img.loading = 'lazy';

			const info = document.createElement('div');
			info.className = 'picker-photo-info';

			const title = document.createElement('strong');
			title.textContent = photoTitle(photo);

			const meta = document.createElement('span');
			meta.textContent = photo.year ? `Año ${photo.year}` : 'Sin año';

			info.append(title, meta);

			if (photo.id === currentCoverId) {
				const badge = document.createElement('span');
				badge.className = 'picker-selected-badge';
				badge.textContent = 'Seleccionada';
				info.append(badge);
			}

			btn.append(img, info);

			btn.addEventListener('click', () => {
				selectCoverPhoto(photo.id);
			});

			coverPickerList.append(btn);
		}
	}

	function selectCoverPhoto(photoId) {
		if (!(coverPhotoSelect instanceof HTMLSelectElement)) return;
		coverPhotoSelect.value = photoId;
		coverSelectionDirty = photoId !== originalCoverPhoto;
		updateCoverUI();
		if (coverPickerPanel instanceof HTMLElement) {
			coverPickerPanel.hidden = true;
		}
	}

	function setFormMode(category = null, clearMessage = true) {
		if (!(form instanceof HTMLFormElement)) return;
		form.reset();
		selectedCategory = category;
		originalCoverPhoto = category?.cover_photo || '';
		coverOptionsLoaded = false;
		coverSelectionDirty = false;
		availableCategoryPhotos = [];
		if (coverPickerPanel instanceof HTMLElement) coverPickerPanel.hidden = true;

		if (idInput instanceof HTMLInputElement) idInput.value = category?.id || '';
		if (nameInput instanceof HTMLInputElement) nameInput.value = category?.name || '';
		if (slugInput instanceof HTMLInputElement) slugInput.value = category?.slug || '';
		if (descriptionInput instanceof HTMLTextAreaElement) descriptionInput.value = category?.description || '';
		if (sortOrderInput instanceof HTMLInputElement) sortOrderInput.value = category?.sort_order == null ? '' : String(category.sort_order);
		if (activeInput instanceof HTMLInputElement) activeInput.checked = category ? Boolean(category.active) : true;
		if (coverPhotoField instanceof HTMLElement) coverPhotoField.hidden = !category;
		if (coverPhotoSelect instanceof HTMLSelectElement) {
			coverPhotoSelect.innerHTML = '<option value="">Usar la primera foto automáticamente</option>';
			coverPhotoSelect.value = originalCoverPhoto;
			coverPhotoSelect.disabled = !category;
		}
		if (coverPhotoHelp instanceof HTMLElement) {
			coverPhotoHelp.textContent = category ? 'Cargando opciones de portada...' : '';
			coverPhotoHelp.dataset.type = 'neutral';
			coverPhotoHelp.hidden = !category;
		}
		if (formTitle instanceof HTMLElement) formTitle.textContent = category ? 'Editar categoría' : 'Nueva categoría';

		updateCoverUI();

		form.dataset.mode = category ? 'edit' : 'create';
		if (clearMessage) setMessage('');
		if (category) loadCoverOptions(category);
	}

	function categoryLabel(category) {
		return category.name || category.slug || category.id;
	}

	function photoTitle(photo) {
		return photo.title || photo.caption || `Foto ${photo.id}`;
	}

	function renderEmpty() {
		if (!(table instanceof HTMLElement)) return;
		table.innerHTML = '';
		const row = document.createElement('tr');
		const cell = document.createElement('td');
		cell.colSpan = 6;
		cell.className = 'empty-cell';
		cell.textContent = 'No hay categorías cargadas.';
		row.append(cell);
		table.append(row);
	}

	function renderCategories() {
		if (!(table instanceof HTMLElement)) return;
		table.innerHTML = '';

		const visibleCategories = categories.filter((category) => !category.isTechnical);
		if (!visibleCategories.length) {
			renderEmpty();
			return;
		}

		for (const category of visibleCategories) {
			const row = document.createElement('tr');

			const name = document.createElement('td');
			name.textContent = categoryLabel(category);

			const slug = document.createElement('td');
			slug.textContent = category.slug || '';

			const order = document.createElement('td');
			order.textContent = category.sort_order == null ? '' : String(category.sort_order);

			const cover = document.createElement('td');
			if (category.cover_photo) {
				const pill = document.createElement('span');
				pill.className = 'cover-pill manual';
				const title = coverPhotoTitles[category.cover_photo] || 'Portada asignada';
				pill.textContent = title;
				pill.title = title;
				cover.append(pill);
			} else {
				const pill = document.createElement('span');
				pill.className = 'cover-pill auto';
				pill.textContent = 'Automática';
				pill.title = 'Usa la primera foto pública automáticamente';
				cover.append(pill);
			}

			const status = document.createElement('td');
			const pill = document.createElement('span');
			pill.className = 'status-pill';
			pill.dataset.status = category.active ? 'published' : 'draft';
			pill.textContent = category.active ? 'Activa' : 'Inactiva';
			status.append(pill);

			const actions = document.createElement('td');
			const actionGroup = document.createElement('div');
			actionGroup.className = 'row-actions';

			const editButton = document.createElement('button');
			editButton.type = 'button';
			editButton.className = 'secondary-button';
			editButton.textContent = 'Editar';
			editButton.addEventListener('click', () => setFormMode(category));

			const upButton = document.createElement('button');
			upButton.type = 'button';
			upButton.className = 'secondary-button';
			upButton.textContent = 'Subir';
			upButton.addEventListener('click', () => moveCategory(category, -1));

			const downButton = document.createElement('button');
			downButton.type = 'button';
			downButton.className = 'secondary-button';
			downButton.textContent = 'Bajar';
			downButton.addEventListener('click', () => moveCategory(category, 1));

			const toggleButton = document.createElement('button');
			toggleButton.type = 'button';
			toggleButton.className = 'secondary-button';
			toggleButton.textContent = category.active ? 'Desactivar' : 'Activar';
			toggleButton.addEventListener('click', () => toggleCategory(category));

			const deleteButton = document.createElement('button');
			deleteButton.type = 'button';
			deleteButton.className = 'danger-button';
			deleteButton.textContent = 'Eliminar';
			deleteButton.addEventListener('click', () => deleteCategory(category));

			actionGroup.append(editButton, upButton, downButton, toggleButton, deleteButton);
			actions.append(actionGroup);
			row.append(name, slug, order, cover, status, actions);
			table.append(row);
		}
	}

	async function loadCoverOptions(category) {
		if (!(coverPhotoSelect instanceof HTMLSelectElement)) return;

		const requestId = coverRequestId + 1;
		coverRequestId = requestId;
		coverOptionsLoaded = false;
		coverSelectionDirty = false;
		availableCategoryPhotos = [];
		coverPhotoSelect.disabled = true;
		coverPhotoSelect.innerHTML = '<option value="">Usar la primera foto automáticamente</option>';
		updateCoverUI();

		if (coverPhotoHelp instanceof HTMLElement) {
			coverPhotoHelp.textContent = 'Cargando opciones de portada...';
			coverPhotoHelp.dataset.type = 'neutral';
			coverPhotoHelp.hidden = false;
		}

		try {
			const params = new URLSearchParams({
				status: 'published',
				category: category.id,
				page: '1',
				perPage: '200',
			});
			const result = await adminFetch(`/api/archivos-nava/admin/photos?${params.toString()}`);
			if (requestId !== coverRequestId || selectedCategory?.id !== category.id) return;

			availableCategoryPhotos = result.items || [];

			for (const photo of availableCategoryPhotos) {
				const option = document.createElement('option');
				option.value = photo.id;
				option.textContent = photoTitle(photo);
				coverPhotoSelect.append(option);
			}

			coverPhotoSelect.value = category.cover_photo || '';
			coverPhotoSelect.disabled = false;
			coverOptionsLoaded = true;
			coverSelectionDirty = false;
			updateCoverUI();
			renderCoverPickerList();

			if (coverPhotoHelp instanceof HTMLElement) {
				coverPhotoHelp.textContent = '';
				coverPhotoHelp.hidden = true;
			}
		} catch (error) {
			if (error?.authError) return;
			if (requestId !== coverRequestId || selectedCategory?.id !== category.id) return;
			coverOptionsLoaded = false;
			coverSelectionDirty = false;
			availableCategoryPhotos = [];
			coverPhotoSelect.value = originalCoverPhoto;
			coverPhotoSelect.disabled = true;
			updateCoverUI();

			if (coverPhotoHelp instanceof HTMLElement) {
				coverPhotoHelp.textContent = 'No se pudieron cargar las portadas. Podés guardar otros cambios; la portada actual no se modificará.';
				coverPhotoHelp.dataset.type = 'error';
				coverPhotoHelp.hidden = false;
			}
		}
	}

	async function loadCoverPhotoTitles() {
		const coverIds = categories.map((category) => category.cover_photo).filter(Boolean);
		const entries = await Promise.all(
			coverIds.map(async (id) => {
				try {
					const result = await adminFetch(`/api/archivos-nava/admin/photos/${encodeURIComponent(id)}`);
					return [id, photoTitle(result.record)];
				} catch {
					return [id, 'Portada no disponible'];
				}
			}),
		);

		coverPhotoTitles = Object.fromEntries(entries);
	}

	async function loadCategories() {
		isLoading = true;
		setMessage('Cargando categorías...');
		try {
			categories = await loadAdminCategories();
			await loadCoverPhotoTitles();
			renderCategories();
			setMessage('');
		} catch (error) {
			if (error?.authError) return;
			categories = [];
			renderCategories();
			setMessage(resolveError(error), 'error');
		} finally {
			isLoading = false;
		}
	}

	async function saveCategory(event) {
		event.preventDefault();
		if (!(form instanceof HTMLFormElement) || isLoading) return;

		const submitButton = form.querySelector('button[type="submit"]');
		const data = new FormData(form);
		const id = String(data.get('id') || '').trim();
		const name = String(data.get('name') || '').trim();
		const rawSlug = String(data.get('slug') || '').trim();
		const slug = rawSlug ? normalizeSlug(rawSlug) : '';
		const sortOrder = String(data.get('sort_order') || '').trim();

		if (!name) {
			setMessage('Escribí un nombre.', 'error');
			return;
		}

		if (rawSlug && !slug) {
			setMessage('El slug no puede quedar vacío.', 'error');
			return;
		}

		if (sortOrder && !Number.isInteger(Number(sortOrder))) {
			setMessage('El orden tiene que ser un número entero.', 'error');
			return;
		}

		const payload = {
			name,
			slug,
			description: String(data.get('description') || '').trim(),
			active: activeInput instanceof HTMLInputElement ? activeInput.checked : true,
		};

		if (sortOrder) payload.sort_order = Number(sortOrder);

		if (submitButton instanceof HTMLButtonElement) {
			submitButton.disabled = true;
			submitButton.textContent = 'Guardando...';
		}

		try {
			if (id) {
				await adminFetch(`/api/archivos-nava/admin/categories/${encodeURIComponent(id)}`, {
					method: 'PATCH',
					body: JSON.stringify(payload),
				});
				if (selectedCategory && coverPhotoSelect instanceof HTMLSelectElement && coverOptionsLoaded && coverSelectionDirty) {
					await adminFetch(`/api/archivos-nava/admin/categories/${encodeURIComponent(id)}/cover`, {
						method: 'PATCH',
						body: JSON.stringify({
							photo: coverPhotoSelect.value,
						}),
					});
				}
				await loadCategories();
				setFormMode(null, false);
				setMessage('Categoría actualizada.', 'success');
			} else {
				await adminFetch('/api/archivos-nava/admin/categories', {
					method: 'POST',
					body: JSON.stringify(payload),
				});
				await loadCategories();
				setFormMode(null, false);
				setMessage('Categoría creada.', 'success');
			}
		} catch (error) {
			if (error?.authError) return;
			setMessage(resolveError(error), 'error');
		} finally {
			if (submitButton instanceof HTMLButtonElement) {
				submitButton.disabled = false;
				submitButton.textContent = 'Guardar';
			}
		}
	}

	async function toggleCategory(category) {
		try {
			await adminFetch(`/api/archivos-nava/admin/categories/${encodeURIComponent(category.id)}/toggle`, {
				method: 'PATCH',
			});
			await loadCategories();
			setMessage(category.active ? 'Categoría desactivada.' : 'Categoría activada.', 'success');
		} catch (error) {
			if (error?.authError) return;
			setMessage(resolveError(error), 'error');
		}
	}

	async function updateSortOrder(category, sortOrder) {
		await adminFetch(`/api/archivos-nava/admin/categories/${encodeURIComponent(category.id)}`, {
			method: 'PATCH',
			body: JSON.stringify({
				sort_order: sortOrder,
			}),
		});
	}

	async function moveCategory(category, direction) {
		const visibleCategories = categories.filter((item) => !item.isTechnical);
		const index = visibleCategories.findIndex((item) => item.id === category.id);
		const target = visibleCategories[index + direction];
		if (!target) return;

		const currentOrder = Number(category.sort_order) || 0;
		const targetOrder = Number(target.sort_order) || 0;

		try {
			await Promise.all([
				updateSortOrder(category, targetOrder),
				updateSortOrder(target, currentOrder),
			]);
			await loadCategories();
			setMessage('Orden actualizado.', 'success');
		} catch (error) {
			if (error?.authError) return;
			setMessage(resolveError(error), 'error');
		}
	}

	async function deleteCategory(category) {
		const confirmed = window.confirm(`¿Eliminar "${categoryLabel(category)}"? Las fotos asociadas pasarán a papelera y no se borrarán de Cloudinary.`);
		if (!confirmed) return;

		try {
			const result = await adminFetch(`/api/archivos-nava/admin/categories/${encodeURIComponent(category.id)}`, {
				method: 'DELETE',
			});
			const count = Number(result.trashedPhotos) || 0;
			await loadCategories();
			setFormMode(null, false);
			setMessage(count ? `Categoría eliminada. ${count} foto${count === 1 ? '' : 's'} enviada${count === 1 ? '' : 's'} a papelera.` : 'Categoría eliminada.', 'success');
		} catch (error) {
			if (error?.authError) return;
			setMessage(resolveError(error), 'error');
		}
	}

	nameInput?.addEventListener('blur', () => {
		if (!(slugInput instanceof HTMLInputElement) || slugInput.value.trim()) return;
		if (nameInput instanceof HTMLInputElement) slugInput.value = normalizeSlug(nameInput.value);
	});

	newButton?.addEventListener('click', () => setFormMode());
	cancelButton?.addEventListener('click', () => setFormMode());
	coverPhotoSelect?.addEventListener('change', () => {
		if (coverOptionsLoaded) {
			coverSelectionDirty = true;
			updateCoverUI();
		}
	});

	openCoverPickerButton?.addEventListener('click', () => {
		if (!coverOptionsLoaded) return;
		if (coverPickerPanel instanceof HTMLElement) {
			coverPickerPanel.hidden = !coverPickerPanel.hidden;
			if (!coverPickerPanel.hidden) renderCoverPickerList();
		}
	});

	closeCoverPickerButton?.addEventListener('click', () => {
		if (coverPickerPanel instanceof HTMLElement) coverPickerPanel.hidden = true;
	});

	pickerAutoButton?.addEventListener('click', () => {
		selectCoverPhoto('');
	});

	clearCoverButton?.addEventListener('click', () => {
		selectCoverPhoto('');
	});

	form?.addEventListener('submit', saveCategory);

	requireAdminSession().then((isValid) => {
		if (isValid) {
			setFormMode();
			loadCategories();
		}
	});
</script>

