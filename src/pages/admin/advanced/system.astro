---
import Layout from '../../../layouts/Layout.astro';
import AdminShell from '../../../components/AdminShell.astro';
import OwnerNav from '../../../components/OwnerNav.astro';
---

<Layout title="Nube y Almacenamiento">
	<AdminShell title="Nube y Almacenamiento" active="system" eyebrow="Configuración avanzada">
		<OwnerNav active="system" />

		<p class="system-intro">
			Monitoreo en tiempo real del uso de almacenamiento en la nube (Cloudinary) y estado de la base de datos local.
		</p>

		<p id="system-status" role="status" aria-live="polite">Cargando métricas del sistema…</p>
		<button id="retry-system" class="secondary-button" type="button" hidden>Volver a cargar</button>

		<div id="system-content" hidden>
			<!-- Cloudinary Cloud Storage Section -->
			<section class="system-card" aria-labelledby="cloud-heading">
				<div class="card-header">
					<div>
						<h2 id="cloud-heading">Almacenamiento Cloudinary</h2>
						<p class="card-subtitle">Servicio CDN y almacenamiento remoto para el archivo fotográfico.</p>
					</div>
					<div id="connection-badge" class="badge">Comprobando…</div>
				</div>

				<div id="cloud-error-box" class="error-banner" hidden></div>

				<div class="stats-grid">
					<div class="stat-box">
						<span class="stat-label">Espacio consumido</span>
						<span class="stat-value" id="cloud-storage-used">—</span>
						<span class="stat-meta" id="cloud-storage-meta">Créditos de almacenamiento</span>
					</div>
					<div class="stat-box">
						<span class="stat-label">Archivos en la nube</span>
						<span class="stat-value" id="cloud-objects-count">—</span>
						<span class="stat-meta">Recursos fotográficos</span>
					</div>
					<div class="stat-box">
						<span class="stat-label">Ancho de banda mensual</span>
						<span class="stat-value" id="cloud-bandwidth-used">—</span>
						<span class="stat-meta">Tráfico de visualizaciones</span>
					</div>
					<div class="stat-box">
						<span class="stat-label">Transformaciones</span>
						<span class="stat-value" id="cloud-transformations-count">—</span>
						<span class="stat-meta">Miniaturas y optimizaciones</span>
					</div>
				</div>

				<!-- Credits Gauge -->
				<div class="gauge-section">
					<div class="gauge-header">
						<span>Cuota mensual consumida (Créditos del plan)</span>
						<span id="credits-percent" class="gauge-percent">0%</span>
					</div>
					<div class="gauge-bar-track">
						<div id="credits-bar" class="gauge-bar-fill" style="width: 0%"></div>
					</div>
					<p class="field-help" id="cloud-plan-info">Plan Cloudinary: —</p>
				</div>
			</section>

			<!-- Local Database and Archive Overview -->
			<section class="system-card" aria-labelledby="catalog-heading">
				<div class="card-header">
					<div>
						<h2 id="catalog-heading">Catálogo Local y Respaldo</h2>
						<p class="card-subtitle">Registros en SQLite y copias de seguridad del servidor.</p>
					</div>
				</div>

				<div class="stats-grid">
					<div class="stat-box">
						<span class="stat-label">Total en catálogo</span>
						<span class="stat-value" id="total-photos">—</span>
						<span class="stat-meta" id="photos-breakdown">0 pub · 0 borrador · 0 papelera</span>
					</div>
					<div class="stat-box">
						<span class="stat-label">Categorías</span>
						<span class="stat-value" id="total-categories">—</span>
						<span class="stat-meta" id="categories-meta">0 activas</span>
					</div>
					<div class="stat-box">
						<span class="stat-label">Copias de seguridad</span>
						<span class="stat-value" id="total-backups">—</span>
						<span class="stat-meta" id="backups-size">0 MB acumulados</span>
					</div>
				</div>

				<div class="card-actions">
					<a href="/admin/advanced/backups" class="secondary-button link-button">
						Gestionar copias de seguridad
					</a>
					<button id="refresh-button" type="button" class="primary-button">
						Actualizar métricas
					</button>
				</div>
			</section>
		</div>
	</AdminShell>
</Layout>

<script>
	import { pb } from '../../../lib/pocketbase';
	import { adminFetch, requireAdminSession } from '../../../lib/admin';

	interface CloudinaryUsage {
		configured: boolean;
		connected: boolean;
		cloud_name?: string;
		plan?: string;
		last_updated?: string;
		storage?: { used_bytes: number; credits_usage: number };
		objects?: { count: number };
		bandwidth?: { used_bytes: number; credits_usage: number };
		transformations?: { count: number; credits_usage: number };
		credits?: { used: number; percent: number };
		error?: string;
	}

	interface SystemOverview {
		photos: { total: number; published: number; draft: number; trash: number };
		categories: { total: number; active: number };
		backups: { count: number; total_bytes: number; latest: string | null };
		cloudinary_configured: boolean;
	}

	const status = document.querySelector('#system-status') as HTMLParagraphElement;
	const content = document.querySelector('#system-content') as HTMLDivElement;
	const retry = document.querySelector('#retry-system') as HTMLButtonElement;
	const refreshBtn = document.querySelector('#refresh-button') as HTMLButtonElement;
	const connectionBadge = document.querySelector('#connection-badge') as HTMLDivElement;
	const errorBox = document.querySelector('#cloud-error-box') as HTMLDivElement;

	const storageUsed = document.querySelector('#cloud-storage-used') as HTMLSpanElement;
	const storageMeta = document.querySelector('#cloud-storage-meta') as HTMLSpanElement;
	const objectsCount = document.querySelector('#cloud-objects-count') as HTMLSpanElement;
	const bandwidthUsed = document.querySelector('#cloud-bandwidth-used') as HTMLSpanElement;
	const transformationsCount = document.querySelector('#cloud-transformations-count') as HTMLSpanElement;
	const creditsPercent = document.querySelector('#credits-percent') as HTMLSpanElement;
	const creditsBar = document.querySelector('#credits-bar') as HTMLDivElement;
	const planInfo = document.querySelector('#cloud-plan-info') as HTMLParagraphElement;

	const totalPhotos = document.querySelector('#total-photos') as HTMLSpanElement;
	const photosBreakdown = document.querySelector('#photos-breakdown') as HTMLSpanElement;
	const totalCategories = document.querySelector('#total-categories') as HTMLSpanElement;
	const categoriesMeta = document.querySelector('#categories-meta') as HTMLSpanElement;
	const totalBackups = document.querySelector('#total-backups') as HTMLSpanElement;
	const backupsSize = document.querySelector('#backups-size') as HTMLSpanElement;

	function formatBytes(bytes: number): string {
		if (!bytes || bytes <= 0) return '0 B';
		const units = ['B', 'KB', 'MB', 'GB', 'TB'];
		const i = Math.floor(Math.log(bytes) / Math.log(1024));
		const val = bytes / Math.pow(1024, i);
		return `${val.toFixed(i === 0 ? 0 : 1)} ${units[i]}`;
	}

	function message(text: string, error = false) {
		status.textContent = text;
		status.dataset.error = String(error);
	}

	async function loadMetrics() {
		retry.hidden = true;
		if (!(await requireAdminSession())) return;
		if (pb.authStore.record?.role !== 'owner') {
			message('Acceso denegado. Esta sección está reservada al propietario del sitio.', true);
			return;
		}

		message('Consultando estado del servidor y Cloudinary…');

		try {
			const [usage, overview] = await Promise.all([
				adminFetch<CloudinaryUsage>('/api/archivos-nava/admin/system/cloudinary-usage'),
				adminFetch<SystemOverview>('/api/archivos-nava/admin/system/overview'),
			]);

			// 1. Render Cloudinary Usage
			if (usage.connected) {
				connectionBadge.textContent = `Conectado (${usage.cloud_name || 'Nube activa'})`;
				connectionBadge.className = 'badge badge-success';
				errorBox.hidden = true;

				storageUsed.textContent = formatBytes(usage.storage?.used_bytes || 0);
				storageMeta.textContent = `${(usage.storage?.credits_usage || 0).toFixed(2)} créditos`;

				objectsCount.textContent = (usage.objects?.count || 0).toLocaleString();
				bandwidthUsed.textContent = formatBytes(usage.bandwidth?.used_bytes || 0);
				transformationsCount.textContent = (usage.transformations?.count || 0).toLocaleString();

				const percent = Math.min(100, Math.max(0, usage.credits?.percent || 0));
				creditsPercent.textContent = `${percent.toFixed(1)}%`;
				creditsBar.style.width = `${percent}%`;

				planInfo.textContent = `Plan: ${usage.plan || 'Free'} · Créditos usados: ${(usage.credits?.used || 0).toFixed(2)}`;
			} else {
				connectionBadge.textContent = usage.configured ? 'Error de conexión' : 'No configurado';
				connectionBadge.className = usage.configured ? 'badge badge-error' : 'badge badge-warning';
				errorBox.hidden = false;
				errorBox.textContent = usage.error || 'No se pudo comunicar con la API de Cloudinary.';

				storageUsed.textContent = '—';
				objectsCount.textContent = '—';
				bandwidthUsed.textContent = '—';
				transformationsCount.textContent = '—';
				creditsPercent.textContent = '—';
				creditsBar.style.width = '0%';
				planInfo.textContent = 'Configura las credenciales de Cloudinary en el archivo .env del servidor.';
			}

			// 2. Render Overview
			totalPhotos.textContent = (overview.photos?.total || 0).toLocaleString();
			photosBreakdown.textContent = `${overview.photos?.published || 0} pub · ${overview.photos?.draft || 0} borrador · ${overview.photos?.trash || 0} papelera`;

			totalCategories.textContent = (overview.categories?.total || 0).toLocaleString();
			categoriesMeta.textContent = `${overview.categories?.active || 0} activas`;

			totalBackups.textContent = (overview.backups?.count || 0).toLocaleString();
			backupsSize.textContent = `${formatBytes(overview.backups?.total_bytes || 0)} acumulados`;

			content.hidden = false;
			message('');
		} catch (err) {
			message('No se pudieron obtener las métricas del sistema. Vuelve a intentarlo.', true);
			retry.hidden = false;
		}
	}

	retry.addEventListener('click', loadMetrics);
	refreshBtn.addEventListener('click', loadMetrics);

	void loadMetrics();
</script>

<style>
	.system-intro {
		color: #bbb;
		line-height: 1.6;
		margin-bottom: 24px;
	}

	#system-status {
		min-height: 1.5em;
		line-height: 1.5;
		color: #d5e7c9;
	}

	#system-status[data-error='true'] {
		color: #ffb5aa;
	}

	#system-content {
		display: flex;
		flex-direction: column;
		gap: 28px;
	}

	.system-card {
		padding: clamp(20px, 3vw, 32px);
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 8px;
		background: #181817;
	}

	.card-header {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		justify-content: space-between;
		gap: 16px;
		margin-bottom: 24px;
	}

	.card-header h2 {
		margin: 0 0 6px;
		font-size: 1.25rem;
		color: #fff;
	}

	.card-subtitle {
		margin: 0;
		font-size: 0.88rem;
		color: rgba(245, 245, 245, 0.65);
	}

	.badge {
		display: inline-flex;
		align-items: center;
		padding: 4px 12px;
		border-radius: 999px;
		font-size: 0.82rem;
		font-weight: 600;
		letter-spacing: 0.02em;
	}

	.badge-success {
		background: rgba(85, 170, 85, 0.15);
		color: #85e085;
		border: 1px solid rgba(85, 170, 85, 0.35);
	}

	.badge-warning {
		background: rgba(220, 160, 40, 0.15);
		color: #f0c050;
		border: 1px solid rgba(220, 160, 40, 0.35);
	}

	.badge-error {
		background: rgba(220, 70, 70, 0.15);
		color: #ff8888;
		border: 1px solid rgba(220, 70, 70, 0.35);
	}

	.error-banner {
		padding: 12px 16px;
		margin-bottom: 20px;
		border-radius: 6px;
		background: rgba(220, 70, 70, 0.12);
		border: 1px solid rgba(220, 70, 70, 0.3);
		color: #ffb5aa;
		font-size: 0.9rem;
	}

	.stats-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 16px;
		margin-bottom: 24px;
	}

	.stat-box {
		padding: 16px;
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.06);
		border-radius: 6px;
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.stat-label {
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: rgba(245, 245, 245, 0.55);
	}

	.stat-value {
		font-size: 1.6rem;
		font-weight: 700;
		color: #ffffff;
		margin: 4px 0 2px;
	}

	.stat-meta {
		font-size: 0.8rem;
		color: rgba(245, 245, 245, 0.5);
	}

	.gauge-section {
		padding-top: 16px;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
	}

	.gauge-header {
		display: flex;
		justify-content: space-between;
		font-size: 0.88rem;
		color: rgba(245, 245, 245, 0.8);
		margin-bottom: 8px;
	}

	.gauge-percent {
		font-weight: 700;
		color: #fff;
	}

	.gauge-bar-track {
		width: 100%;
		height: 8px;
		background: rgba(255, 255, 255, 0.1);
		border-radius: 999px;
		overflow: hidden;
		margin-bottom: 8px;
	}

	.gauge-bar-fill {
		height: 100%;
		background: #85e085;
		border-radius: 999px;
		transition: width 0.4s ease;
	}

	.field-help {
		font-size: 0.82rem;
		color: rgba(245, 245, 245, 0.5);
		margin: 0;
	}

	.card-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 16px;
		margin-top: 20px;
	}

	.link-button {
		display: inline-flex;
		align-items: center;
		text-decoration: none;
	}
</style>
