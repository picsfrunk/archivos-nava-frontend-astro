---
import Layout from '../../layouts/Layout.astro';
---

<Layout
	title="Ingresar | ARCHIVOS NAVA"
	description="Acceso administrativo de ARCHIVOS NAVA."
>
	<main class="admin-login">
		<section class="login-panel" aria-labelledby="login-title">
			<div class="login-brand-row">
				<a href="/" class="brand">
					<span class="brand-mark" aria-hidden="true">▣</span>
					<span>ARCHIVOS NAVA</span>
				</a>
				<span class="login-stamp">ACCESO CURADURÍA</span>
			</div>

			<div class="login-heading">
				<p class="eyebrow">Panel administrativo</p>
				<h1 id="login-title">Ingresar al archivo</h1>
			</div>

			<form id="login-form" novalidate>
				<label>
					<span>Email o usuario</span>
					<input
						id="identity"
						name="identity"
						type="text"
						autocomplete="username"
						required
					/>
				</label>

				<label>
					<span>Contraseña</span>
					<input
						id="password"
						name="password"
						type="password"
						autocomplete="current-password"
						required
					/>
				</label>

				<button type="submit">Entrar</button>
			</form>

			<p id="login-message" class="message" role="status" aria-live="polite"></p>
		</section>
	</main>
</Layout>

<script>
	import { pb } from '../../lib/pocketbase';

	const form = document.querySelector('#login-form');
	const message = document.querySelector('#login-message');

	function setMessage(text, type = 'neutral') {
		if (!(message instanceof HTMLElement)) return;

		message.textContent = text;
		message.dataset.type = type;
	}

	function isAdminSession() {
		return pb.authStore.model?.collectionName === 'admins';
	}

	const urlParams = new URLSearchParams(window.location.search);
	const isExpired = urlParams.get('expired') === '1';
	const rawRedirect = urlParams.get('redirect') || '';
	const safeRedirect = (rawRedirect.startsWith('/admin') && !rawRedirect.startsWith('/admin/login'))
		? rawRedirect
		: '/admin/photos';

	if (pb.authStore.isValid && isAdminSession()) {
		window.location.href = safeRedirect;
	} else if (pb.authStore.token) {
		pb.authStore.clear();
	}

	if (isExpired) {
		setMessage('Tu sesión ha expirado. Por favor, ingresá nuevamente.', 'error');
	}

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();

		if (!(form instanceof HTMLFormElement)) return;

		const submitButton = form.querySelector('button[type="submit"]');
		const data = new FormData(form);
		const identity = String(data.get('identity') || '').trim();
		const password = String(data.get('password') || '');

		if (!identity || !password) {
			setMessage('Completá usuario y contraseña.', 'error');
			return;
		}

		if (submitButton instanceof HTMLButtonElement) {
			submitButton.disabled = true;
			submitButton.textContent = 'Ingresando...';
		}

		setMessage('');

		try {
			await pb.collection('admins').authWithPassword(identity, password);
			window.location.href = safeRedirect;
		} catch {
			pb.authStore.clear();
			setMessage('No se pudo iniciar sesión. Revisá las credenciales.', 'error');
		} finally {
			if (submitButton instanceof HTMLButtonElement) {
				submitButton.disabled = false;
				submitButton.textContent = 'Entrar';
			}
		}
	});
</script>

<style>
	.admin-login {
		display: grid;
		place-items: center;
		min-height: 100vh;
		padding: 32px;
		background:
			radial-gradient(ellipse 70% 50% at 50% 20%, rgba(223, 169, 96, 0.14), transparent 70%),
			linear-gradient(rgba(13, 12, 10, 0.8), rgba(13, 12, 10, 0.94));
	}

	.login-panel {
		width: min(100%, 430px);
		padding: 32px;
		border: 1px solid var(--border);
		border-top: 3px solid var(--accent);
		border-radius: var(--radius-md);
		background: var(--surface-card);
		box-shadow: var(--shadow-md);
	}

	.login-brand-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		margin-bottom: 36px;
		padding-bottom: 14px;
		border-bottom: 1px dashed var(--border);
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.16em;
	}

	.brand-mark {
		display: inline-grid;
		place-items: center;
		width: 26px;
		height: 26px;
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-xs);
		background: var(--accent-subtle);
		color: var(--accent);
	}

	.login-stamp {
		font-family: var(--font-mono);
		font-size: 0.64rem;
		letter-spacing: 0.12em;
		color: var(--film-stamp);
	}

	.eyebrow {
		margin: 0 0 6px;
		color: var(--film-stamp);
		font-family: var(--font-mono);
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font-family: var(--font-serif);
		font-size: 2.1rem;
		font-weight: 500;
	}

	form {
		display: grid;
		gap: 18px;
		margin-top: 28px;
	}

	label {
		display: grid;
		gap: 8px;
		color: var(--text-secondary);
		font-size: 0.88rem;
		font-weight: 500;
	}

	input {
		width: 100%;
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		padding: 12px 14px;
		color: var(--text);
		background: var(--surface);
		outline: none;
		transition: border-color 150ms ease, box-shadow 150ms ease;
	}

	input:focus {
		border-color: var(--accent);
		box-shadow: 0 0 0 2px var(--accent-subtle);
	}

	button {
		margin-top: 6px;
		border: 1px solid var(--accent);
		border-radius: var(--radius-sm);
		padding: 12px 18px;
		color: #14110d;
		background: var(--accent);
		font-weight: 600;
		cursor: pointer;
		transition: background-color 150ms ease;
	}

	button:hover:not(:disabled) {
		background: var(--accent-strong);
	}

	button:disabled {
		cursor: wait;
		opacity: 0.68;
	}

	.message {
		min-height: 1.5em;
		margin: 18px 0 0;
		color: var(--text-secondary);
		font-size: 0.9rem;
		line-height: 1.5;
	}

	.message[data-type="error"] {
		color: var(--danger);
	}

	@media (max-width: 540px) {
		.admin-login {
			padding: 18px;
		}

		.login-panel {
			padding: 24px;
		}
	}
</style>
