---
import Layout from '../../layouts/Layout.astro';
---

<Layout
	title="Ingresar | ARCHIVOS NAVA"
	description="Acceso administrativo de ARCHIVOS NAVA."
>
	<main class="admin-login">
		<section class="login-panel" aria-labelledby="login-title">
			<a href="/" class="brand">ARCHIVOS NAVA</a>

			<div>
				<p class="eyebrow">Panel administrativo</p>
				<h1 id="login-title">Ingresar</h1>
			</div>

			<form id="login-form" novalidate>
				<label>
					<span>Email o usuario</span>
					<input
						id="identity"
						name="identity"
						type="text"
						autocomplete="username"
						required
					/>
				</label>

				<label>
					<span>Contraseña</span>
					<input
						id="password"
						name="password"
						type="password"
						autocomplete="current-password"
						required
					/>
				</label>

				<button type="submit">Entrar</button>
			</form>

			<p id="login-message" class="message" role="status" aria-live="polite"></p>
		</section>
	</main>
</Layout>

<script>
	import { pb } from '../../lib/pocketbase';

	const form = document.querySelector('#login-form');
	const message = document.querySelector('#login-message');

	function setMessage(text, type = 'neutral') {
		if (!(message instanceof HTMLElement)) return;

		message.textContent = text;
		message.dataset.type = type;
	}

	function isAdminSession() {
		return pb.authStore.model?.collectionName === 'admins';
	}

	const urlParams = new URLSearchParams(window.location.search);
	const isExpired = urlParams.get('expired') === '1';
	const rawRedirect = urlParams.get('redirect') || '';
	const safeRedirect = (rawRedirect.startsWith('/admin') && !rawRedirect.startsWith('/admin/login'))
		? rawRedirect
		: '/admin/photos';

	if (pb.authStore.isValid && isAdminSession()) {
		window.location.href = safeRedirect;
	} else if (pb.authStore.token) {
		pb.authStore.clear();
	}

	if (isExpired) {
		setMessage('Tu sesión ha expirado. Por favor, ingresá nuevamente.', 'error');
	}

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();

		if (!(form instanceof HTMLFormElement)) return;

		const submitButton = form.querySelector('button[type="submit"]');
		const data = new FormData(form);
		const identity = String(data.get('identity') || '').trim();
		const password = String(data.get('password') || '');

		if (!identity || !password) {
			setMessage('Completá usuario y contraseña.', 'error');
			return;
		}

		if (submitButton instanceof HTMLButtonElement) {
			submitButton.disabled = true;
			submitButton.textContent = 'Ingresando...';
		}

		setMessage('');

		try {
			await pb.collection('admins').authWithPassword(identity, password);
			window.location.href = safeRedirect;
		} catch {
			pb.authStore.clear();
			setMessage('No se pudo iniciar sesión. Revisá las credenciales.', 'error');
		} finally {
			if (submitButton instanceof HTMLButtonElement) {
				submitButton.disabled = false;
				submitButton.textContent = 'Entrar';
			}
		}
	});
</script>

<style>
	.admin-login {
		display: grid;
		place-items: center;
		min-height: 100vh;
		padding: 32px;
		background:
			linear-gradient(rgba(11, 11, 11, 0.72), rgba(11, 11, 11, 0.92)),
			url('/images/photo-02.jpg') center / cover;
	}

	.login-panel {
		width: min(100%, 420px);
		padding: 32px;
		border: 1px solid rgba(255, 255, 255, 0.14);
		border-radius: 8px;
		background: rgba(11, 11, 11, 0.82);
		box-shadow: 0 24px 80px rgba(0, 0, 0, 0.38);
	}

	.brand {
		display: inline-block;
		margin-bottom: 56px;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.18em;
	}

	.eyebrow {
		margin: 0 0 8px;
		color: rgba(245, 245, 245, 0.58);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font-size: 2rem;
		font-weight: 500;
	}

	form {
		display: grid;
		gap: 18px;
		margin-top: 32px;
	}

	label {
		display: grid;
		gap: 8px;
		color: rgba(245, 245, 245, 0.72);
		font-size: 0.9rem;
	}

	input {
		width: 100%;
		border: 1px solid rgba(255, 255, 255, 0.16);
		border-radius: 6px;
		padding: 12px 14px;
		color: #f5f5f5;
		background: rgba(255, 255, 255, 0.08);
		outline: none;
	}

	input:focus {
		border-color: rgba(255, 255, 255, 0.52);
	}

	button {
		margin-top: 8px;
		border-radius: 6px;
		padding: 12px 16px;
		color: #101010;
		background: #f5f5f5;
		cursor: pointer;
	}

	button:disabled {
		cursor: wait;
		opacity: 0.68;
	}

	.message {
		min-height: 1.5em;
		margin: 18px 0 0;
		color: rgba(245, 245, 245, 0.72);
		font-size: 0.9rem;
		line-height: 1.5;
	}

	.message[data-type="error"] {
		color: #ffb4a9;
	}

	@media (max-width: 540px) {
		.admin-login {
			padding: 18px;
		}

		.login-panel {
			padding: 24px;
		}
	}
</style>
