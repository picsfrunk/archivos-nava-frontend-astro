---
import PhotoCard from '../components/PhotoCard.astro';
import PublicShell from '../components/PublicShell.astro';
import Layout from '../layouts/Layout.astro';
import { displayYear, getHomeCoverPhoto, getRecentPublicPhotos, previewUrl, photoAlt, photoLabel } from '../lib/public-gallery';

const photos = await getRecentPublicPhotos(4);
const homeCoverPhoto = await getHomeCoverPhoto();
const primaryPhoto = homeCoverPhoto ?? photos[0] ?? null;
const primaryPhotoYear = primaryPhoto ? displayYear(primaryPhoto.year) : '';
const recentPhotos = photos.filter((photo) => photo.id !== primaryPhoto?.id).slice(0, 3);
---

<Layout
	title="ARCHIVOS NAVA"
	description="Archivo fotográfico familiar: recuerdos, escenas y registros preservados en una galería pública."
>
	<PublicShell items={[{ href: '/', label: 'Inicio', active: true }, { href: '/gallery', label: 'Galería' }]}>
		<main>
			<section class="hero" aria-labelledby="home-title">
				<div class="intro">
					<p class="kicker">Archivo fotográfico</p>
					<h1 id="home-title">ARCHIVOS NAVA</h1>
					<p>
						Fotografías familiares y registros personales preservados con una lectura clara,
						ordenada por categorías y pensada para volver a mirar.
					</p>
					<a class="primary-link" href="/gallery">Entrar a la galería</a>
				</div>

				{primaryPhoto && (
					<a class="primary-photo" href={`/photo/${primaryPhoto.id}`} aria-label={photoLabel(primaryPhoto)}>
						<img src={previewUrl(primaryPhoto.image)} alt={photoAlt(primaryPhoto)} />
						<span>
							<strong>{photoLabel(primaryPhoto)}</strong>
							{primaryPhotoYear ? <em>{primaryPhotoYear}</em> : null}
						</span>
					</a>
				)}
			</section>

			{recentPhotos.length > 0 && (
				<section class="recent" aria-labelledby="recent-title">
					<div class="section-heading">
						<h2 id="recent-title">Recientes</h2>
						<a href="/gallery">Ver galería</a>
					</div>
					<div class="recent-grid">
						{recentPhotos.map((photo) => <PhotoCard photo={photo} showCategory />)}
					</div>
				</section>
			)}
		</main>
	</PublicShell>
</Layout>

<style>
	main {
		width: 100%;
	}

	.hero {
		display: grid;
		grid-template-columns: minmax(280px, 0.75fr) minmax(320px, 1fr);
		align-items: center;
		gap: clamp(36px, 7vw, 92px);
		min-height: calc(100vh - 74px);
		padding: clamp(44px, 7vw, 86px) clamp(18px, 5vw, 72px);
	}

	.intro {
		max-width: 560px;
	}

	.kicker {
		margin: 0 0 18px;
		color: rgba(245, 245, 245, 0.56);
		font-size: 0.78rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font-size: clamp(2.7rem, 7vw, 6.9rem);
		font-weight: 560;
		line-height: 0.92;
	}

	.intro p:not(.kicker) {
		max-width: 38rem;
		margin: 28px 0 0;
		color: rgba(245, 245, 245, 0.72);
		font-size: clamp(1rem, 1.6vw, 1.18rem);
		line-height: 1.7;
	}

	.primary-link {
		display: inline-flex;
		margin-top: 30px;
		border-bottom: 1px solid rgba(245, 245, 245, 0.7);
		padding-bottom: 5px;
		color: #f5f5f5;
		font-size: 0.92rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.primary-photo {
		display: grid;
		gap: 14px;
	}

	.primary-photo img {
		width: 100%;
		max-height: 74vh;
		object-fit: contain;
		background: #141414;
	}

	.primary-photo span {
		display: flex;
		justify-content: space-between;
		gap: 16px;
		color: rgba(245, 245, 245, 0.64);
		font-size: 0.9rem;
		line-height: 1.4;
	}

	.primary-photo strong {
		color: #f5f5f5;
		font-weight: 520;
	}

	.primary-photo em {
		font-style: normal;
	}

	.recent {
		padding: 0 clamp(18px, 5vw, 72px) 72px;
	}

	.section-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 20px;
		margin-bottom: 22px;
	}

	.section-heading h2 {
		margin: 0;
		font-size: 1.15rem;
		font-weight: 520;
	}

	.section-heading a {
		color: rgba(245, 245, 245, 0.64);
		font-size: 0.86rem;
	}

	.recent-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 22px;
	}

	@media (max-width: 820px) {
		.hero {
			grid-template-columns: 1fr;
			min-height: auto;
		}

		.primary-photo img {
			max-height: 58vh;
		}

		.recent-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
