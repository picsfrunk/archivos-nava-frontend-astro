---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="ARCHIVOS NAVA"
	description="Un archivo de recuerdos, fotografías y pequeñas historias que merecen ser recordadas."
>
	<header class="site-header">
		<a href="/" class="brand">ARCHIVOS NAVA</a>

		<nav aria-label="Navegación principal">
			<a href="/">Inicio</a>
			<a href="/gallery">Galería</a>
			<a href="/about">Acerca de</a>
			<a href="/contact">Contacto</a>
		</nav>
	</header>

	<main class="home">
		<section class="photo-stage" aria-label="Fotografía destacada">
			<div class="photo-container">
				<img
					src="/images/photo-01.jpg"
					alt="Fotografía de archivo"
				/>
			</div>

			<div class="photo-info">
				<h1>Título de la fotografía</h1>
				<p class="year">1987</p>
				<p class="subtitle">
					Una breve descripción que introduce la historia
					detrás de esta fotografía.
				</p>
			</div>

			<div class="navigation-controls" aria-hidden="true">
				<button type="button" aria-label="Fotografía anterior">
					<span>‹</span>
				</button>

				<button type="button" aria-label="Fotografía siguiente">
					<span>›</span>
				</button>
			</div>
		</section>
	</main>
</Layout>

<style>
	.site-header {
		position: fixed;
		top: 0;
		left: 0;
		z-index: 10;

		display: flex;
		align-items: center;
		justify-content: space-between;

		width: 100%;
		padding: 28px 40px;
	}

	.brand {
		font-size: 1rem;
		font-weight: 600;
		letter-spacing: 0.18em;
	}

	nav {
		display: flex;
		gap: 28px;
	}

	nav a {
		font-size: 0.9rem;
		letter-spacing: 0.08em;
		opacity: 0.65;
		transition: opacity 180ms ease;
	}

	nav a:hover {
		opacity: 1;
	}

	.home {
		min-height: 100vh;
	}

	.photo-stage {
		position: relative;

		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;

		min-height: 100vh;
		padding: 100px 40px 60px;
	}

	.photo-container {
		max-width: min(1100px, 88vw);
		max-height: 72vh;
	}

	.photo-container img {
		width: auto;
		height: auto;
		max-width: 100%;
		max-height: 72vh;

		object-fit: contain;
	}

	.photo-info {
		margin-top: 28px;
		text-align: center;
	}

	.photo-info h1 {
		margin: 0;

		font-size: clamp(1.15rem, 1.8vw, 1.7rem);
		font-weight: 500;
		letter-spacing: 0.04em;
	}

	.year {
		margin: 7px 0 0;

		font-size: 0.85rem;
		letter-spacing: 0.14em;
		opacity: 0.55;
	}

	.subtitle {
		max-width: 560px;
		margin: 12px auto 0;

		font-size: 0.95rem;
		line-height: 1.65;
		opacity: 0.65;
	}

	.navigation-controls {
		position: absolute;
		inset: 0;

		display: flex;
		align-items: center;
		justify-content: space-between;

		padding: 0 28px;

		pointer-events: none;
	}

	.navigation-controls button {
		display: grid;
		place-items: center;

		width: 48px;
		height: 48px;

		color: white;
		background: transparent;

		font-size: 2rem;
		cursor: pointer;

		opacity: 0;
		transition:
			opacity 180ms ease,
			transform 180ms ease;

		pointer-events: auto;
	}

	.navigation-controls button:hover {
		transform: scale(1.12);
	}

	.photo-stage:hover .navigation-controls button {
		opacity: 0.65;
	}

	@media (max-width: 700px) {
		.site-header {
			padding: 22px 20px;
		}

		nav {
			gap: 14px;
		}

		nav a {
			font-size: 0.65rem;
		}

		.photo-stage {
			padding: 90px 20px 40px;
		}

		.photo-container {
			max-width: 94vw;
			max-height: 70vh;
		}

		.photo-container img {
			max-height: 70vh;
		}

		.photo-info {
			margin-top: 20px;
		}

		.subtitle {
			max-width: 90vw;
		}

		.navigation-controls {
			padding: 0 8px;
		}
	}
</style>