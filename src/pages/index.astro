---
import { getSiteSettings } from '../lib/site-settings';
const settings = await getSiteSettings(Astro.request);
import PhotoCard from '../components/PhotoCard.astro';
import PublicShell from '../components/PublicShell.astro';
import Layout from '../layouts/Layout.astro';
import {
	displayYear,
	getHomeCoverPhoto,
	getPublicCategories,
	getRecentPublicPhotos,
	previewUrl,
	photoAlt,
	photoLabel,
	type PublicCategory,
} from '../lib/public-gallery';

const photos = await getRecentPublicPhotos(4);
const homeCoverPhoto = await getHomeCoverPhoto();
const primaryPhoto = homeCoverPhoto ?? photos[0] ?? null;
const primaryPhotoYear = primaryPhoto ? displayYear(primaryPhoto.year) : '';
const primaryCategory = primaryPhoto?.expand?.category;
const recentPhotos = photos.filter((photo) => photo.id !== primaryPhoto?.id).slice(0, 3);

let categories: PublicCategory[] = [];
try {
	categories = await getPublicCategories();
} catch {
	categories = [];
}
---

<Layout
	title={settings.site_name}
	description={settings.site_description}
>
	<PublicShell items={[{ href: '/', label: 'Inicio', active: true }, { href: '/gallery', label: 'Galería' }]}>
		<main>
			<section class="hero" aria-labelledby="home-title">
				<div class="intro">
					<div class="kicker-row">
						<span class="kicker-stamp">SERIE DOCUMENTAL</span>
						<p class="kicker">Archivo &amp; Colección Fotográfica</p>
					</div>

					<h1 id="home-title">{settings.site_name}</h1>
					{settings.site_description && <p class="site-description">{settings.site_description}</p>}

					<div class="hero-actions">
						<a class="primary-link" href="/gallery">
							<span>Explorar catálogo</span>
							<span class="link-arrow" aria-hidden="true">→</span>
						</a>
						<a class="secondary-link" href="/search">
							<span>Buscar en el archivo</span>
						</a>
					</div>

					{categories.length > 0 && (
						<div class="hero-rolls" aria-label="Acceso directo a categorías">
							<span class="rolls-label">Rollos activos en archivo:</span>
							<div class="rolls-list">
								{categories.map((cat, idx) => (
									<a href={`/gallery/${cat.slug}`} class="roll-chip">
										<span class="roll-num">{String(idx + 1).padStart(2, '0')}</span>
										<span class="roll-name">{cat.name}</span>
										<small>{cat.photoCount}</small>
									</a>
								))}
							</div>
						</div>
					)}
				</div>

				{primaryPhoto ? (
					<div class="primary-photo-wrap">
						<a class="primary-photo" href={`/photo/${primaryPhoto.id}`} aria-label={photoLabel(primaryPhoto)}>
							<div class="contact-frame-top" aria-hidden="true">
								<span>▲ PORTADA EDITORIAL // {primaryCategory?.name || 'ARCHIVO'}</span>
								<span>REF #{primaryPhoto.id.slice(0, 6).toUpperCase()}</span>
							</div>

							<div class="primary-photo-frame">
								<img
									src={previewUrl(primaryPhoto.image)}
									alt={photoAlt(primaryPhoto)}
									fetchpriority="high"
									style={`view-transition-name: photo-${primaryPhoto.id};`}
								/>
							</div>

							<div class="primary-photo-caption">
								<div class="caption-text">
									<span class="cover-eyebrow">Pieza de portada seleccionada</span>
									<strong>{photoLabel(primaryPhoto)}</strong>
								</div>
								{primaryPhotoYear && <span class="photo-year-badge">{primaryPhotoYear}</span>}
							</div>
						</a>
					</div>
				) : (
					<div class="hero-placeholder" aria-label="Archivo en catalogación">
						<div class="placeholder-frame">
							<span class="placeholder-stamp">ARCHIVO EN PREPARACIÓN</span>
							<p class="placeholder-text">Acervo en catalogación digital</p>
							<small>Próximamente se exhibirán las primeras fotografías preservadas.</small>
						</div>
					</div>
				)}
			</section>

			{recentPhotos.length > 0 && (
				<section class="recent" aria-labelledby="recent-title">
					<div class="section-heading">
						<div>
							<p class="recent-kicker">Hoja de contacto // Incorporaciones</p>
							<h2 id="recent-title">Adiciones recientes</h2>
						</div>
						<a class="view-all-link" href="/gallery">
							<span>Ver galería completa</span>
							<span aria-hidden="true">→</span>
						</a>
					</div>
					<div class="recent-grid stagger-grid">
						{recentPhotos.map((photo, index) => (
							<PhotoCard photo={photo} showCategory frameIndex={index + 1} />
						))}
					</div>
				</section>
			)}
		</main>
	</PublicShell>
</Layout>

<style>
	main {
		width: 100%;
		max-width: 1480px;
		margin: 0 auto;
	}

	.hero {
		display: grid;
		grid-template-columns: minmax(300px, 0.9fr) minmax(320px, 1.1fr);
		align-items: center;
		gap: clamp(36px, 6vw, 84px);
		min-height: calc(100vh - 96px);
		padding: clamp(36px, 5vw, 76px) clamp(20px, 4vw, 48px);
	}

	.intro {
		max-width: 600px;
	}

	.kicker-row {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 10px;
		margin-bottom: 18px;
	}

	.kicker-stamp {
		padding: 3px 8px;
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-xs);
		background: var(--accent-subtle);
		color: var(--accent);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.14em;
	}

	.kicker {
		margin: 0;
		color: var(--text-secondary);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 500;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font-family: var(--font-serif);
		font-size: clamp(2.8rem, 6vw, 5.4rem);
		font-weight: 500;
		line-height: 0.96;
		letter-spacing: -0.02em;
		color: var(--text);
		overflow-wrap: anywhere;
	}

	.site-description {
		max-width: 36rem;
		margin: 24px 0 0;
		color: var(--text-secondary);
		font-size: clamp(1rem, 1.4vw, 1.14rem);
		line-height: 1.7;
		white-space: pre-line;
		overflow-wrap: anywhere;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 12px;
		margin-top: 32px;
	}

	.primary-link {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		border: 1px solid var(--accent);
		border-radius: var(--radius-sm);
		padding: 12px 22px;
		background: var(--accent);
		color: #14110d;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		transition:
			background-color 160ms ease,
			border-color 160ms ease,
			transform 160ms ease;
	}

	.primary-link:hover {
		background: var(--accent-strong);
		border-color: var(--accent-strong);
		transform: translateY(-1px);
	}

	.secondary-link {
		display: inline-flex;
		align-items: center;
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		padding: 12px 18px;
		background: var(--surface-card);
		color: var(--text);
		font-family: var(--font-mono);
		font-size: 0.78rem;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		transition: border-color 160ms ease, background-color 160ms ease;
	}

	.secondary-link:hover {
		border-color: var(--accent);
		background: var(--surface-hover);
	}

	.link-arrow {
		font-size: 1rem;
		transition: transform 160ms ease;
	}

	.primary-link:hover .link-arrow {
		transform: translateX(3px);
	}

	/* Quick Category Rolls Strip */
	.hero-rolls {
		margin-top: 36px;
		padding-top: 20px;
		border-top: 1px dashed var(--border);
		display: grid;
		gap: 10px;
	}

	.rolls-label {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--text-muted);
	}

	.rolls-list {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.roll-chip {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		padding: 6px 11px;
		border: 1px solid var(--border);
		border-radius: var(--radius-xs);
		background: var(--surface-card);
		font-size: 0.82rem;
		transition:
			border-color 160ms ease,
			background-color 160ms ease,
			transform 160ms ease;
	}

	.roll-chip:hover {
		border-color: var(--accent);
		background: var(--surface-hover);
		transform: translateY(-1px);
	}

	.roll-num {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		color: var(--film-stamp);
	}

	.roll-name {
		font-weight: 500;
		color: var(--text);
	}

	.roll-chip small {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		color: var(--text-muted);
	}

	/* Hero Contact-Sheet Mount */
	.primary-photo-wrap {
		width: 100%;
	}

	.primary-photo {
		display: flex;
		flex-direction: column;
		gap: 12px;
		padding: 16px;
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		background: var(--surface-card);
		box-shadow: var(--shadow-md);
		transition:
			border-color 220ms ease,
			box-shadow 220ms ease,
			transform 220ms cubic-bezier(0.16, 1, 0.3, 1);
	}

	.primary-photo:hover {
		border-color: var(--accent);
		box-shadow: var(--shadow-lighttable);
	}

	@media (prefers-reduced-motion: no-preference) {
		.primary-photo:hover {
			transform: translateY(-3px);
		}
	}

	.contact-frame-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		padding: 0 4px;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--film-stamp);
	}

	.primary-photo-frame {
		overflow: hidden;
		border-radius: var(--radius-xs);
		border: 1px solid var(--border-subtle);
		background: #080706;
	}

	.primary-photo img {
		display: block;
		width: 100%;
		max-height: 66vh;
		object-fit: contain;
		transition: transform 420ms cubic-bezier(0.16, 1, 0.3, 1);
	}

	@media (prefers-reduced-motion: no-preference) {
		.primary-photo:hover img {
			transform: scale(1.015);
		}
	}

	.primary-photo-caption {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 16px;
		padding: 4px 4px 0;
	}

	.caption-text {
		display: flex;
		flex-direction: column;
		gap: 3px;
		min-width: 0;
	}

	.cover-eyebrow {
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.caption-text strong {
		color: var(--text);
		font-family: var(--font-serif);
		font-size: 1.2rem;
		font-weight: 500;
		line-height: 1.3;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.photo-year-badge {
		flex-shrink: 0;
		padding: 4px 10px;
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-xs);
		background: var(--accent-subtle);
		color: var(--accent);
		font-family: var(--font-mono);
		font-size: 0.78rem;
		letter-spacing: 0.06em;
	}

	.hero-placeholder {
		width: 100%;
		min-height: 380px;
		display: grid;
		place-items: center;
		border: 1px dashed var(--border);
		border-radius: var(--radius-md);
		background: var(--surface-card);
		padding: 32px;
	}

	.placeholder-frame {
		text-align: center;
		display: grid;
		gap: 8px;
		max-width: 340px;
	}

	.placeholder-stamp {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.14em;
		color: var(--film-stamp);
	}

	.placeholder-text {
		margin: 0;
		color: var(--text);
		font-family: var(--font-serif);
		font-size: 1.25rem;
		font-weight: 500;
	}

	.placeholder-frame small {
		color: var(--text-secondary);
		font-size: 0.85rem;
		line-height: 1.5;
	}

	.recent {
		padding: 12px clamp(20px, 4vw, 48px) 64px;
	}

	.section-heading {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 20px;
		margin-bottom: 28px;
		border-bottom: 1px solid var(--border);
		padding-bottom: 16px;
	}

	.recent-kicker {
		margin: 0 0 6px;
		color: var(--film-stamp);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.section-heading h2 {
		margin: 0;
		font-family: var(--font-serif);
		font-size: clamp(1.5rem, 2.6vw, 2.15rem);
		font-weight: 500;
		line-height: 1.15;
		color: var(--text);
	}

	.view-all-link {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		color: var(--accent);
		font-family: var(--font-mono);
		font-size: 0.78rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		transition: opacity 160ms ease;
	}

	.view-all-link:hover {
		opacity: 0.85;
	}

	.recent-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 24px;
	}

	@media (max-width: 900px) {
		.hero {
			grid-template-columns: 1fr;
			min-height: auto;
			padding-block: 36px;
		}

		.primary-photo img {
			max-height: 54vh;
		}

		.recent-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 600px) {
		.recent-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
