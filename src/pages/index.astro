---
import { getSiteSettings } from '../lib/site-settings';
const settings = await getSiteSettings(Astro.request);
import PhotoCard from '../components/PhotoCard.astro';
import PublicShell from '../components/PublicShell.astro';
import Layout from '../layouts/Layout.astro';
import { displayYear, getHomeCoverPhoto, getRecentPublicPhotos, previewUrl, photoAlt, photoLabel } from '../lib/public-gallery';

const photos = await getRecentPublicPhotos(4);
const homeCoverPhoto = await getHomeCoverPhoto();
const primaryPhoto = homeCoverPhoto ?? photos[0] ?? null;
const primaryPhotoYear = primaryPhoto ? displayYear(primaryPhoto.year) : '';
const recentPhotos = photos.filter((photo) => photo.id !== primaryPhoto?.id).slice(0, 3);
---

<Layout
	title={settings.site_name}
	description={settings.site_description}
>
	<PublicShell items={[{ href: '/', label: 'Inicio', active: true }, { href: '/gallery', label: 'Galería' }]}>
		<main>
			<section class="hero" aria-labelledby="home-title">
				<div class="intro">
					<p class="kicker">Archivo & Colección Fotográfica</p>
					<h1 id="home-title">{settings.site_name}</h1>
					{settings.site_description && <p class="site-description">{settings.site_description}</p>}
					<a class="primary-link" href="/gallery">
						<span>Explorar catálogo</span>
						<span class="link-arrow" aria-hidden="true">→</span>
					</a>
				</div>

				{primaryPhoto ? (
					<div class="primary-photo-wrap">
						<a class="primary-photo" href={`/photo/${primaryPhoto.id}`} aria-label={photoLabel(primaryPhoto)}>
							<div class="primary-photo-frame">
								<img src={previewUrl(primaryPhoto.image)} alt={photoAlt(primaryPhoto)} />
							</div>
							<div class="primary-photo-caption">
								<div class="caption-text">
									<span class="cover-eyebrow">Portada del archivo</span>
									<strong>{photoLabel(primaryPhoto)}</strong>
								</div>
								{primaryPhotoYear && <span class="photo-year-badge">{primaryPhotoYear}</span>}
							</div>
						</a>
					</div>
				) : (
					<div class="hero-placeholder" aria-label="Archivo en catalogación">
						<div class="placeholder-frame">
							<span class="placeholder-icon">🏛️</span>
							<p class="placeholder-text">Acervo en catalogación digital</p>
							<small>Próximamente se exhibirán las primeras fotografías preservadas.</small>
						</div>
					</div>
				)}
			</section>

			{recentPhotos.length > 0 && (
				<section class="recent" aria-labelledby="recent-title">
					<div class="section-heading">
						<div>
							<p class="recent-kicker">Catálogo</p>
							<h2 id="recent-title">Adiciones recientes</h2>
						</div>
						<a class="view-all-link" href="/gallery">
							<span>Ver galería completa</span>
							<span aria-hidden="true">→</span>
						</a>
					</div>
					<div class="recent-grid">
						{recentPhotos.map((photo) => <PhotoCard photo={photo} showCategory />)}
					</div>
				</section>
			)}
		</main>
	</PublicShell>
</Layout>

<style>
	main {
		width: 100%;
	}

	.hero {
		display: grid;
		grid-template-columns: minmax(300px, 0.85fr) minmax(320px, 1.15fr);
		align-items: center;
		gap: clamp(40px, 7vw, 96px);
		min-height: calc(100vh - 82px);
		padding: clamp(48px, 6vw, 92px) clamp(20px, 5vw, 72px);
	}

	.intro {
		max-width: 580px;
	}

	.kicker {
		margin: 0 0 16px;
		color: var(--text-secondary);
		font-size: 0.76rem;
		font-weight: 600;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font-family: var(--font-serif);
		font-size: clamp(2.8rem, 6.5vw, 5.8rem);
		font-weight: 500;
		line-height: 0.96;
		letter-spacing: -0.02em;
		color: var(--text);
	}

	.intro p:not(.kicker) {
		max-width: 36rem;
		margin: 26px 0 0;
		color: var(--text-secondary);
		font-size: clamp(1.02rem, 1.5vw, 1.16rem);
		line-height: 1.7;
	}

	.primary-link {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		margin-top: 34px;
		border: 1px solid var(--border);
		border-radius: 4px;
		padding: 12px 22px;
		background: var(--surface-card);
		color: var(--text);
		font-size: 0.86rem;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		transition:
			border-color 160ms ease,
			background-color 160ms ease,
			transform 160ms ease;
	}

	.primary-link:hover {
		border-color: var(--accent);
		background: var(--surface-subtle);
		transform: translateY(-1px);
	}

	.link-arrow {
		font-size: 1.1rem;
		transition: transform 160ms ease;
	}

	.primary-link:hover .link-arrow {
		transform: translateX(3px);
	}

	.primary-photo-wrap {
		width: 100%;
	}

	.primary-photo {
		display: flex;
		flex-direction: column;
		gap: 14px;
		padding: 14px;
		border: 1px solid var(--border-subtle);
		border-radius: 8px;
		background: var(--surface-card);
		box-shadow: 0 16px 40px rgba(0, 0, 0, 0.2);
		transition:
			border-color 200ms ease,
			box-shadow 200ms ease;
	}

	.primary-photo:hover {
		border-color: var(--accent);
		box-shadow: 0 20px 48px rgba(0, 0, 0, 0.28);
	}

	.primary-photo-frame {
		overflow: hidden;
		border-radius: 4px;
		background: var(--surface);
	}

	.primary-photo img {
		display: block;
		width: 100%;
		max-height: 68vh;
		object-fit: contain;
	}

	.primary-photo-caption {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 16px;
		padding: 4px 6px;
	}

	.caption-text {
		display: flex;
		flex-direction: column;
		gap: 4px;
		min-width: 0;
	}

	.cover-eyebrow {
		color: var(--text-secondary);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.caption-text strong {
		color: var(--text);
		font-family: var(--font-serif);
		font-size: 1.12rem;
		font-weight: 500;
		line-height: 1.3;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.photo-year-badge {
		flex-shrink: 0;
		padding: 3px 9px;
		border: 1px solid var(--border);
		border-radius: 4px;
		color: var(--text-secondary);
		font-family: var(--font-mono);
		font-size: 0.8rem;
		letter-spacing: 0.04em;
	}

	.hero-placeholder {
		width: 100%;
		min-height: 380px;
		display: grid;
		place-items: center;
		border: 1px dashed var(--border);
		border-radius: 8px;
		background: var(--surface-card);
		padding: 32px;
	}

	.placeholder-frame {
		text-align: center;
		display: grid;
		gap: 8px;
		max-width: 320px;
	}

	.placeholder-icon {
		font-size: 2.2rem;
		margin-bottom: 4px;
	}

	.placeholder-text {
		margin: 0;
		color: var(--text);
		font-family: var(--font-serif);
		font-size: 1.15rem;
		font-weight: 500;
	}

	.placeholder-frame small {
		color: var(--text-secondary);
		font-size: 0.85rem;
		line-height: 1.5;
	}

	.recent {
		padding: 0 clamp(20px, 5vw, 72px) 80px;
	}

	.section-heading {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 20px;
		margin-bottom: 28px;
		border-bottom: 1px solid var(--border-subtle);
		padding-bottom: 16px;
	}

	.recent-kicker {
		margin: 0 0 6px;
		color: var(--text-secondary);
		font-size: 0.74rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.section-heading h2 {
		margin: 0;
		font-family: var(--font-serif);
		font-size: clamp(1.4rem, 2.5vw, 2rem);
		font-weight: 500;
		line-height: 1.2;
		color: var(--text);
	}

	.view-all-link {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		color: var(--text-secondary);
		font-size: 0.84rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		transition: color 160ms ease;
	}

	.view-all-link:hover {
		color: var(--text);
	}

	.recent-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 24px;
	}

	@media (max-width: 900px) {
		.hero {
			grid-template-columns: 1fr;
			min-height: auto;
			padding-block: 40px;
		}

		.primary-photo img {
			max-height: 54vh;
		}

		.recent-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 600px) {
		.recent-grid {
			grid-template-columns: 1fr;
		}
	}
</style>

<style>h1 { overflow-wrap: anywhere; } .site-description { white-space: pre-line; overflow-wrap: anywhere; }</style>
