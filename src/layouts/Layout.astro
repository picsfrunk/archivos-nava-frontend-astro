---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'ARCHIVOS NAVA',
	description = 'Un archivo de recuerdos, fotografías y pequeñas historias que merecen ser recordadas.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width" />
	<meta name="description" content={description} />
	<link rel="icon" href="/favicon.svg" />
	<meta name="generator" content={Astro.generator} />
	<title>{title}</title>
</head>

<body>
<slot />
</body>
</html>

<style is:global>
	:root {
		font-family:
			-apple-system,
			BlinkMacSystemFont,
			"Segoe UI",
			sans-serif;

		color-scheme: dark;
		background: #0b0b0b;
		color: #f5f5f5;
	}

	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
		background: #0b0b0b;
	}

	body {
		min-height: 100vh;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	button,
	input,
	textarea,
	select {
		font: inherit;
	}

	button {
		border: 0;
	}

	img {
		display: block;
		max-width: 100%;
	}
</style>