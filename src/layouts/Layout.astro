---
import { getSiteSettings } from '../lib/site-settings';
const settings = await getSiteSettings(Astro.request);
const isPublic = !Astro.url.pathname.startsWith('/admin');

interface Props {
	title?: string;
	description?: string;
}

const {
	title = settings.site_name,
	description = settings.site_description,
} = Astro.props;
---

<!doctype html>
<html lang="es" data-default-theme={isPublic ? settings.default_theme : undefined} data-theme={isPublic && settings.default_theme === 'light' ? 'light' : 'dark'}>
<head>
	<meta charset="UTF-8" />
    {isPublic && <script is:inline>
        (() => {
            const root = document.documentElement;
            const media = matchMedia('(prefers-color-scheme: dark)');
            let override = null;
            try { override = localStorage.getItem('archive-theme'); } catch {}
            const valid = value => ['dark', 'light', 'system'].includes(value);
            if (!valid(override)) override = null;
            const choice = () => override || root.dataset.defaultTheme || 'dark';
            const apply = () => {
                root.dataset.theme = choice() === 'system' ? (media.matches ? 'dark' : 'light') : choice();
                const control = document.querySelector('#theme-choice');
                if (control) control.value = override || 'default';
            };
            apply();
            media.addEventListener('change', apply);
            document.addEventListener('DOMContentLoaded', apply, { once: true });
            document.addEventListener('change', event => {
                if (event.target.id !== 'theme-choice') return;
                override = valid(event.target.value) ? event.target.value : null;
                try {
                    if (override) localStorage.setItem('archive-theme', override);
                    else localStorage.removeItem('archive-theme');
                } catch {}
                apply();
            });
            window.addEventListener('storage', event => {
                if (event.key !== 'archive-theme' && event.key !== null) return;
                override = valid(event.newValue) ? event.newValue : null;
                apply();
            });
        })();
    </script>}

	<meta name="viewport" content="width=device-width" />
	<meta name="description" content={description} />
	<link rel="icon" href="/favicon.svg" />
	<meta name="generator" content={Astro.generator} />
	<title>{title}</title>
</head>

<body>
<slot />
</body>
</html>

<style is:global>
	:root {
		--font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
		--font-serif: "Newsreader", "Playfair Display", "Georgia", "Times New Roman", serif;
		--font-mono: ui-monospace, "SF Mono", "Menlo", monospace;

		font-family: var(--font-sans);

		--background: #0b0b0b;
		--background-secondary: #121212;
		--surface: #181818;
		--surface-card: #141414;
		--surface-subtle: #202020;
		--text: #f5f5f5;
		--text-secondary: #a4a4a4;
		--border: #444;
		--border-subtle: rgba(255, 255, 255, 0.1);
		--accent: #e6d5b8;
		--accent-subtle: rgba(230, 213, 184, 0.12);
		--header-background: rgb(11 11 11 / 94%);
		color-scheme: dark;
		background: var(--background);
		color: var(--text);
	}

	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
		background: var(--background);
		color: var(--text);
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}

	body {
		min-height: 100vh;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	button,
	input,
	textarea,
	select {
		font: inherit;
	}

	button {
		border: 0;
	}

	img {
		display: block;
		max-width: 100%;
	}

	/* Public editorial headings */
	h1, h2, h3 {
		font-family: var(--font-serif);
		font-weight: 500;
		letter-spacing: -0.015em;
	}

	/* Retain sans-serif for admin workspace headings */
	.admin-shell h1,
	.admin-shell h2,
	.admin-shell h3,
	.admin-login h1,
	.admin-login h2 {
		font-family: var(--font-sans);
		letter-spacing: normal;
	}
</style>
<style is:global>
    :root[data-theme='light'] {
        --background: #f7f6f2;
        --background-secondary: #edece6;
        --surface: #e8e7e1;
        --surface-card: #fdfdfc;
        --surface-subtle: #dfded7;
        --text: #1d1d1a;
        --text-secondary: #585850;
        --border: #8a8a80;
        --border-subtle: rgba(0, 0, 0, 0.1);
        --accent: #655132;
        --accent-subtle: rgba(101, 81, 50, 0.1);
        --header-background: rgb(247 246 242 / 94%);
        color-scheme: light;
    }
    :focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
    [hidden] { display: none !important; }
</style>
