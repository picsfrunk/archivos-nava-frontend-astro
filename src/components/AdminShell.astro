---
interface Props {
	title: string;
	eyebrow?: string;
	active?: 'photos' | 'new' | 'categories' | 'settings';
}

const { title, eyebrow = 'Panel administrativo', active = 'photos' } = Astro.props;
---

<main class="admin-shell">
	<header class="admin-header">
		<div>
			<a href="/" class="brand">ARCHIVOS NAVA</a>
			<p>{eyebrow}</p>
		</div>

		<nav class="admin-nav" aria-label="Navegación administrativa">
			<a href="/admin/photos" aria-current={active === 'photos' ? 'page' : undefined}>
				Fotografías
			</a>
			<a href="/admin/photos/new" aria-current={active === 'new' ? 'page' : undefined}>
				Nueva carga
			</a>
			<a href="/admin/categories" aria-current={active === 'categories' ? 'page' : undefined}>
				Categorías
			</a>
			<a href="/admin/advanced/settings" id="owner-settings-link" hidden aria-current={active === 'settings' ? 'page' : undefined}>Configuración del sitio</a>
			<button id="logout-button" type="button">Salir</button>
		</nav>
	</header>

	<section class="workspace" aria-labelledby="admin-page-title">
		<div class="section-heading">
			<p class="eyebrow">{eyebrow}</p>
			<h1 id="admin-page-title">{title}</h1>
		</div>

		<slot />
	</section>
</main>

<script>
	import { pb } from '../lib/pocketbase';

	async function showOwnerAccess() {
        if (!pb.authStore.isValid || pb.authStore.record?.collectionName !== 'admins') return;
        try {
            await pb.collection('admins').authRefresh();
            const link = document.querySelector('#owner-settings-link');
            if (link instanceof HTMLElement) link.hidden = pb.authStore.record?.role !== 'owner';
        } catch { /* Page session guards handle expired sessions. */ }
    }
    void showOwnerAccess();

    const logoutButton = document.querySelector('#logout-button');

	logoutButton?.addEventListener('click', () => {
		pb.authStore.clear();
		window.location.href = '/admin/login';
	});
</script>

<style is:global>
	.admin-shell {
		min-height: 100vh;
		padding: 28px;
		background: #10100f;
		color: #f5f5f5;
	}

	.admin-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
		max-width: 1180px;
		margin: 0 auto 48px;
	}

	.brand {
		display: inline-block;
		margin-bottom: 8px;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.18em;
	}

	.admin-header p,
	.eyebrow {
		margin: 0;
		color: rgba(245, 245, 245, 0.58);
		font-size: 0.78rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.admin-nav {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 10px;
	}

	.admin-nav a,
	.admin-nav button,
	.secondary-button,
	.danger-button {
		border: 1px solid rgba(255, 255, 255, 0.18);
		border-radius: 6px;
		padding: 10px 13px;
		color: #f5f5f5;
		background: transparent;
		cursor: pointer;
	}

	.admin-nav a[aria-current="page"] {
		color: #101010;
		background: #f5f5f5;
	}

	.workspace {
		max-width: 1180px;
		margin: 0 auto;
	}

	.section-heading {
		margin-bottom: 28px;
	}

	.admin-shell h1 {
		margin: 8px 0 0;
		font-size: clamp(2rem, 4vw, 4.2rem);
		font-weight: 500;
		line-height: 1;
	}

	.admin-shell button,
	.admin-shell input,
	.admin-shell textarea,
	.admin-shell select {
		font: inherit;
	}

	.admin-shell button {
		border: 0;
		border-radius: 6px;
		padding: 12px 16px;
		color: #101010;
		background: #f5f5f5;
		cursor: pointer;
	}

	.admin-shell button:disabled {
		cursor: wait;
		opacity: 0.68;
	}

	.admin-shell label {
		display: grid;
		gap: 8px;
		color: rgba(245, 245, 245, 0.72);
		font-size: 0.9rem;
	}

	.admin-shell input,
	.admin-shell textarea,
	.admin-shell select {
		width: 100%;
		border: 1px solid rgba(255, 255, 255, 0.14);
		border-radius: 6px;
		padding: 12px 14px;
		color: #f5f5f5;
		background: rgba(255, 255, 255, 0.06);
		outline: none;
	}

	.admin-shell textarea {
		resize: vertical;
	}

	.admin-shell input:focus,
	.admin-shell textarea:focus,
	.admin-shell select:focus {
		border-color: rgba(255, 255, 255, 0.52);
	}

	.secondary-button,
	.danger-button {
		background: transparent;
	}

	.danger-button {
		border-color: rgba(255, 180, 169, 0.46);
		color: #ffb4a9;
	}

	.message {
		min-height: 1.5em;
		margin: 18px 0 0;
		color: rgba(245, 245, 245, 0.72);
		font-size: 0.95rem;
		line-height: 1.5;
	}

	.message[data-type="error"] {
		color: #ffb4a9;
	}

	.message[data-type="success"] {
		color: #b8e7c9;
	}

	.status-pill {
		display: inline-flex;
		align-items: center;
		width: max-content;
		border: 1px solid rgba(255, 255, 255, 0.14);
		border-radius: 999px;
		padding: 4px 9px;
		color: rgba(245, 245, 245, 0.72);
		font-size: 0.74rem;
		line-height: 1;
	}

	.status-pill[data-status="published"] {
		border-color: rgba(184, 231, 201, 0.36);
		color: #b8e7c9;
	}

	.status-pill[data-status="draft"] {
		border-color: rgba(245, 245, 245, 0.2);
	}

	.status-pill[data-status="trash"] {
		border-color: rgba(255, 180, 169, 0.4);
		color: #ffb4a9;
	}

	@media (max-width: 820px) {
		.admin-shell {
			padding: 20px;
		}

		.admin-header {
			align-items: flex-start;
			margin-bottom: 36px;
		}
	}

	@media (max-width: 620px) {
		.admin-header,
		.admin-nav {
			align-items: stretch;
			flex-direction: column;
		}

		.admin-nav a,
		.admin-nav button {
			width: 100%;
			text-align: center;
		}
	}
</style>
