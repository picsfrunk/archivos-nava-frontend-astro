---
interface Props {
	title: string;
	eyebrow?: string;
	active?: 'photos' | 'new' | 'categories' | 'settings' | 'system' | 'backups';
}

const { title, eyebrow = 'Panel administrativo', active = 'photos' } = Astro.props;
const isAdvancedActive = ['settings', 'system', 'backups'].includes(active);
---

<main class="admin-shell">
	<header class="admin-header">
		<div class="admin-brand-block">
			<a href="/" class="brand" title="Volver al archivo público">
				<span class="brand-mark" aria-hidden="true">▣</span>
				<span>ARCHIVOS NAVA</span>
			</a>
			<span class="brand-divider" aria-hidden="true">/</span>
			<p class="header-eyebrow">{eyebrow}</p>
		</div>

		<nav class="admin-nav" aria-label="Navegación administrativa">
			<a href="/admin/photos" class="nav-pill" aria-current={active === 'photos' ? 'page' : undefined}>
				Fotografías
			</a>
			<a href="/admin/photos/new" class="nav-pill" aria-current={active === 'new' ? 'page' : undefined}>
				+ Nueva carga
			</a>
			<a href="/admin/categories" class="nav-pill" aria-current={active === 'categories' ? 'page' : undefined}>
				Categorías
			</a>

			<details class="admin-cat-dropdown" id="admin-quick-categories">
				<summary class="nav-pill cat-dropdown-summary">
					<span>Rollo / Categoría</span>
					<svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true">
						<path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
					</svg>
				</summary>
				<div class="admin-cat-menu" role="region" aria-label="Filtrar fotografías por categoría">
					<div class="admin-cat-menu-head">
						<span>Ver fotos por categoría</span>
						<a href="/admin/categories">Gestionar →</a>
					</div>
					<ul id="admin-quick-cat-list" class="admin-cat-list">
						<li class="admin-cat-empty">Cargando categorías…</li>
					</ul>
				</div>
			</details>

			<a href="/admin/advanced/settings" id="owner-settings-link" class="nav-pill" hidden aria-current={isAdvancedActive ? 'page' : undefined}>
				Configuración
			</a>
			<a href="/" class="nav-pill view-site-pill" title="Abrir sitio público">
				Ver sitio ↗
			</a>
			<button id="logout-button" class="secondary-button logout-btn" type="button">Salir</button>
		</nav>
	</header>

	<section class="workspace" aria-labelledby="admin-page-title">
		<div class="section-heading">
			<p class="eyebrow">{eyebrow}</p>
			<h1 id="admin-page-title">{title}</h1>
		</div>

		<slot />
	</section>

	<dialog id="admin-confirm-dialog" class="admin-confirm-dialog" closedby="any" aria-labelledby="admin-confirm-title">
		<form method="dialog" class="confirm-dialog-form">
			<span class="confirm-eyebrow">CONFIRMACIÓN DE ARCHIVO</span>
			<h2 id="admin-confirm-title" class="confirm-title">¿Confirmar acción?</h2>
			<p id="admin-confirm-message" class="confirm-message"></p>
			<div class="confirm-actions">
				<button value="cancel" class="secondary-button" autofocus>Cancelar</button>
				<button id="admin-confirm-accept" value="confirm" class="danger-button">Confirmar</button>
			</div>
		</form>
	</dialog>
</main>

<script>
	import { pb } from '../lib/pocketbase';
	import { loadAdminCategories } from '../lib/admin';

	async function showOwnerAccess() {
		if (!pb.authStore.isValid || pb.authStore.record?.collectionName !== 'admins') return;
		try {
			await pb.collection('admins').authRefresh();
			const link = document.querySelector('#owner-settings-link');
			if (link instanceof HTMLElement) link.hidden = pb.authStore.record?.role !== 'owner';
		} catch {
			/* Page session guards handle expired sessions. */
		}
	}

	async function populateQuickCategories() {
		const list = document.querySelector('#admin-quick-cat-list');
		if (!(list instanceof HTMLElement) || !pb.authStore.isValid) return;
		try {
			const cats = await loadAdminCategories();
			const visible = cats.filter((c) => !c.isTechnical);
			list.innerHTML = '';

			const allLi = document.createElement('li');
			const allLink = document.createElement('a');
			allLink.href = '/admin/photos';
			allLink.innerHTML = '<span>Todas las fotografías</span><small>TODOS</small>';
			allLi.append(allLink);
			list.append(allLi);

			for (const cat of visible) {
				const li = document.createElement('li');
				const a = document.createElement('a');
				a.href = `/admin/photos?category=${encodeURIComponent(cat.id)}`;
				const nameSpan = document.createElement('span');
				nameSpan.textContent = cat.name || cat.slug || cat.id;
				const statusSmall = document.createElement('small');
				statusSmall.textContent = cat.active ? 'ACTIVA' : 'INACTIVA';
				a.append(nameSpan, statusSmall);
				li.append(a);
				list.append(li);
			}
		} catch {
			list.innerHTML = '<li class="admin-cat-empty">No disponible</li>';
		}
	}

	void showOwnerAccess();
	void populateQuickCategories();

	const dropdown = document.querySelector<HTMLDetailsElement>('#admin-quick-categories');
	document.addEventListener('click', (event) => {
		if (dropdown?.open && event.target instanceof Node && !dropdown.contains(event.target)) {
			dropdown.open = false;
		}
	});

	const logoutButton = document.querySelector('#logout-button');
	logoutButton?.addEventListener('click', () => {
		pb.authStore.clear();
		window.location.href = '/admin/login';
	});

	// Native HTML5 Confirmation Modal helper
	const confirmDialog = document.querySelector('#admin-confirm-dialog') as HTMLDialogElement | null;
	const confirmTitle = document.querySelector('#admin-confirm-title') as HTMLElement | null;
	const confirmMessage = document.querySelector('#admin-confirm-message') as HTMLElement | null;
	const confirmAccept = document.querySelector('#admin-confirm-accept') as HTMLButtonElement | null;

	if (confirmDialog && !('closedBy' in HTMLDialogElement.prototype)) {
		confirmDialog.addEventListener('click', (event) => {
			if (event.target !== confirmDialog) return;
			const rect = confirmDialog.getBoundingClientRect();
			const inside =
				rect.top <= event.clientY &&
				event.clientY <= rect.top + rect.height &&
				rect.left <= event.clientX &&
				event.clientX <= rect.left + rect.width;
			if (!inside) confirmDialog.close();
		});
	}

	(window as any).archiveConfirm = function archiveConfirm(options: {
		title?: string;
		message: string;
		confirmText?: string;
		danger?: boolean;
	}): Promise<boolean> {
		if (!confirmDialog || typeof confirmDialog.showModal !== 'function') {
			return Promise.resolve(window.confirm(options.message));
		}

		if (confirmTitle) confirmTitle.textContent = options.title || '¿Confirmar acción?';
		if (confirmMessage) confirmMessage.textContent = options.message;
		if (confirmAccept) {
			confirmAccept.textContent = options.confirmText || 'Confirmar';
			confirmAccept.className = options.danger === false ? 'primary-button' : 'danger-button';
		}

		confirmDialog.returnValue = '';
		confirmDialog.showModal();

		return new Promise((resolve) => {
			const onClose = () => {
				confirmDialog.removeEventListener('close', onClose);
				const accepted = confirmDialog.returnValue === 'confirm';
				confirmDialog.returnValue = '';
				resolve(accepted);
			};
			confirmDialog.addEventListener('close', onClose);
		});
	};
</script>

<style is:global>
	.admin-shell {
		min-height: 100vh;
		padding: 0 0 64px;
		background: var(--background);
		color: var(--text);
	}

	.admin-header {
		position: sticky;
		top: 0;
		z-index: 40;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
		padding: 16px clamp(20px, 4vw, 48px);
		margin-bottom: 36px;
		border-bottom: 1px solid var(--border);
		background: var(--header-background);
		backdrop-filter: blur(16px);
	}

	.admin-brand-block {
		display: flex;
		align-items: center;
		gap: 12px;
		flex-wrap: wrap;
	}

	.admin-header .brand {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		font-family: var(--font-sans);
		font-size: 0.84rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		color: var(--text);
	}

	.admin-header .brand-mark {
		display: inline-grid;
		place-items: center;
		width: 28px;
		height: 28px;
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-xs);
		background: var(--accent-subtle);
		color: var(--accent);
		font-size: 0.82rem;
	}

	.brand-divider {
		color: var(--border);
		font-family: var(--font-mono);
	}

	.header-eyebrow,
	.eyebrow {
		margin: 0;
		color: var(--film-stamp);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.admin-nav {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 8px;
	}

	.admin-nav .nav-pill {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		padding: 8px 13px;
		color: var(--text-secondary);
		background: var(--surface-card);
		font-size: 0.84rem;
		font-weight: 500;
		cursor: pointer;
		transition: border-color 150ms ease, color 150ms ease, background-color 150ms ease;
	}

	.admin-nav .nav-pill:hover {
		border-color: var(--accent);
		color: var(--text);
		background: var(--surface-hover);
	}

	.admin-nav .nav-pill[aria-current="page"] {
		border-color: var(--accent);
		color: #14110d;
		background: var(--accent);
		font-weight: 600;
	}

	.admin-nav .view-site-pill {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.04em;
	}

	/* Admin Quick Category Dropdown */
	.admin-cat-dropdown {
		position: relative;
	}

	.cat-dropdown-summary {
		list-style: none;
		user-select: none;
	}

	.cat-dropdown-summary::-webkit-details-marker {
		display: none;
	}

	.admin-cat-dropdown[open] .cat-dropdown-summary {
		border-color: var(--accent);
		color: var(--text);
	}

	.admin-cat-menu {
		position: absolute;
		top: calc(100% + 8px);
		right: 0;
		width: 280px;
		max-height: 360px;
		overflow-y: auto;
		padding: 10px;
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-md);
		background: var(--surface-card);
		box-shadow: var(--shadow-md);
		z-index: 60;
	}

	.admin-cat-menu-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 4px 8px 8px;
		margin-bottom: 6px;
		border-bottom: 1px dashed var(--border);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		color: var(--text-muted);
	}

	.admin-cat-menu-head a {
		color: var(--accent);
		font-weight: 600;
	}

	.admin-cat-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 3px;
	}

	.admin-cat-list li a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 8px;
		padding: 7px 10px;
		border-radius: var(--radius-xs);
		font-size: 0.84rem;
		color: var(--text);
		transition: background-color 140ms ease;
	}

	.admin-cat-list li a:hover {
		background: var(--surface-hover);
	}

	.admin-cat-list li small {
		font-family: var(--font-mono);
		font-size: 0.65rem;
		color: var(--film-stamp);
	}

	.admin-cat-empty {
		padding: 10px;
		color: var(--text-muted);
		font-size: 0.8rem;
		text-align: center;
	}

	.workspace {
		max-width: 1320px;
		margin: 0 auto;
		padding: 0 clamp(20px, 4vw, 48px);
	}

	.section-heading {
		margin-bottom: 28px;
		padding-bottom: 18px;
		border-bottom: 1px solid var(--border);
	}

	.admin-shell h1 {
		margin: 6px 0 0;
		font-family: var(--font-serif);
		font-size: clamp(2rem, 3.8vw, 3.4rem);
		font-weight: 500;
		line-height: 1.04;
		letter-spacing: -0.015em;
	}

	.admin-shell button,
	.admin-shell input,
	.admin-shell textarea,
	.admin-shell select {
		font: inherit;
	}

	/* Clean Button Hierarchy — Using :where() so component classes never lose specificity */
	:where(.admin-shell button),
	.admin-shell .primary-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		border: 1px solid var(--accent);
		border-radius: var(--radius-sm);
		padding: 10px 18px;
		color: #14110d;
		background: var(--accent);
		font-size: 0.86rem;
		font-weight: 600;
		cursor: pointer;
		transition:
			background-color 150ms ease,
			border-color 150ms ease,
			color 150ms ease,
			transform 150ms ease;
	}

	:where(.admin-shell button:hover:not(:disabled)),
	.admin-shell .primary-button:hover:not(:disabled) {
		background: var(--accent-strong);
		border-color: var(--accent-strong);
	}

	.admin-shell .secondary-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 6px;
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		padding: 9px 14px;
		color: var(--text);
		background: var(--surface-subtle);
		font-size: 0.84rem;
		font-weight: 500;
		cursor: pointer;
		transition:
			border-color 150ms ease,
			background-color 150ms ease,
			color 150ms ease;
	}

	.admin-shell .secondary-button:hover:not(:disabled) {
		border-color: var(--accent);
		background: var(--surface-hover);
		color: var(--text);
	}

	.admin-shell .icon-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 4px;
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		padding: 7px 10px;
		color: var(--text-secondary);
		background: var(--surface);
		font-family: var(--font-mono);
		font-size: 0.76rem;
		font-weight: 500;
		cursor: pointer;
		transition: border-color 150ms ease, color 150ms ease, background-color 150ms ease;
	}

	.admin-shell .icon-button:hover:not(:disabled) {
		border-color: var(--accent);
		color: var(--text);
		background: var(--surface-hover);
	}

	.admin-shell .danger-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 6px;
		border: 1px solid var(--danger-border);
		border-radius: var(--radius-sm);
		padding: 9px 14px;
		color: var(--danger);
		background: var(--danger-bg);
		font-size: 0.84rem;
		font-weight: 500;
		cursor: pointer;
		transition: border-color 150ms ease, background-color 150ms ease;
	}

	.admin-shell .danger-button:hover:not(:disabled) {
		border-color: var(--danger);
		background: rgba(255, 158, 145, 0.18);
	}

	.admin-shell button:disabled {
		cursor: not-allowed;
		opacity: 0.52;
	}

	.admin-shell label {
		display: grid;
		gap: 7px;
		color: var(--text-secondary);
		font-size: 0.86rem;
		font-weight: 500;
	}

	.admin-shell input:not([type="checkbox"]):not([type="radio"]):not([type="file"]),
	.admin-shell textarea,
	.admin-shell select {
		width: 100%;
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		padding: 11px 13px;
		color: var(--text);
		background: var(--surface);
		outline: none;
		transition: border-color 150ms ease, box-shadow 150ms ease;
	}

	.admin-shell textarea {
		resize: vertical;
	}

	.admin-shell input:focus,
	.admin-shell textarea:focus,
	.admin-shell select:focus {
		border-color: var(--accent);
		box-shadow: 0 0 0 2px var(--accent-subtle);
	}

	.message {
		min-height: 1.5em;
		margin: 18px 0 0;
		color: var(--text-secondary);
		font-size: 0.92rem;
		line-height: 1.5;
	}

	.message[data-type="error"] {
		color: var(--danger);
	}

	.message[data-type="success"] {
		color: var(--success);
	}

	.status-pill {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		width: max-content;
		border: 1px solid var(--border);
		border-radius: 999px;
		padding: 4px 10px;
		color: var(--text-secondary);
		background: var(--surface);
		font-family: var(--font-mono);
		font-size: 0.7rem;
		font-weight: 500;
		letter-spacing: 0.04em;
		line-height: 1;
	}

	.status-pill::before {
		content: "";
		width: 6px;
		height: 6px;
		border-radius: 999px;
		background: currentColor;
	}

	.status-pill[data-status="published"] {
		border-color: var(--success-border);
		background: var(--success-bg);
		color: var(--success);
	}

	.status-pill[data-status="draft"] {
		border-color: var(--border);
		color: var(--text-secondary);
	}

	.status-pill[data-status="trash"] {
		border-color: var(--danger-border);
		background: var(--danger-bg);
		color: var(--danger);
	}

	/* Confirmation Modal Dialog */
	.admin-confirm-dialog {
		width: min(92vw, 440px);
		border: 1px solid var(--border-strong);
		border-top: 3px solid var(--accent);
		border-radius: var(--radius-md);
		padding: 24px;
		background: var(--surface-card);
		color: var(--text);
		box-shadow: var(--shadow-md);
	}

	.confirm-dialog-form {
		display: grid;
		gap: 12px;
	}

	.confirm-eyebrow {
		font-family: var(--font-mono);
		font-size: 0.66rem;
		letter-spacing: 0.14em;
		color: var(--film-stamp);
	}

	.confirm-title {
		margin: 0;
		font-size: 1.25rem;
		font-weight: 600;
	}

	.confirm-message {
		margin: 0;
		color: var(--text-secondary);
		font-size: 0.92rem;
		line-height: 1.55;
	}

	.confirm-actions {
		display: flex;
		justify-content: flex-end;
		gap: 10px;
		margin-top: 10px;
	}

	@media (max-width: 860px) {
		.admin-header {
			align-items: flex-start;
			flex-direction: column;
			margin-bottom: 28px;
		}

		.admin-nav {
			justify-content: flex-start;
			width: 100%;
		}
	}
</style>
