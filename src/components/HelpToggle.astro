---
interface Props {
	class?: string;
	compact?: boolean;
}

const { class: className = '', compact = false } = Astro.props;
---

<button
	type="button"
	class:list={['help-toggle-btn', { 'is-compact': compact }, className]}
	data-help-toggle
	aria-pressed="true"
	title="Activar o desactivar carteles de ayuda y sugerencias"
>
	<span class="help-toggle-icon" aria-hidden="true">?</span>
	<span class="help-toggle-text">
		Ayuda: <span class="help-toggle-status">Activa</span>
	</span>
</button>

<style>
	.help-toggle-btn {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		height: 36px;
		padding: 0 12px;
		background: var(--surface-subtle, #231f1a);
		border: 1px solid var(--border-subtle, rgba(235, 214, 180, 0.13));
		border-radius: 9999px;
		color: var(--text-secondary, #b0a695);
		font-family: var(--font-mono, monospace);
		font-size: 11px;
		font-weight: 500;
		cursor: pointer;
		transition: background-color 0.18s ease, border-color 0.18s ease, color 0.18s ease, transform 0.12s ease;
		user-select: none;
		white-space: nowrap;
	}

	.help-toggle-btn:hover,
	.help-toggle-btn:focus-visible {
		background: var(--surface-hover, #27221c);
		border-color: var(--border-strong, rgba(223, 169, 96, 0.42));
		color: var(--text, #f3ede2);
		outline: none;
	}

	.help-toggle-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 16px;
		height: 16px;
		border-radius: 50%;
		background: var(--accent-subtle, rgba(223, 169, 96, 0.14));
		color: var(--accent, #dfa960);
		font-size: 10px;
		font-weight: 700;
		line-height: 1;
		border: 1px solid var(--border-strong, rgba(223, 169, 96, 0.42));
	}

	.help-toggle-status {
		color: var(--accent, #dfa960);
		font-weight: 600;
	}

	/* When help mode is disabled, style the toggle button so the user sees it is OFF */
	:global(html[data-help-mode="disabled"]) .help-toggle-btn {
		background: transparent;
		border-color: var(--border, #383127);
		color: var(--text-muted, #7e7567);
		opacity: 0.78;
	}

	:global(html[data-help-mode="disabled"]) .help-toggle-icon {
		background: transparent;
		border-color: var(--border, #383127);
		color: var(--text-muted, #7e7567);
	}

	:global(html[data-help-mode="disabled"]) .help-toggle-status {
		color: var(--text-muted, #7e7567);
	}

	.help-toggle-btn.is-compact {
		height: 28px;
		padding: 0 8px;
		font-size: 10px;
		gap: 4px;
	}

	.help-toggle-btn.is-compact .help-toggle-icon {
		width: 14px;
		height: 14px;
		font-size: 9px;
	}

	@media (max-width: 680px) {
		.help-toggle-text {
			font-size: 10px;
		}
	}
</style>
