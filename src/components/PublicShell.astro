---
import { getSiteSettings, logoPreviewUrl } from '../lib/site-settings';
const settings = await getSiteSettings(Astro.request);

type NavItem = {
	href: string;
	label: string;
	active?: boolean;
};

interface Props {
	items?: NavItem[];
}

const { items = [] } = Astro.props;
---

<header class="site-header">
	<a href="/" class="brand" aria-label={`${settings.site_name} — Inicio`}>
        {settings.logo_url && <img src={logoPreviewUrl(settings.logo_url)} alt={settings.site_name} width="240" height="80" />}
        <span>{settings.site_name}</span>
    </a>

	<nav aria-label="Navegación principal">
		{items.map((item) => (
			<a href={item.href} aria-current={item.active ? 'page' : undefined}>
				{item.label}
			</a>
		))}
        <label class="theme-control">Tema
            <select id="theme-choice" aria-label="Tema de la página">
                <option value="default">Predeterminado</option>
                <option value="dark">Oscuro</option>
                <option value="light">Claro</option>
                <option value="system">Según dispositivo</option>
            </select>
        </label>
    </nav>
</header>

<slot />

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		width: 100%;
		padding: 24px clamp(18px, 4vw, 48px);
		border-bottom: 1px solid var(--border);
		background: var(--header-background);
		backdrop-filter: blur(18px);
	}

	.brand {
		flex: 0 1 auto;
        min-width: 0;
        overflow-wrap: anywhere;
		font-size: 0.92rem;
		font-weight: 650;
		letter-spacing: 0.18em;
	}

	nav {
        align-items: center;
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 18px;
	}

	nav a {
		color: var(--text-secondary);
		font-size: 0.88rem;
		letter-spacing: 0.03em;
		transition: color 160ms ease;
	}

	nav a:hover,
	nav a[aria-current='page'] {
		color: var(--text);
	}

	@media (max-width: 560px) {
		.site-header {
			align-items: flex-start;
			flex-direction: column;
			gap: 12px;
			padding-block: 18px;
		}

		nav {
			justify-content: flex-start;
		}
	}
</style>

<style>
    .brand { display: flex; align-items: center; gap: 12px; }
    .brand img { width: auto; max-width: min(160px, 40vw); height: 48px; object-fit: contain; }
    .theme-control { display: flex; align-items: center; gap: 8px; font-size: .8rem; color: var(--text-secondary); }
    select { max-width: 150px; padding: 7px; color: var(--text); background: var(--surface); border: 1px solid var(--border); border-radius: 4px; }
</style>
