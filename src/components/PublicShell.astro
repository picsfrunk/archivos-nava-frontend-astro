---
import { getSiteSettings, logoPreviewUrl } from '../lib/site-settings';
import { getPublicCategories, type PublicCategory } from '../lib/public-gallery';

const settings = await getSiteSettings(Astro.request);

let categories: PublicCategory[] = [];
try {
	categories = await getPublicCategories();
} catch {
	categories = [];
}

type NavItem = {
	href: string;
	label: string;
	active?: boolean;
};

interface Props {
	items?: NavItem[];
	activeCategorySlug?: string;
	photoViewMode?: boolean;
}

const { items = [], activeCategorySlug, photoViewMode = false } = Astro.props;

const pathMatch = Astro.url.pathname.match(/^\/gallery\/([^/?#]+)/);
const resolvedCategorySlug = activeCategorySlug || (pathMatch ? decodeURIComponent(pathMatch[1]) : '');
const activeCategory = categories.find((cat) => cat.slug === resolvedCategorySlug) || null;
---

<header class="site-header">
	<div class="header-inner">
		<a href="/" class="brand" aria-label={`${settings.site_name} — Inicio`}>
			{settings.logo_url ? (
				<img src={logoPreviewUrl(settings.logo_url)} alt={settings.site_name} width="240" height="80" />
			) : (
				<span class="brand-mark" aria-hidden="true">▣</span>
			)}
			<span class="brand-text">
				<span class="brand-name">{settings.site_name}</span>
				<span class="brand-sub">ARCHIVO &amp; CATÁLOGO ANALÓGICO</span>
			</span>
		</a>

		<nav aria-label="Navegación principal">
			{items.map((item) => (
				<a
					class="nav-link"
					href={item.href}
					aria-current={item.active ? 'page' : undefined}
				>
					{item.label}
				</a>
			))}

			<details class="category-dropdown" id="global-category-dropdown">
				<summary class:list={['category-trigger', { 'has-active': Boolean(activeCategory) }]}>
					<span class="trigger-dot" aria-hidden="true"></span>
					<span class="trigger-label">
						{activeCategory ? `Categoría: ${activeCategory.name}` : 'Categorías'}
					</span>
					{categories.length > 0 && (
						<span class="trigger-count">{categories.length}</span>
					)}
					<svg class="trigger-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
						<path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
					</svg>
				</summary>

				<div class="dropdown-panel" role="region" aria-label="Selector rápido de categorías">
					<div class="dropdown-header">
						<span class="dropdown-kicker">ROLLOS &amp; COLECCIONES</span>
						<a href="/gallery" class="dropdown-all-link">Ver todas →</a>
					</div>

					{categories.length > 0 ? (
						<ul class="dropdown-list">
							{categories.map((cat, idx) => {
								const isCurrent = cat.slug === resolvedCategorySlug;
								const primaryHref = photoViewMode && cat.firstPhotoId
									? `/photo/${cat.firstPhotoId}`
									: `/gallery/${cat.slug}`;
								return (
									<li class:list={['dropdown-item', { 'is-current': isCurrent }]}>
										<a
											href={primaryHref}
											class="dropdown-item-main"
											aria-current={isCurrent ? 'true' : undefined}
										>
											<span class="frame-num">{String(idx + 1).padStart(2, '0')}A</span>
											<span class="cat-info">
												<span class="cat-name">{cat.name}</span>
												{photoViewMode && cat.firstPhotoId && (
													<span class="cat-mode-hint">
														{isCurrent ? 'Categoría actual' : 'Saltar a 1.ª foto'}
													</span>
												)}
											</span>
											<span class="cat-count">{cat.photoCount} {cat.photoCount === 1 ? 'foto' : 'fotos'}</span>
										</a>
										{photoViewMode && (
											<a
												href={`/gallery/${cat.slug}`}
												class="dropdown-grid-shortcut"
												title={`Ver grilla completa de ${cat.name}`}
												aria-label={`Ver grilla completa de ${cat.name}`}
											>
												Grilla
											</a>
										)}
									</li>
								);
							})}
						</ul>
					) : (
						<p class="dropdown-empty">No hay categorías públicas activas.</p>
					)}
				</div>
			</details>

			<a
				class="nav-link"
				href="/search"
				aria-current={Astro.url.pathname === '/search' ? 'page' : undefined}
			>
				Buscar
			</a>

			<label class="theme-control">
				<span class="theme-label">Luz</span>
				<select id="theme-choice" aria-label="Tema de la página">
					<option value="default">Auto (Archivo)</option>
					<option value="dark">Cuarto oscuro</option>
					<option value="light">Papel algodón</option>
					<option value="system">Sistema</option>
				</select>
			</label>
		</nav>
	</div>
</header>

<slot />

<footer class="site-footer">
	<div class="footer-inner">
		<div class="footer-brand">
			<span class="footer-stamp">ARCHIVO PRESERVADO // SERIE 70s–90s</span>
			<strong>{settings.site_name}</strong>
			{settings.site_description && <p>{settings.site_description}</p>}
		</div>

		{categories.length > 0 && (
			<nav class="footer-categories" aria-label="Categorías del archivo">
				<span class="footer-nav-title">Colecciones en catálogo</span>
				<div class="footer-cat-pills">
					{categories.map((cat) => (
						<a href={`/gallery/${cat.slug}`} class:list={[{ active: cat.slug === resolvedCategorySlug }]}>
							<span>{cat.name}</span>
							<small>{cat.photoCount}</small>
						</a>
					))}
				</div>
			</nav>
		)}
	</div>
</footer>

<script>
	const dropdowns = document.querySelectorAll<HTMLDetailsElement>('details.category-dropdown');

	document.addEventListener('click', (event) => {
		const target = event.target;
		if (!(target instanceof Node)) return;
		for (const dropdown of dropdowns) {
			if (dropdown.open && !dropdown.contains(target)) {
				dropdown.open = false;
			}
		}
	});

	document.addEventListener('keydown', (event) => {
		if (event.key !== 'Escape') return;
		for (const dropdown of dropdowns) {
			if (dropdown.open) {
				dropdown.open = false;
				const summary = dropdown.querySelector('summary');
				if (summary instanceof HTMLElement) summary.focus();
			}
		}
	});
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 40;
		width: 100%;
		border-bottom: 1px solid var(--border);
		background: var(--header-background);
		backdrop-filter: blur(16px);
	}

	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
		max-width: 1480px;
		margin: 0 auto;
		padding: 16px clamp(18px, 4vw, 48px);
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 12px;
		flex: 0 1 auto;
		min-width: 0;
		transition: opacity 160ms ease;
	}

	.brand:hover {
		opacity: 0.9;
	}

	.brand img {
		width: auto;
		max-width: min(150px, 36vw);
		height: 42px;
		object-fit: contain;
	}

	.brand-mark {
		display: inline-grid;
		place-items: center;
		width: 34px;
		height: 34px;
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-xs);
		background: var(--accent-subtle);
		color: var(--accent);
		font-size: 0.95rem;
		flex-shrink: 0;
	}

	.brand-text {
		display: flex;
		flex-direction: column;
		gap: 2px;
		min-width: 0;
	}

	.brand-name {
		font-family: var(--font-sans);
		font-size: 0.88rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		overflow-wrap: anywhere;
	}

	.brand-sub {
		font-family: var(--font-mono);
		font-size: 0.62rem;
		letter-spacing: 0.12em;
		color: var(--text-muted);
	}

	nav {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 10px 16px;
	}

	.nav-link {
		position: relative;
		padding: 6px 4px;
		color: var(--text-secondary);
		font-size: 0.86rem;
		font-weight: 500;
		letter-spacing: 0.03em;
		transition: color 160ms ease;
	}

	.nav-link:hover,
	.nav-link[aria-current='page'] {
		color: var(--text);
	}

	.nav-link[aria-current='page']::after {
		content: "";
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 2px;
		background: var(--accent);
		border-radius: 2px;
	}

	/* Category Dropdown Menu */
	.category-dropdown {
		position: relative;
	}

	.category-trigger {
		list-style: none;
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 7px 12px;
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		background: var(--surface-card);
		color: var(--text);
		font-size: 0.84rem;
		font-weight: 500;
		cursor: pointer;
		user-select: none;
		transition:
			border-color 160ms ease,
			background-color 160ms ease,
			box-shadow 160ms ease;
	}

	.category-trigger::-webkit-details-marker {
		display: none;
	}

	.category-trigger:hover,
	.category-dropdown[open] .category-trigger {
		border-color: var(--accent);
		background: var(--surface-hover);
	}

	.category-trigger.has-active {
		border-color: var(--border-strong);
		background: var(--accent-subtle);
	}

	.trigger-dot {
		width: 7px;
		height: 7px;
		border-radius: 999px;
		background: var(--text-muted);
		transition: background-color 160ms ease, box-shadow 160ms ease;
	}

	.category-trigger.has-active .trigger-dot,
	.category-dropdown[open] .trigger-dot {
		background: var(--accent);
		box-shadow: 0 0 8px var(--accent);
	}

	.trigger-label {
		max-width: 190px;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.trigger-count {
		padding: 1px 6px;
		border-radius: 999px;
		background: var(--surface-subtle);
		color: var(--text-secondary);
		font-family: var(--font-mono);
		font-size: 0.7rem;
	}

	.trigger-chevron {
		color: var(--text-secondary);
		transition: transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
	}

	.category-dropdown[open] .trigger-chevron {
		transform: rotate(180deg);
		color: var(--accent);
	}

	.dropdown-panel {
		position: absolute;
		top: calc(100% + 8px);
		right: 0;
		width: min(360px, calc(100vw - 32px));
		max-height: min(72vh, 480px);
		overflow-y: auto;
		padding: 12px;
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-md);
		background: var(--surface-card);
		box-shadow: var(--shadow-md);
		z-index: 60;
	}

	@media (prefers-reduced-motion: no-preference) {
		.category-dropdown[open] .dropdown-panel {
			animation: dropdown-enter 180ms cubic-bezier(0.16, 1, 0.3, 1);
		}
	}

	@keyframes dropdown-enter {
		from {
			opacity: 0;
			transform: translateY(-6px) scale(0.98);
		}
		to {
			opacity: 1;
			transform: translateY(0) scale(1);
		}
	}

	.dropdown-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		padding: 4px 8px 10px;
		margin-bottom: 6px;
		border-bottom: 1px dashed var(--border);
	}

	.dropdown-kicker {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		color: var(--text-muted);
	}

	.dropdown-all-link {
		font-size: 0.76rem;
		font-weight: 600;
		color: var(--accent);
		transition: opacity 150ms ease;
	}

	.dropdown-all-link:hover {
		opacity: 0.85;
		text-decoration: underline;
	}

	.dropdown-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 4px;
	}

	.dropdown-item {
		display: flex;
		align-items: center;
		gap: 6px;
		border-radius: var(--radius-sm);
		transition: background-color 140ms ease;
	}

	.dropdown-item:hover {
		background: var(--surface-hover);
	}

	.dropdown-item.is-current {
		background: var(--accent-subtle);
		outline: 1px solid var(--border-strong);
	}

	.dropdown-item-main {
		flex: 1 1 auto;
		min-width: 0;
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 8px 10px;
	}

	.frame-num {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: var(--film-stamp);
		opacity: 0.85;
		flex-shrink: 0;
	}

	.cat-info {
		display: flex;
		flex-direction: column;
		min-width: 0;
		flex: 1 1 auto;
	}

	.cat-name {
		font-size: 0.88rem;
		font-weight: 500;
		color: var(--text);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.cat-mode-hint {
		font-size: 0.68rem;
		color: var(--accent);
	}

	.cat-count {
		flex-shrink: 0;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--text-secondary);
		padding: 2px 6px;
		border-radius: var(--radius-xs);
		background: var(--surface);
	}

	.dropdown-grid-shortcut {
		flex-shrink: 0;
		margin-right: 8px;
		padding: 4px 8px;
		border: 1px solid var(--border);
		border-radius: var(--radius-xs);
		background: var(--surface);
		color: var(--text-secondary);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		transition: border-color 140ms ease, color 140ms ease;
	}

	.dropdown-grid-shortcut:hover {
		border-color: var(--accent);
		color: var(--text);
	}

	.dropdown-empty {
		margin: 0;
		padding: 14px 8px;
		color: var(--text-secondary);
		font-size: 0.84rem;
		text-align: center;
	}

	.theme-control {
		display: flex;
		align-items: center;
		gap: 6px;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--text-secondary);
	}

	select {
		max-width: 148px;
		padding: 6px 10px;
		color: var(--text);
		background: var(--surface-card);
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		font-family: var(--font-sans);
		font-size: 0.8rem;
		cursor: pointer;
		transition: border-color 150ms ease;
	}

	select:hover {
		border-color: var(--accent);
	}

	/* Footer */
	.site-footer {
		margin-top: 64px;
		border-top: 1px solid var(--border);
		background: var(--background-secondary);
		padding: 40px clamp(18px, 4vw, 48px);
	}

	.footer-inner {
		max-width: 1480px;
		margin: 0 auto;
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 32px;
	}

	.footer-brand {
		display: flex;
		flex-direction: column;
		gap: 6px;
		max-width: 420px;
	}

	.footer-stamp {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.14em;
		color: var(--film-stamp);
	}

	.footer-brand strong {
		font-family: var(--font-serif);
		font-size: 1.2rem;
		font-weight: 500;
	}

	.footer-brand p {
		margin: 4px 0 0;
		font-size: 0.85rem;
		color: var(--text-secondary);
		line-height: 1.5;
	}

	.footer-categories {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.footer-nav-title {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--text-muted);
	}

	.footer-cat-pills {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.footer-cat-pills a {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 5px 10px;
		border: 1px solid var(--border);
		border-radius: var(--radius-xs);
		background: var(--surface-card);
		font-size: 0.8rem;
		color: var(--text-secondary);
		transition: border-color 150ms ease, color 150ms ease;
	}

	.footer-cat-pills a:hover,
	.footer-cat-pills a.active {
		border-color: var(--accent);
		color: var(--text);
	}

	.footer-cat-pills small {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: var(--film-stamp);
	}

	@media (max-width: 680px) {
		.header-inner {
			align-items: stretch;
			flex-direction: column;
			gap: 10px;
			padding: 12px 14px;
		}

		.brand-sub {
			font-size: 0.58rem;
		}

		nav {
			justify-content: flex-start;
			gap: 8px 12px;
		}

		.trigger-label {
			max-width: 145px;
		}

		.dropdown-panel {
			position: fixed;
			top: auto;
			left: 14px;
			right: 14px;
			width: auto;
			max-width: calc(100dvw - 28px);
			margin-top: 8px;
		}

		.theme-control {
			margin-inline-start: auto;
		}

		.theme-label {
			display: none;
		}

		select {
			max-width: 128px;
			padding: 5px 8px;
			font-size: 0.76rem;
		}
	}
</style>
