---
import {
	displayYear,
	photoAlt,
	photoLabel,
	thumbnailUrl,
	type PhotoRecord,
} from '../lib/public-gallery';

interface Props {
	photo: PhotoRecord;
	showCategory?: boolean;
}

const { photo, showCategory = false } = Astro.props;
const category = photo.expand?.category;
const label = photoLabel(photo);
const meta = [
	showCategory ? category?.name : '',
	displayYear(photo.year),
].filter(Boolean);
---

<a class="photo-card" href={`/photo/${photo.id}`} aria-label={label}>
	<div class="photo-card-media">
		<img
			src={thumbnailUrl(photo.image)}
			alt={photoAlt(photo)}
			loading="lazy"
			width="720"
			height="540"
		/>
	</div>
	<span class="photo-card-body">
		<span class="photo-title">{label}</span>
		{meta.length > 0 && <span class="photo-meta">{meta.join(' · ')}</span>}
	</span>
</a>

<style>
	.photo-card {
		display: flex;
		flex-direction: column;
		min-width: 0;
		padding: 10px;
		border: 1px solid var(--border-subtle);
		border-radius: 6px;
		background: var(--surface-card);
		transition:
			border-color 200ms ease,
			box-shadow 200ms ease,
			transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
	}

	.photo-card:hover {
		border-color: var(--accent);
		transform: translateY(-2px);
		box-shadow: 0 10px 24px rgba(0, 0, 0, 0.16);
	}

	.photo-card-media {
		overflow: hidden;
		border-radius: 4px;
		background: var(--surface);
	}

	.photo-card img {
		display: block;
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		transition: transform 300ms ease;
	}

	.photo-card:hover img {
		transform: scale(1.015);
	}

	.photo-card-body {
		display: flex;
		flex-direction: column;
		gap: 6px;
		padding: 10px 4px 4px;
		min-width: 0;
	}

	.photo-title {
		font-family: var(--font-serif);
		font-size: 1.05rem;
		font-weight: 500;
		color: var(--text);
		line-height: 1.35;
		overflow: hidden;
		text-overflow: ellipsis;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
	}

	.photo-meta {
		font-family: var(--font-sans);
		color: var(--text-secondary);
		font-size: 0.76rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
</style>
